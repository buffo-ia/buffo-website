---
import { SITE } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BarraDiagnostico from '../components/BarraDiagnostico.astro';
import BotonWhatsApp from '../components/BotonWhatsApp.astro';
import Analytics from '@vercel/analytics/astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  /** Ruta relativa para canonical/OG, ej "/servicios". Default: "/" */
  path?: string;
  /** JSON-LD adicional específico de la página (objeto o arreglo de objetos) */
  schema?: object | object[];
  /** true cuando el hero es un bloque oscuro de borde a borde. El header
      necesita saberlo: arriba del todo no puede usar los colores del tema,
      o en claro quedaría texto oscuro sobre azul noche. */
  heroAncla?: boolean;
}

const {
  title = SITE.defaultTitle,
  description = SITE.defaultDescription,
  path = '/',
  schema,
  heroAncla = false,
} = Astro.props;

const canonical = new URL(path, SITE.url).href;
// El sufijo ?v= no lo lee el servidor: es para WhatsApp y LinkedIn, que
// guardan la vista previa por URL y la sirven cacheada por semanas. Cambiar el
// número es lo que los obliga a bajar la imagen de nuevo. SUBIRLO CADA VEZ que
// se regenere og-image.png, o el cambio no se ve en los teléfonos.
const OG_VERSION = 4;
const ogImage = new URL(`/og-image.png?v=${OG_VERSION}`, SITE.url).href;

// Las dimensiones de la tarjeta se DECLARAN, no se dejan a que el scraper las
// averigüe. WhatsApp descarta la vista previa grande y cae a la miniatura
// cuadrada si no encuentra og:image:width/height antes de su timeout, que es
// muy corto: la imagen estaba bien (1200×630, 1.91:1) pero se compartía chica.
// Si se regenera con otro tamaño, se cambian estos dos números junto con
// scripts/generar-og.mjs.
const OG_IMAGE = { ancho: 1200, alto: 630, tipo: 'image/png' };
const ogImageAlt = `${SITE.name} — ${SITE.defaultDescription}`;

// Schema base presente en todas las páginas: Organization + WebSite
const baseSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#organization`,
      name: SITE.name,
      url: SITE.url,
      logo: `${SITE.url}/logo.png`,
      description: SITE.defaultDescription,
      email: SITE.email,
      telephone: `+${SITE.whatsapp}`,
      // Antes acá solo iba el país y la ciudad. Con la calle y la comuna, Google
      // puede ubicar la empresa: es la señal de SEO local que faltaba.
      address: {
        '@type': 'PostalAddress',
        streetAddress: SITE.direccion.calle,
        addressLocality: SITE.direccion.comuna,
        addressRegion: SITE.direccion.region,
        addressCountry: SITE.direccion.pais,
      },
      areaServed: { '@type': 'Country', name: 'Chile' },
      // sameAs es cómo Google amarra el sitio con los perfiles de la empresa:
      // sin esto son tres cuentas sueltas que nadie relaciona entre sí.
      sameAs: [SITE.linkedin, SITE.instagram],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.name,
      publisher: { '@id': `${SITE.url}/#organization` },
      inLanguage: 'es-CL',
    },
  ],
};

const extraSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!doctype html>
<html lang="es-CL" data-theme="light" style="color-scheme: light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Tema: se aplica ANTES del primer pintado. Si esto se moviera al final
         del body, el visitante vería un parpadeo antes del tema correcto.
         El claro es el predeterminado (decisión de Simón, 2026-08-15): solo se
         cambia si el visitante ya eligió el oscuro con el botón del header. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('buffo-theme') === 'dark' ? 'dark' : 'light';
          document.documentElement.dataset.theme = t;
          document.documentElement.classList.toggle('dark', t === 'dark');
          document.documentElement.style.colorScheme = t;
        } catch (e) {}
      })();
    </script>
    <!-- El SVG primero: los navegadores modernos lo prefieren y se ve nítido
         en cualquier densidad. El PNG queda de respaldo para los que no. -->
    <!-- El favicon vectorial se retiró con el logo nuevo: el diseñador entregó
         PNG y .ai, no SVG, y calcar el colibrí a mano habría sido dibujar una
         marca distinta. El PNG a 192 px cubre todos los navegadores vigentes;
         si más adelante llega el SVG oficial, vuelve acá arriba. -->
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- SEO Primary -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content={OG_IMAGE.tipo} />
    <meta property="og:image:width" content={String(OG_IMAGE.ancho)} />
    <meta property="og:image:height" content={String(OG_IMAGE.alto)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.name} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Fuentes -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
      rel="stylesheet"
    />

    <!-- Schema base -->
    <script type="application/ld+json" set:html={JSON.stringify(baseSchema)} />
    {extraSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body class="bg-background text-on-surface selection:bg-primary/30" data-hero={heroAncla ? 'ancla' : undefined}>
    <div class="h-px w-full accent-line"></div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <BarraDiagnostico />
    <BotonWhatsApp />

    <script>
      // Scroll reveal con IntersectionObserver
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) e.target.classList.add('visible');
          });
        },
        { threshold: 0.1 }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>

    <Analytics />
  </body>
</html>
