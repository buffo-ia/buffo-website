---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Servicio from '../../components/v2/Servicio.astro';
import VideoDemo from '../../components/v2/VideoDemo.astro';
import { SITE } from '../../config/site';
import { SERVICES_CONTENT } from '../../data/services';

const service = SERVICES_CONTENT.find((s) => s.slug === 'dashboards-ejecutivos')!;
const path = '/servicios/dashboards-ejecutivos';

const steps = [
  {
    icon: 'target',
    title: 'Definimos los indicadores a partir de las decisiones',
    body: 'Partimos de las decisiones que toma su gerencia y de los objetivos del negocio. Primero la vista ejecutiva, después el detalle.',
  },
  {
    icon: 'account_tree',
    title: 'Diseñamos el recorrido del resumen al detalle',
    body: 'Cada cifra se abre hacia su origen: de la venta total al canal, al vendedor y al producto, sin pedir otro reporte.',
  },
  {
    icon: 'lightbulb',
    title: 'Incorporamos la lectura',
    body: 'Cada vista señala lo que está fuera de lo esperado y la prioridad recomendada.',
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.navTitle,
  description: service.metaDescription,
  serviceType: service.navTitle,
  provider: { '@id': `${SITE.url}/#organization` },
  areaServed: { '@type': 'Country', name: 'Chile' },
  url: new URL(path, SITE.url).href,
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: service.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const NIVELES = ['Venta total de la compañía', 'Por canal / sucursal', 'Por vendedor', 'Por categoría / marca', 'Por SKU'];
---

<BaseLayout
  title={service.metaTitle}
  description={service.metaDescription}
  path={path}
  schema={[serviceSchema, faqSchema]}
  heroAncla
>
  <!-- El marcado común vive en components/v2/Servicio.astro (sitio 2.0). Esta
       página es a medida solo en dos cosas: sus pasos y la sección del
       drill-down. Es la que recibe la mayor parte de la pauta. -->
  <Servicio
    service={service}
    pasos={{ title: 'Cómo construimos su dashboard', steps }}
    pregunta="¿Sus indicadores se arman a mano cada semana?"
    cierre="¿Quiere ver cómo se vería con los datos de su empresa?"
  >
    <VideoDemo slot="maqueta" solo archivo="dashboards" rotulo="El cumplimiento de la meta, al día de hoy y por vendedor." />

    <section slot="extra" class="v2-seccion">
      <div class="v2-marco v2-conexion__grilla">
        <div class="v2-e-sube" data-v2-entra>
          <p class="v2-indice">Enfoque analítico</p>
          <h2 class="v2-titulo">Del titular a la causa, <em>en un clic</em></h2>
          <p class="v2-parrafo">
            Un buen dashboard ejecutivo respeta cómo decide un gerente: primero la vista general
            (top-down) y, cuando algo llama la atención, la posibilidad de profundizar (drill-down)
            hasta el dato que lo explica.
          </p>
          <p class="v2-parrafo">
            No tiene que pedir otro reporte ni esperar a que alguien lo arme: la respuesta ya está en
            el mismo tablero.
          </p>
        </div>
        <!-- El drill-down, dibujado: cada nivel es más angosto que el anterior
             y entra un poco después al bajar. -->
        <ol class="v2-niveles" data-v2-entra="0.8">
          {NIVELES.map((n, i) => <li style={`--n:${i}`}><b>{String(i + 1).padStart(2, '0')}</b>{n}</li>)}
        </ol>
      </div>
    </section>
  </Servicio>
</BaseLayout>
