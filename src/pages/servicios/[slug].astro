---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ForecastMockup from '../../components/ForecastMockup.astro';
import AutomationMockup from '../../components/AutomationMockup.astro';
import AgentMockup from '../../components/AgentMockup.astro';
import Servicio from '../../components/v2/Servicio.astro';
import { SITE } from '../../config/site';
import { SERVICES_CONTENT } from '../../data/services';
import { STEPS } from '../../data/serviceSteps';

// "dashboards-ejecutivos" tiene su propia página dedicada. El resto se genera acá.
const REDISENADAS = ['dashboards-ejecutivos'];

export function getStaticPaths() {
  const REDIS = ['dashboards-ejecutivos'];
  return SERVICES_CONTENT.filter((s) => !REDIS.includes(s.slug)).map((s) => ({
    params: { slug: s.slug },
    props: { service: s },
  }));
}

const { service } = Astro.props;
const path = `/servicios/${service.slug}`;
const stepData = STEPS[service.slug];

// Pregunta de la franja al diagnóstico, por servicio
const preguntaDiagnostico: Record<string, string> = {
  'modelamiento-predictivo': '¿Tus proyecciones dependen de una planilla y de la intuición?',
  'automatizacion-procesos': '¿Tu equipo pierde horas pasando datos a mano entre planillas y sistemas?',
  'agentes-ia': '¿Tu equipo responde una y otra vez las mismas consultas?',
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.navTitle,
  description: service.metaDescription,
  serviceType: service.navTitle,
  provider: { '@id': `${SITE.url}/#organization` },
  areaServed: { '@type': 'Country', name: 'Chile' },
  url: new URL(path, SITE.url).href,
};
const faqSchema =
  service.faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: service.faq.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;
const schema = faqSchema ? [serviceSchema, faqSchema] : serviceSchema;
---

<BaseLayout title={service.metaTitle} description={service.metaDescription} path={path} schema={schema} heroAncla>
  <!-- El marcado de la página vive en components/v2/Servicio.astro (sitio 2.0),
       compartido con dashboards-ejecutivos. Acá quedan los datos y los schemas. -->
  <Servicio
    service={service}
    pasos={stepData}
    pregunta={preguntaDiagnostico[service.slug] ?? '¿Tus datos te ayudan a decidir o solo a reportar?'}
    cierre="¿Quiere ver cómo aplicaría a su empresa?"
  >
    <Fragment slot="maqueta">
      {service.slug === 'modelamiento-predictivo' && <ForecastMockup />}
      {service.slug === 'automatizacion-procesos' && <AutomationMockup />}
      {service.slug === 'agentes-ia' && <AgentMockup />}
    </Fragment>
  </Servicio>
</BaseLayout>
