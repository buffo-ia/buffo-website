---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Servicio from '../../components/v2/Servicio.astro';
import Demo from '../../components/v2/Demo.astro';
import Flujo from '../../components/v2/Flujo.astro';
import VideoDemo from '../../components/v2/VideoDemo.astro';
import { SITE } from '../../config/site';
import { SERVICES_CONTENT } from '../../data/services';
import { STEPS } from '../../data/serviceSteps';

// "dashboards-ejecutivos" tiene su propia página dedicada. El resto se genera acá.
const REDISENADAS = ['dashboards-ejecutivos'];

export function getStaticPaths() {
  const REDIS = ['dashboards-ejecutivos'];
  return SERVICES_CONTENT.filter((s) => !REDIS.includes(s.slug)).map((s) => ({
    params: { slug: s.slug },
    props: { service: s },
  }));
}

const { service } = Astro.props;
const path = `/servicios/${service.slug}`;
const stepData = STEPS[service.slug];

// Pregunta de la franja al diagnóstico, por servicio
const preguntaDiagnostico: Record<string, string> = {
  'modelamiento-predictivo': '¿Sus proyecciones dependen de una planilla y de la intuición?',
  'automatizacion-procesos': '¿Su equipo pierde horas pasando datos a mano entre planillas y sistemas?',
  'agentes-ia': '¿Su equipo responde una y otra vez las mismas consultas?',
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.navTitle,
  description: service.metaDescription,
  serviceType: service.navTitle,
  provider: { '@id': `${SITE.url}/#organization` },
  areaServed: { '@type': 'Country', name: 'Chile' },
  url: new URL(path, SITE.url).href,
};
const faqSchema =
  service.faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: service.faq.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;
const schema = faqSchema ? [serviceSchema, faqSchema] : serviceSchema;
---

<BaseLayout title={service.metaTitle} description={service.metaDescription} path={path} schema={schema} heroAncla>
  <!-- El marcado de la página vive en components/v2/Servicio.astro (sitio 2.0),
       compartido con dashboards-ejecutivos. Acá quedan los datos y los schemas. -->
  <Servicio
    service={service}
    pasos={stepData}
    pregunta={preguntaDiagnostico[service.slug] ?? '¿Sus datos le ayudan a decidir o solo a reportar?'}
    cierre="¿Quiere ver cómo aplicaría a su empresa?"
  >
    <Fragment slot="maqueta">
      {service.slug === 'modelamiento-predictivo' && <VideoDemo solo archivo="modelamiento" rotulo="La proyección de los próximos seis meses, ajustable por su equipo." />}
      {service.slug === 'automatizacion-procesos' && <VideoDemo solo archivo="automatizacion" rotulo="La cartera por cobrar, actualizada cada mañana sin planillas." />}
      {service.slug === 'agentes-ia' && <VideoDemo solo archivo="agentes-portada" rotulo="El agente avisa en la plataforma y en su teléfono. Una persona decide." />}
    </Fragment>
    {/* La terminal del agente y la demostración con cursores salieron del home corporativo (12-oct-2026) y viven acá. */}
    {service.slug === 'agentes-ia' && <Flujo corto slot="extra" />}
    {service.slug === 'agentes-ia' && <Demo slot="extra" />}
    {service.slug === 'agentes-ia' && <VideoDemo slot="extra" archivo="agentes" rotulo="Qué comprar y cuándo: el sistema propone, su equipo decide." />}
  </Servicio>
</BaseLayout>
