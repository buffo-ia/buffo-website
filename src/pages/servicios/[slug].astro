---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ServiceSteps from '../../components/ServiceSteps.astro';
import ForecastMockup from '../../components/ForecastMockup.astro';
import AutomationMockup from '../../components/AutomationMockup.astro';
import AgentMockup from '../../components/AgentMockup.astro';
import FranjaDiagnostico from '../../components/FranjaDiagnostico.astro';
import MedirCtaDiagnostico from '../../components/MedirCtaDiagnostico.astro';
import { SITE } from '../../config/site';
import { SERVICES_CONTENT } from '../../data/services';
import { STEPS } from '../../data/serviceSteps';

// "dashboards-ejecutivos" tiene su propia página dedicada. El resto se genera acá.
const REDISENADAS = ['dashboards-ejecutivos'];

export function getStaticPaths() {
  const REDIS = ['dashboards-ejecutivos'];
  return SERVICES_CONTENT.filter((s) => !REDIS.includes(s.slug)).map((s) => ({
    params: { slug: s.slug },
    props: { service: s },
  }));
}

const { service } = Astro.props;
const path = `/servicios/${service.slug}`;
const others = SERVICES_CONTENT.filter((s) => s.slug !== service.slug);
const stepData = STEPS[service.slug];

// Pregunta de la franja al diagnóstico, por servicio
const preguntaDiagnostico: Record<string, string> = {
  'modelamiento-predictivo': '¿Tus proyecciones dependen de una planilla y de la intuición?',
  'automatizacion-procesos': '¿Tu equipo pierde horas pasando datos a mano entre planillas y sistemas?',
  'agentes-ia': '¿Tu equipo responde una y otra vez las mismas consultas?',
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.navTitle,
  description: service.metaDescription,
  serviceType: service.navTitle,
  provider: { '@id': `${SITE.url}/#organization` },
  areaServed: { '@type': 'Country', name: 'Chile' },
  url: new URL(path, SITE.url).href,
};
const faqSchema =
  service.faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: service.faq.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;
const schema = faqSchema ? [serviceSchema, faqSchema] : serviceSchema;
---

<BaseLayout title={service.metaTitle} description={service.metaDescription} path={path} schema={schema} heroAncla>
  <!-- HERO con visual al lado -->
  <section class="bloque-ancla resplandor px-8 md:px-12 pt-28 pb-24">
    <div class="max-w-6xl mx-auto">
      <div class="mb-10">
        <Breadcrumbs items={[{ label: 'Servicios', href: '/servicios' }, { label: service.navTitle, href: path }]} />
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 items-center">
        <!-- En celular el botón va antes del lead: si no, en «Dashboards» queda bajo
             el borde de la pantalla y la barra fija no aparece hasta salir del hero. -->
        <div class="flex flex-col">
          <div class="acento-en mb-7">{service.nameEn}</div>
          <h1 class="text-[2.5rem] md:text-[3.4rem] font-display leading-[1.08] mb-6 tracking-[-0.02em]">
            {service.h1}
          </h1>
          <p class="text-lg text-on-surface-variant leading-relaxed order-last mt-8 lg:order-none lg:mt-0 lg:mb-8">{service.lead}</p>
          <div>
            <a
              href="/diagnostico"
              data-cta-diagnostico="hero"
              class="btn-glow bg-primary text-on-primary px-9 py-4 font-semibold text-base inline-block"
            >
              Haz tu diagnóstico gratis · 3 min
            </a>
            <p class="text-sm text-on-surface-variant mt-4">
              o <a
                href={SITE.calendly}
                target="_blank"
                rel="noopener noreferrer"
                class="underline underline-offset-4 hover:text-primary transition-colors"
              >agenda una llamada de 30 min</a>
            </p>
          </div>
        </div>
        <div class="reveal reveal-delay-1">
          {service.slug === 'modelamiento-predictivo' && <ForecastMockup />}
          {service.slug === 'automatizacion-procesos' && <AutomationMockup />}
          {service.slug === 'agentes-ia' && <AgentMockup />}
        </div>
      </div>
    </div>
  </section>

  <!-- EJEMPLOS (si el servicio los tiene, ej. Agentes IA) -->
  {
    service.examples && service.examples.length > 0 && (
      <section class="px-8 md:px-12 py-20 bg-surface-container-lowest border-y border-on-surface/5">
        <div class="max-w-5xl mx-auto">
          <div class="mb-12 reveal">
            <p class="text-primary tracking-widest uppercase text-xs font-semibold mb-3">Ejemplos</p>
            <h2 class="text-[2rem] md:text-[2.4rem] font-display">¿Qué agentes podemos construir?</h2>
            <p class="text-on-surface-variant mt-4 max-w-2xl leading-relaxed">
              Cada agente se diseña a la medida de un proceso real de su negocio. Estos son algunos de
              los más pedidos:
            </p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-on-surface/5 border border-on-surface/5">
            {service.examples.map((ex, i) => (
              <div class:list={['bg-surface-container-low p-7 card-hover reveal', i % 3 === 1 && 'reveal-delay-1', i % 3 === 2 && 'reveal-delay-2']}>
                <span class="material-symbols-outlined text-primary text-3xl mb-4 block">{ex.icon}</span>
                <h3 class="font-display text-lg mb-2">{ex.title}</h3>
                <p class="text-on-surface-variant text-sm leading-relaxed">{ex.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- CÓMO TRABAJAMOS -->
  {stepData && <ServiceSteps title={stepData.title} steps={stepData.steps} />}

  <!-- PREGUNTAS DE FONDO
       El texto vive en `data/services.ts`. Estos bloques existían en los datos
       desde el principio pero la plantilla nunca los renderizaba: se escribían
       y no se veían. Los encabezados van en pregunta a propósito — es lo que
       piden los motores de respuesta (GEO/AEO) y es como lo pregunta un
       cliente de verdad. -->
  <section class="px-8 md:px-12 py-20 bg-background border-t border-on-surface/5">
    <div class="max-w-3xl mx-auto space-y-14">
      {
        service.sections.map((s, i) => (
          <div class:list={['reveal', i > 0 && 'reveal-delay-1']}>
            <h2 class="text-[1.6rem] md:text-[2rem] font-display leading-tight mb-5">{s.heading}</h2>
            {s.body.map((p) => (
              <p class="text-on-surface-variant leading-relaxed mb-4">{p}</p>
            ))}
          </div>
        ))
      }
    </div>
  </section>

  <!-- ENTREGABLES en grilla visual -->
  <section class="px-8 md:px-12 py-20 bg-surface-container-lowest border-t border-on-surface/5">
    <div class="max-w-5xl mx-auto">
      <div class="mb-12 reveal">
        <p class="text-primary tracking-widest uppercase text-xs font-semibold mb-3">Qué entregamos</p>
        <h2 class="text-[2rem] md:text-[2.4rem] font-display">¿Qué incluye el servicio?</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-on-surface/5 border border-on-surface/5">
        {
          service.deliverables.map((d, i) => (
            <div class:list={['bg-surface-container-low p-7 flex items-start gap-4 card-hover reveal', i % 3 === 1 && 'reveal-delay-1', i % 3 === 2 && 'reveal-delay-2']}>
              <span class="material-symbols-outlined text-primary text-2xl flex-shrink-0">check_circle</span>
              <span class="text-sm text-on-surface/90 leading-snug">{d}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- DIAGNÓSTICO al medio: justo después de lo que se entrega -->
  <FranjaDiagnostico pregunta={preguntaDiagnostico[service.slug] ?? '¿Tus datos te ayudan a decidir o solo a reportar?'} />

  <!-- PARA QUIÉN -->
  <section class="px-8 md:px-12 py-20 bg-surface-container-lowest border-y border-on-surface/5">
    <div class="max-w-5xl mx-auto">
      <div class="mb-12 reveal">
        <p class="text-primary tracking-widest uppercase text-xs font-semibold mb-3">Para quién</p>
        <h2 class="text-[2rem] md:text-[2.4rem] font-display">¿Para quién es este servicio?</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {
          service.forWhom.map((d, i) => (
            <div class:list={['bg-surface-container-low border border-on-surface/5 p-7 card-hover reveal', i === 1 && 'reveal-delay-1', i === 2 && 'reveal-delay-2']}>
              <span class="material-symbols-outlined text-primary text-3xl mb-4 block">person</span>
              <p class="text-sm text-on-surface/90 leading-relaxed">{d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ -->
  {
    service.faq.length > 0 && (
      <section class="px-8 md:px-12 py-20 bg-background">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-[2rem] md:text-[2.4rem] font-display mb-10 reveal">Preguntas frecuentes</h2>
          <div class="space-y-2">
            {service.faq.map((f, i) => (
              <details class:list={['faq-item border border-on-surface/5 bg-surface-container-low group reveal', i === 1 && 'reveal-delay-1', i >= 2 && 'reveal-delay-2']}>
                <summary class="flex justify-between items-center px-8 py-6 cursor-pointer hover:bg-surface-container transition-colors list-none">
                  <span class="font-semibold text-on-surface">{f.q}</span>
                  <span class="material-symbols-outlined text-primary transition-transform group-open:rotate-45">add</span>
                </summary>
                <div class="px-8 pb-6">
                  <p class="text-on-surface-variant leading-relaxed">{f.a}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Otros servicios -->
  <section class="px-8 md:px-12 py-20 bg-surface-container-lowest border-t border-on-surface/5">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-2xl font-display mb-8 reveal">Otros servicios</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {
          others.map((o, i) => (
            <a href={`/servicios/${o.slug}`} class:list={['bg-surface-container-low border border-on-surface/5 p-7 card-hover group block reveal', i === 1 && 'reveal-delay-1', i === 2 && 'reveal-delay-2']}>
              <span class="material-symbols-outlined text-primary text-3xl mb-4 block group-hover:scale-110 transition-transform">{o.icon}</span>
              <h3 class="font-display text-lg mb-1">{o.navTitle}</h3>
              <span class="text-primary text-sm font-semibold opacity-0 group-hover:opacity-100 transition-opacity">Ver más →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="px-8 md:px-12 py-20 bg-surface-container-low border-t border-on-surface/5">
    <div class="max-w-3xl mx-auto text-center reveal">
      <h2 class="text-3xl md:text-4xl font-display mb-8 leading-tight">
        ¿Quiere ver cómo aplicaría a su empresa?
      </h2>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/diagnostico" data-cta-diagnostico="cierre" class="btn-glow bg-primary text-on-primary px-10 py-5 font-semibold text-base">
          Haz tu diagnóstico gratis · 3 min
        </a>
        <a href={SITE.calendly} target="_blank" rel="noopener noreferrer" class="border border-outline-variant text-on-surface px-10 py-5 font-semibold text-base hover:border-primary/30 transition-all">
          Agenda una llamada de 30 min
        </a>
      </div>
    </div>
  </section>
  <MedirCtaDiagnostico />
</BaseLayout>
