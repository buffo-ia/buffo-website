---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Acompana from '../../components/v2/Acompana.astro';
import { SITE } from '../../config/site';
import { SERVICES_CONTENT } from '../../data/services';
import { LINEAS } from '../../data/lineas';

const title = 'Servicios de Inteligencia Artificial para Empresas | Buffo IA';
const description =
  'Servicios de Buffo IA Consulting para empresas en Chile: dashboards ejecutivos, modelamiento de datos, automatización de procesos y agentes de inteligencia artificial.';

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: SERVICES_CONTENT.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.navTitle,
    url: new URL(`/servicios/${s.slug}`, SITE.url).href,
  })),
};

// Las cuatro líneas son las del home (data/lineas.ts). Acá cambian los enlaces:
// las líneas 03 y 04 llevan a sus dos páginas de servicio. La 01 no tiene
// página propia, así que va a la reunión.
const pagina = (slug: string) => ({
  texto: SERVICES_CONTENT.find((s) => s.slug === slug)!.navTitle,
  href: `/servicios/${slug}`,
  externo: false,
});
const ENLACES = [
  [{ texto: 'Agendar 30 minutos', href: SITE.calendly, externo: true }],
  [{ texto: 'Hacer el diagnóstico en 3 minutos', href: '/diagnostico', externo: false }],
  [pagina('dashboards-ejecutivos'), pagina('modelamiento-predictivo')],
  [pagina('agentes-ia'), pagina('automatizacion-procesos')],
];

// Preguntas de quien todavía no sabe por cuál línea partir.
const PREGUNTAS = [
  {
    q: '¿Por dónde conviene partir?',
    a: 'Por la prioridad de negocio. Si la pregunta es dónde está el retorno, se parte por la consultoría. Si la decisión ya está definida y falta información, por la analítica. Si la información existe y el costo está en el trabajo manual, por los flujos con agentes.',
  },
  {
    q: '¿Hay que contratar las cuatro líneas?',
    a: 'No. Lo habitual es partir por una. Cada etapa deja definida la siguiente, y con frecuencia esa siguiente es más acotada porque la información ya está ordenada.',
  },
  {
    q: '¿Hay que cambiar los sistemas actuales?',
    a: 'No. Todo se construye sobre el ERP, las planillas y las herramientas que su empresa ya usa.',
  },
  {
    q: '¿Cómo se mide el resultado?',
    a: 'Cada proyecto parte con un objetivo y un retorno esperado, y se revisa contra ellos con su gerencia.',
  },
];
---

<BaseLayout title={title} description={description} path="/servicios" schema={itemListSchema} heroAncla>
  <section class="bloque-ancla resplandor px-8 md:px-12 pt-28 pb-20">
    <div class="max-w-5xl mx-auto">
      <div class="mb-10">
        <Breadcrumbs items={[{ label: 'Servicios', href: '/servicios' }]} />
      </div>
      <p class="text-primary tracking-widest uppercase text-xs font-semibold mb-4">Servicios</p>
      <h1 class="text-[2.5rem] md:text-[3.4rem] font-display leading-[1.08] mb-7 tracking-[-0.02em] max-w-4xl">
        Servicios de consultoría en inteligencia de negocios e IA para empresas
      </h1>
      <p class="text-lg md:text-xl text-on-surface-variant leading-relaxed max-w-3xl">
        Acompañamos a su gerencia de manera estratégica, desde la definición de objetivos y retorno
        hasta la implementación de IA en la operación. Cuatro líneas de servicio, que se combinan
        según la prioridad de su empresa.
      </p>
    </div>
  </section>

  <!-- La tarjeta dejó de ser un enlace entero: las líneas 03 y 04 llevan a dos
       páginas cada una, y un enlace no puede ir dentro de otro. -->
  <section class="px-8 md:px-12 py-20 bg-background">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-px bg-on-surface/5 border border-on-surface/5">
      {
        LINEAS.map((l, i) => (
          <div class="bg-surface-container-low p-12 border border-transparent">
            <p class="text-primary text-4xl font-display mb-6" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
            <h2 class="text-2xl font-display mb-2">{l.nombre}</h2>
            <span class="acento-en mb-4" lang="en">{l.en}</span>
            <p class="text-on-surface-variant leading-relaxed mb-6">{l.frase}</p>
            <p class="text-on-surface-variant/70 text-[0.7rem] tracking-[0.17em] uppercase font-semibold mb-3">
              Qué recibe
            </p>
            <ul class="text-on-surface-variant leading-relaxed mb-6 space-y-2 list-disc pl-5">
              {l.recibe.map((r) => <li>{r}</li>)}
            </ul>
            <div class="flex flex-col items-start gap-2">
              {
                ENLACES[i].map((e) => (
                  <a
                    href={e.href}
                    target={e.externo ? '_blank' : undefined}
                    rel={e.externo ? 'noopener noreferrer' : undefined}
                    class="text-primary text-sm font-semibold hover:underline"
                  >
                    {e.texto} →
                  </a>
                ))
              }
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- La franja es del sitio 2.0: se envuelve en .v2 para que tome sus colores.
       Sin el motor de entradas (Aparecer) queda siempre a la vista. -->
  <section class="v2 px-8 md:px-12 pb-20">
    <div class="max-w-5xl mx-auto">
      <Acompana suelta />
    </div>
  </section>

  <!-- PREGUNTAS DE FONDO
       Responden lo que se pregunta alguien que todavía no sabe qué servicio le
       corresponde, que es la intención de búsqueda con la que se llega acá. -->
  <section class="px-8 md:px-12 py-20 bg-background border-t border-on-surface/5">
    <div class="max-w-3xl mx-auto space-y-14">
      {
        PREGUNTAS.map((f) => (
          <div class="reveal">
            <h2 class="text-[1.6rem] md:text-[2rem] font-display leading-tight mb-5">{f.q}</h2>
            <p class="text-on-surface-variant leading-relaxed">{f.a}</p>
          </div>
        ))
      }

      <!-- Acotar el alcance es lo que mas confianza da, y los motores de
           respuesta premian la respuesta directa. Va aca y no en la home
           porque esta pagina tiene rango de palabras de sobra. -->
      <div class="reveal reveal-delay-2">
        <h2 class="text-[1.6rem] md:text-[2rem] font-display leading-tight mb-5">
          ¿Hacen modelos de machine learning a medida?
        </h2>
        <p class="text-on-surface-variant leading-relaxed mb-4">
          No como fin en sí mismo. Buffo IA no es un laboratorio de investigación: no entrenamos
          modelos experimentales, no hacemos visión computacional ni desarrollamos algoritmos para
          el producto de software de otra empresa. Si eso es lo que su compañía necesita, conviene
          un equipo especializado en eso, y se lo decimos de entrada.
        </p>
        <p class="text-on-surface-variant leading-relaxed">
          Lo que sí hacemos es aplicar inteligencia artificial a la gestión comercial y operacional:
          ventas, margen, presupuesto, stock, cobranza y reportería. Cuando uno de esos problemas se
          resuelve mejor con un modelo predictivo, como proyectar la demanda o anticipar un quiebre,
          lo construimos, con criterio comercial y con los supuestos a la vista. La técnica es el
          medio; la decisión de negocio es el objetivo.
        </p>
      </div>
    </div>
  </section>

  <section class="px-8 md:px-12 py-20 bg-surface-container-low border-t border-on-surface/5">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-display mb-8 leading-tight">
        ¿No sabe cuál necesita?
      </h2>
      <p class="text-on-surface-variant mb-8 leading-relaxed">
        Es la pregunta más común y tiene respuesta en tres minutos. Doce preguntas sobre cómo se
        mueve hoy su información, y le decimos por dónde partir, con el informe por escrito, sin
        llamada de por medio.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/diagnostico"
          class="btn-glow bg-primary text-on-primary px-12 py-5 font-semibold text-base inline-block"
        >
          Hacer el diagnóstico en 3 minutos
        </a>
        <a
          href={SITE.calendly}
          target="_blank"
          rel="noopener noreferrer"
          class="border border-outline-variant text-on-surface px-12 py-5 font-semibold text-base inline-block hover:border-primary/30 transition-all"
        >
          Agendar 30 minutos
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
