---
import BaseLayout from '../layouts/BaseLayout.astro';
import InformeMockup from '../components/InformeMockup.astro';
import DashboardMockup from '../components/DashboardMockup.astro';
import ForecastMockup from '../components/ForecastMockup.astro';
import AutomationMockup from '../components/AutomationMockup.astro';
import AgentMockup from '../components/AgentMockup.astro';
import VentanaNavegador from '../components/VentanaNavegador.astro';
// El STACK de site.ts son las 16 herramientas del marquee. Ojo: data/diagnostico
// exporta otro STACK, de 5, que es el que se imprime DENTRO del informe. Cumplen
// cosas distintas y por eso no se unifican.
import { SITE, SERVICES, SERVICE_PAINS, STACK as STACK_MARQUEE } from '../config/site';
import {
  INTRO, TRONCO, RAMALES, PREGUNTA_ABIERTA, TRAMOS, TOTAL_PREGUNTAS, COSTO_HORA, valorHora,
  PROPUESTA, INCLUYE_SIEMPRE, FASES, STACK,
} from '../data/diagnostico';
import { readFileSync } from 'node:fs';

const stackConLogo = STACK.map((h) => ({
  nombre: h.nombre,
  // Se le saca el fill blanco del archivo original (venía para fondo oscuro)
  // para que lo defina el CSS del informe.
  svg: readFileSync(`public/stack/${h.archivo}.svg`, 'utf8').replace(/\s*fill="[^"]*"/g, ''),
}));

// /diagnostico dejó de ser un formulario: es la página donde aterriza TODO el
// tráfico pagado, así que tiene que sostenerse sola frente a alguien que llega
// sin saber quiénes somos. Lo que sigue es esa landing. Vive únicamente en el
// paso "intro" y desaparece en cuanto arranca el cuestionario, porque después de
// apretar Empezar cualquier cosa que no sea la pregunta es una fuga.

// Qué se lleva. Es la objeción número uno frente a un formulario de 12 preguntas:
// "¿esto para qué me sirve a mí?". Va antes que cualquier cosa sobre nosotros.
const ENTREGA = [
  {
    icono: 'speed',
    titulo: 'Un puntaje de 0 a 100',
    texto: 'Cuánta visibilidad real tiene hoy sobre su operación, con seis dimensiones medidas por separado.',
    corto: 'Seis dimensiones, medidas por separado.',
  },
  {
    icono: 'troubleshoot',
    titulo: 'Tres hallazgos concretos',
    texto: 'Qué detectamos en sus respuestas, ordenado del más grave al menos grave. Sin diagnóstico genérico.',
    corto: 'Del más grave al menos grave.',
  },
  {
    icono: 'payments',
    titulo: 'Cuánto le cuesta al año',
    texto: 'El cálculo de lo que se va en trabajo repetitivo, sobre las horas que usted mismo declaró.',
    corto: 'Sobre las horas que usted declaró.',
  },
  {
    icono: 'checklist',
    titulo: 'Qué haría un consultor',
    texto: 'Los próximos pasos concretos, y también lo que no podemos decirle sin conocerlos mejor.',
    corto: 'Y lo que no podemos decir todavía.',
  },
];

// Los cuatro servicios con su mockup animado. Mismo criterio que el home: el
// titular es el DOLOR y el nombre del producto va de eyebrow, porque nadie
// reconoce su problema en la palabra "modelamiento predictivo".
const CAPACIDADES = [
  { slug: 'dashboards-ejecutivos', eyebrow: 'Dashboards ejecutivos', url: 'app.buffoconsulting.cl/dashboard', Mock: DashboardMockup },
  { slug: 'modelamiento-predictivo', eyebrow: 'Modelamiento de datos', url: 'app.buffoconsulting.cl/proyeccion', Mock: ForecastMockup },
  { slug: 'automatizacion-procesos', eyebrow: 'Automatización de procesos', url: 'app.buffoconsulting.cl/flujos', Mock: AutomationMockup },
  { slug: 'agentes-ia', eyebrow: 'Agentes IA', url: 'app.buffoconsulting.cl/agentes', Mock: AgentMockup },
];

// Dos ayudas mínimas para que el markup de abajo no lleve plantillas incrustadas.
const LOGO = (src: string) => '--logo:url(' + JSON.stringify(src) + ')';
const VER = (slug: string) => '/servicios/' + slug;

const COMO_FUNCIONA = [
  { n: '01', titulo: 'Responde doce preguntas', texto: 'Sobre cómo circula hoy la información en su empresa. Tres minutos, sin preparar nada.' },
  { n: '02', titulo: 'Se analiza con IA', texto: 'Sus respuestas se cruzan contra el criterio de alguien que tuvo que responder por esos números.' },
  { n: '03', titulo: 'Recibe el informe', texto: 'En pantalla al momento y en PDF a su correo. Sin llamada de por medio y sin compromiso.' },
];

// El banco completo viaja al cliente: el flujo es puro front hasta que el
// visitante entrega su correo. Así nadie abandona por un formulario al inicio.
const banco = {
  tronco: TRONCO,
  ramales: RAMALES,
  abierta: PREGUNTA_ABIERTA,
  tramos: TRAMOS,
  total: TOTAL_PREGUNTAS,
  calendly: SITE.calendly,
  costo: { ...COSTO_HORA, valorHora: valorHora() },
  propuesta: PROPUESTA,
  incluye: INCLUYE_SIEMPRE,
  fases: FASES,
  stack: stackConLogo,
};

const title = `Diagnóstico de 3 minutos | ${SITE.shortName}`;
const description =
  'Doce preguntas para medir qué tan visible es su operación. Puntaje inmediato en pantalla y un informe completo en PDF.';

// Esta página no tenía schema propio: solo heredaba Organization y WebSite.
// Es la que más se comparte con prospectos, así que conviene que un motor de
// respuesta entienda qué es — una evaluación gratuita, no una página cualquiera.
const diagnosticoSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${SITE.url}/diagnostico#servicio`,
  name: 'Diagnóstico de visibilidad operacional',
  serviceType: 'Evaluación gratuita de madurez de datos y gestión',
  description:
    'Cuestionario de doce preguntas que mide qué tan visible es la operación de una empresa: dónde llega tarde la información, qué procesos dependen de trabajo manual y qué conviene resolver primero. Entrega un puntaje en pantalla y un informe en PDF.',
  provider: { '@id': `${SITE.url}/#organization` },
  areaServed: { '@type': 'Country', name: 'Chile' },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'CLP',
    availability: 'https://schema.org/InStock',
    description: 'Sin costo y sin presentación de ventas.',
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Diagnóstico',
      item: new URL('/diagnostico', SITE.url).href,
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  path="/diagnostico"
  schema={[diagnosticoSchema, breadcrumbSchema]}
>
  <!-- `flex items-center` centra el bloque en la pantalla. Antes el contenido
       quedaba pegado arriba dentro de una sección de alto completo, así que
       sobraba un tercio en blanco abajo y se leía como que faltaba algo. -->
  <section id="lienzo" class="flex hero-bg">
    <div class="mx-auto w-full max-w-6xl px-6 pb-8 pt-6 sm:pt-7">
      <!-- 1. Intro — dos columnas.
           La derecha contesta la pregunta que se hace un prospecto frío frente
           al botón: ¿qué me llevo por tres minutos? Es la única pantalla del
           flujo con esta medida ancha; en cuanto empieza el cuestionario se
           vuelve a la columna angosta, que es la que se lee cómoda. -->
      <div id="paso-intro" class="grid items-center gap-12 lg:grid-cols-[1fr_minmax(0,27rem)] lg:gap-16">
        <div>
          <!-- La cejilla ubica dos cosas de golpe: que esto es gratis y que hay
               una consultora chilena detrás. El que llega desde un anuncio no
               sabe ninguna de las dos. -->
          <p class="reveal text-primary text-[0.7rem] tracking-[0.2em] uppercase font-semibold mb-6">
            Diagnóstico gratuito · Consultora de IA · Santiago de Chile
          </p>
          <h1
            class="reveal reveal-delay-1 font-display text-[2.15rem] leading-[1.06] tracking-[-0.025em] sm:text-[3.2rem] lg:text-[3.6rem]"
          >
            {INTRO.titulo}
          </h1>
          <p
            class="reveal reveal-delay-1 mt-4 font-display text-lg text-on-surface md:text-xl"
            style="font-weight:600; letter-spacing:-0.01em;"
          >
            Cuando el dato llega, la decisión ya se tomó.
          </p>
          <p class="reveal reveal-delay-2 mt-4 max-w-xl text-base leading-[1.6] text-on-surface-variant md:text-lg">
            {INTRO.bajada}
          </p>

          <!-- Dos salidas, no una. El que ya está convencido agenda; el que no,
               prueba con tres minutos. Sin la segunda puerta, el que no quiere
               llenar un formulario simplemente se va. -->
          <div class="reveal reveal-delay-3 mt-7 flex flex-col gap-3 sm:flex-row sm:gap-4">
            <button
              id="btn-empezar"
              class="btn-glow bg-primary px-9 py-5 text-base font-semibold text-on-primary"
            >
              Empezar el diagnóstico · 3 minutos
            </button>
            <a
              href={SITE.calendly}
              target="_blank"
              rel="noopener noreferrer"
              class="border border-outline-variant px-9 py-5 text-center text-base font-semibold text-on-surface transition-all hover:border-primary/40"
            >
              Agendar 30 minutos
            </a>
          </div>
          <p class="reveal reveal-delay-3 mt-4 text-sm text-outline">
            {TOTAL_PREGUNTAS} preguntas · 3 minutos · informe en PDF · {INTRO.promesa}
          </p>
        </div>

        <!-- En celular va primero el texto y después la muestra: nadie decide
             mirando el formato antes de saber de qué se trata. -->
        <div class="order-last">
          <InformeMockup />
        </div>
      </div>

      <div class="mx-auto max-w-3xl">
        <div id="barra" class="mb-12 hidden">
          <div class="mb-2 flex items-baseline justify-between text-xs text-on-surface-variant">
            <span id="barra-etapa">Contexto</span>
            <span id="barra-conteo">1 / {TOTAL_PREGUNTAS}</span>
          </div>
          <div class="h-px w-full bg-outline-variant">
            <div id="barra-avance" class="h-px bg-primary transition-all duration-300" style="width:0%"></div>
          </div>
        </div>

      <!-- 2. Selector de ramal: se pregunta el dolor, nunca el producto -->
      <div id="paso-ramal" class="hidden">
        <h2 class="font-display text-3xl leading-tight sm:text-4xl">¿Qué le complica más hoy?</h2>
        <p class="mt-3 text-on-surface-variant">Elija lo que más se acerque. Después profundizamos.</p>
        <div class="mt-10 grid gap-3">
          {
            RAMALES.map((r) => (
              <button
                data-ramal={r.id}
                class="opcion-ramal group flex flex-wrap items-start gap-x-4 gap-y-2 p-5 text-left sm:flex-nowrap"
              >
                <span class="material-symbols-outlined mt-0.5 text-outline group-hover:text-primary">
                  {r.icono}
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block font-medium">{r.dolor}</span>
                  <span class="mt-1 block text-sm text-on-surface-variant">{r.detalle}</span>
                </span>
                {/*
                  El frente de trabajo, como etiqueta secundaria. Deliberadamente
                  discreta: el que elige tiene que elegir por su dolor, no por el
                  nombre del producto — si supiera qué necesita no estaría acá.
                */}
                <span class="etiqueta-frente ml-9 shrink-0 sm:ml-0 sm:self-center">
                  {r.servicio}
                </span>
              </button>
            ))
          }
        </div>
      </div>

      <!-- 3. Preguntas, una por pantalla -->
      <div id="paso-pregunta" class="hidden">
        <h2 id="pregunta-texto" class="font-display text-2xl leading-snug sm:text-3xl"></h2>
        <div id="pregunta-opciones" class="mt-8 grid gap-3"></div>
        <button id="btn-volver" class="mt-8 text-sm text-on-surface-variant hover:text-primary">
          &larr; Volver
        </button>
      </div>

      <!-- 4. Pregunta abierta -->
      <div id="paso-abierta" class="hidden">
        <h2 class="font-display text-2xl leading-snug sm:text-3xl">{PREGUNTA_ABIERTA.texto}</h2>
        <p class="mt-3 text-sm text-on-surface-variant">{PREGUNTA_ABIERTA.ayuda}</p>
        <textarea
          id="campo-abierta" rows="4"
          class="mt-6 w-full border border-outline-variant bg-surface p-4 text-on-surface outline-none focus:border-primary"
          placeholder="Escriba lo primero que se le venga a la cabeza."></textarea>
        <button id="btn-abierta" class="mt-6 bg-primary px-8 py-4 font-medium text-on-primary btn-glow">
          Ver mi resultado
        </button>
      </div>

      <!-- 5. Datos: al final, nunca al principio -->
      <div id="paso-datos" class="hidden">
        <h2 class="font-display text-2xl leading-snug sm:text-3xl">Su resultado está listo</h2>
        <p class="mt-3 text-on-surface-variant">
          Dígame a nombre de quién lo emito y le llega también una copia al correo.
        </p>
        <form id="form-datos" class="mt-8 grid gap-4">
          <input type="text" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
          <label class="block">
            <span class="mb-1 block text-sm text-on-surface-variant">Nombre</span>
            <input type="text" name="nombre" required maxlength="120" autocomplete="name"
              class="w-full border border-outline-variant bg-surface p-3 outline-none focus:border-primary" />
          </label>
          <label class="block">
            <span class="mb-1 block text-sm text-on-surface-variant">Empresa</span>
            <input type="text" name="empresa" maxlength="160" autocomplete="organization"
              class="w-full border border-outline-variant bg-surface p-3 outline-none focus:border-primary" />
          </label>
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="mb-1 block text-sm text-on-surface-variant">Correo</span>
              <input type="email" name="email" required maxlength="160" autocomplete="email"
                class="w-full border border-outline-variant bg-surface p-3 outline-none focus:border-primary" />
            </label>
            <label class="block">
              <span class="mb-1 block text-sm text-on-surface-variant">
                Teléfono <span class="text-outline">(opcional)</span>
              </span>
              <input type="tel" name="telefono" maxlength="40" autocomplete="tel" placeholder="+56 9"
                class="w-full border border-outline-variant bg-surface p-3 outline-none focus:border-primary" />
            </label>
          </div>
          <button type="submit" class="mt-2 bg-primary px-8 py-4 font-medium text-on-primary btn-glow">
            Ver mi diagnóstico
          </button>
          <p id="error-datos" class="hidden text-sm text-error"></p>
        </form>
      </div>

      <!--
        6. Resultado. Una sola pasada de render; el CSS decide qué se ve dónde:
        la pantalla muestra el puntaje, las barras, el resumen y el primer
        hallazgo. El resto solo existe en el PDF, que es el entregable de verdad.
      -->
      <div id="paso-resultado" class="hidden">
        <div id="portada-pdf" class="solo-imprimir"></div>
        <div id="membrete" class="solo-imprimir"></div>
        <!-- Señal de que el informe se sigue escribiendo.
             Existe porque en pantalla solo se pinta "### titulares", que es la
             PRIMERA de las once secciones: las otras diez son solo-imprimir y se
             van al PDF. O sea el visitante pasa medio minuto mirando algo que no
             cambia mientras el modelo trabaja, y no tiene cómo saber si se colgó.
             Antes de que hubiera tráfico pagado eso era una molestia; con la
             campaña apuntando acá es un clic comprado que se abandona.

             ⚠️ Va ARRIBA DEL TODO, antes del puntaje. Primero estuvo entre el
             encabezado y el análisis, y en un celular de 390 px quedaba a 892 px
             del borde: o sea justo fuera de la pantalla, invisible para el que
             está esperando. La señal de que algo sigue vivo no sirve si hay que
             ir a buscarla.

             ⚠️ Altura FIJA a propósito: nace junto con el resultado y no cambia
             de alto, así nada de lo que hay debajo se mueve mientras se lee. Por
             eso el detalle es una línea que se reemplaza, nunca una lista que se
             acumula. -->
        <div id="avance-informe" class="no-imprimir hidden">
          <div
            id="avance-barra-pista"
            role="progressbar"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
            aria-label="Avance del informe"
          >
            <div id="avance-barra"></div>
          </div>
          <p id="avance-detalle" aria-live="polite"></p>
        </div>

        <div id="resultado-encabezado"></div>

        <div id="resultado-analisis" class="mt-4"></div>

        <div id="teaser-pdf" class="no-imprimir hidden">
          <section class="mt-12 border border-primary/40 bg-primary/5 p-8">
            <p class="text-sm uppercase tracking-widest text-primary">El informe completo</p>
            <p class="mt-4 font-display text-2xl leading-snug">
              Lo que ve acá es la primera parte.
            </p>
            <p class="mt-4 leading-relaxed text-on-surface-variant">
              El PDF trae los tres hallazgos completos, el cálculo de lo que le cuesta al año el
              trabajo repetitivo según lo que usted declaró, cómo se vería su información resuelta,
              lo que más nos llamó la atención de sus respuestas y los próximos pasos concretos.
            </p>
            <button id="btn-pdf" class="mt-7 bg-primary px-8 py-4 font-medium text-on-primary btn-glow">
              Descargar el informe en PDF
            </button>
          </section>
        </div>

        <div id="pie-impreso" class="solo-imprimir"></div>

        <div id="resultado-cierre" class="no-imprimir hidden">
          <section class="mt-8 border border-outline-variant p-8">
            <p class="font-display text-2xl">Treinta minutos, sin presentación de ventas</p>
            <p class="mt-3 text-on-surface-variant">
              Le mandamos una copia por correo. Si quiere revisarlo con nosotros:
            </p>
            <a href={SITE.calendly} target="_blank" rel="noopener"
               class="mt-6 inline-block border border-outline-variant px-8 py-4 font-medium hover:border-primary">
              Agendar una conversación
            </a>
          </section>
        </div>
      </div>
      </div>
    </div>
  </section>


  <!-- ══ LANDING ══
       Vive SOLO en el paso intro y desaparece al apretar Empezar: con el
       cuestionario abierto, todo lo que no sea la pregunta es una fuga.

       ⚠️ Es corta a propósito. La primera versión tenía cinco secciones y 5.567
       px — un segundo home. Esta página no compite con el home: lo que tiene
       que hacer es que alguien apriete Empezar. Por eso lo que prueba quiénes
       somos va COMPRIMIDO y arriba, en la misma pantalla del botón, y abajo
       queda una sola cosa que mirar. -->
  <div id="landing-extra">
    <!-- Cierra la primera pantalla: cuatro entregables en una línea y la banda
         de herramientas. Sin titular de sección, porque no es una sección
         nueva: es el pie del hero, y asomando invita a bajar. -->
    <section class="overflow-hidden border-t border-on-surface/5 bg-background px-6 pb-7 pt-9 md:px-12">
      <div class="mx-auto max-w-6xl">
        <!-- Qué se lleva. Una línea por entregable: el detalle largo estaba en
             tarjetas y ocupaba media pantalla para decir lo mismo. -->
        <p class="reveal mb-5 text-xs font-semibold uppercase tracking-widest text-on-surface/40">
          Al terminar se lleva
        </p>
        <div class="grid grid-cols-2 gap-x-6 gap-y-5 lg:grid-cols-4">
          {
            ENTREGA.map((e) => (
              <div class="reveal flex items-start gap-2.5">
                <span class="material-symbols-outlined mt-0.5 shrink-0 text-lg text-primary">{e.icono}</span>
                <div class="min-w-0">
                  <h3 class="font-display text-[0.9rem] leading-snug text-on-surface">{e.titulo}</h3>
                  <p class="mt-0.5 text-[0.78rem] leading-snug text-on-surface-variant">{e.corto}</p>
                </div>
              </div>
            ))
          }
        </div>

        <!-- Y quiénes somos, en la misma pantalla del botón. Los cuatro
             servicios entran acá arriba porque el que llega de un anuncio
             decide antes de bajar; los mockups grandes siguen abajo para el
             que quiera verlos funcionando. Cada uno lleva a su página: si no
             va a apretar Empezar, que al menos recorra el sitio. -->
        <div class="mt-7 border-t border-on-surface/5 pt-7">
          <p class="reveal mb-5 text-xs font-semibold uppercase tracking-widest text-on-surface/40">
            Y lo que construimos
          </p>
          <div class="grid grid-cols-2 gap-x-6 gap-y-5 lg:grid-cols-4">
            {
              SERVICES.map((s) => (
                <a href={VER(s.slug)} class="reveal group flex items-start gap-2.5">
                  <span class="material-symbols-outlined mt-0.5 shrink-0 text-lg text-primary">{s.icon}</span>
                  <div class="min-w-0">
                    <h3 class="font-display text-[0.9rem] leading-snug text-on-surface transition-colors group-hover:text-primary">
                      {s.title}
                    </h3>
                    <p class="mt-0.5 text-[0.78rem] leading-snug text-on-surface-variant">
                      {SERVICE_PAINS[s.slug]}
                    </p>
                  </div>
                </a>
              ))
            }
          </div>
        </div>

        <!-- Banda de herramientas: la señal de que hay una empresa que
             construye software, en una línea en vez de una sección entera. -->
        <div class="reveal mt-7 flex flex-col gap-3 border-t border-on-surface/5 pt-6 sm:flex-row sm:items-center sm:gap-8">
          <p class="shrink-0 text-xs font-semibold uppercase tracking-widest text-on-surface/40">
            Corre sobre
          </p>
          <div class="marquee-mask min-w-0 flex-1">
            <div class="marquee-track gap-7 md:gap-9">
              {[...STACK_MARQUEE, ...STACK_MARQUEE].map((h, i) => (
                <div class="group flex shrink-0 items-center gap-2" aria-hidden={i >= STACK_MARQUEE.length ? 'true' : undefined}>
                  <span class="stack-logo h-4 w-4 shrink-0" style={LOGO(h.src)} aria-hidden="true"></span>
                  <span class="whitespace-nowrap text-xs font-semibold text-on-surface/45 transition-colors group-hover:text-on-surface">
                    {h.name}
                  </span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- LO ÚNICO QUE HAY QUE BAJAR A VER. Quiénes somos y qué construimos, en
         un bloque: el párrafo va de entrada y los cuatro mockups hacen el resto
         del trabajo. Es la parte que impacta, así que es la que se queda. -->
    <section class="losa bg-surface px-6 py-14 md:px-12 md:py-16">
      <div class="mx-auto max-w-6xl">
        <div class="reveal mb-10 max-w-3xl">
          <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-primary">Quiénes somos</p>
          <h2 class="font-display text-[1.9rem] leading-tight md:text-[2.5rem]">
            Una consultora que nació del otro lado del escritorio.
          </h2>
          <p class="mt-4 leading-relaxed text-on-surface-variant">
            Buffo IA Consulting no viene de TI: viene de diez años en áreas comerciales de retail y
            consumo masivo, respondiendo en reuniones por números que llegaban tarde. Por eso
            hablamos de ventas, margen y stock, y no de tecnología. Esto es lo que construimos.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-9">
          {
            CAPACIDADES.map((c, i) => (
              <div class:list={['reveal flex flex-col', i % 2 === 1 && 'reveal-delay-1']}>
                <p class="text-xs font-semibold uppercase tracking-widest text-primary">{c.eyebrow}</p>
                <h3 class="mb-4 mt-1.5 font-display text-lg leading-snug">{SERVICE_PAINS[c.slug]}</h3>
                <VentanaNavegador url={c.url} pestana={c.eyebrow}>
                  <c.Mock />
                </VentanaNavegador>
                <a
                  href={VER(c.slug)}
                  class="mt-4 inline-block self-start text-sm font-medium text-primary underline underline-offset-4 hover:no-underline"
                >
                  Ver cómo lo resolvemos
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CIERRE, corto. El botón sube al cuestionario; los enlaces son para el
         que llegó hasta acá sin convencerse: mejor que recorra el sitio a que
         cierre la pestaña. -->
    <section class="bg-background px-6 py-14 md:px-12 md:py-16">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="reveal font-display text-[1.9rem] leading-tight md:text-[2.5rem]">
          Tres minutos ahora, o seguir decidiendo a ciegas.
        </h2>
        <div class="reveal reveal-delay-1 mt-8 flex flex-col justify-center gap-4 sm:flex-row">
          <button id="btn-empezar-pie" class="btn-glow bg-primary px-9 py-5 text-base font-semibold text-on-primary">
            Empezar el diagnóstico
          </button>
          <a
            href={SITE.calendly}
            target="_blank"
            rel="noopener noreferrer"
            class="border border-outline-variant px-9 py-5 text-center text-base font-semibold text-on-surface transition-all hover:border-primary/40"
          >
            Prefiero agendar una llamada
          </a>
        </div>
        <div class="reveal reveal-delay-2 mt-10 flex flex-wrap justify-center gap-x-8 gap-y-3 border-t border-on-surface/5 pt-8 text-sm">
          <a href="/servicios" class="text-on-surface/60 transition-colors hover:text-primary">Servicios</a>
          <a href="/sobre-nosotros" class="text-on-surface/60 transition-colors hover:text-primary">Sobre nosotros</a>
          <a href="/blog" class="text-on-surface/60 transition-colors hover:text-primary">Blog</a>
          <a href="/contacto" class="text-on-surface/60 transition-colors hover:text-primary">Contacto</a>
        </div>
      </div>
    </section>
  </div>

  <script id="banco-diagnostico" type="application/json" set:html={JSON.stringify(banco)} />

  <script>
    import { medir } from '../config/analytics';

    const banco = JSON.parse(document.getElementById('banco-diagnostico').textContent);
    const $ = (id) => document.getElementById(id);
    const pasos = ['intro', 'ramal', 'pregunta', 'abierta', 'datos', 'resultado'];

    const mostrar = (nombre) => {
      pasos.forEach((p) => $(`paso-${p}`).classList.toggle('hidden', p !== nombre));
      // La landing solo existe para el que todavía no empezó. Con el cuestionario
      // abierto, todo lo que no sea la pregunta es una salida.
      $('landing-extra').classList.toggle('hidden', nombre !== 'intro');
      // El intro llena la pantalla solo; el cuestionario es corto y centrado se
      // ve mejor. Va por clase propia y no por utilidad de Tailwind: una clase
      // que solo existe en el JS no sobrevive a la purga del CSS.
      $('lienzo').classList.toggle('paso-centrado', nombre !== 'intro');
      $('barra').classList.toggle('hidden', nombre === 'intro' || nombre === 'resultado');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    const escapar = (s) =>
      String(s ?? '').replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]
      );

    const estado = { ramal: null, cola: [], indice: 0, respuestas: [], abierta: '' };

    /*
      Modos de prueba, ninguno enlazado en el sitio:
        ?sinia=1 — recorre el cuestionario completo de verdad, pero al final usa
                   un análisis de muestra en vez de llamar a Claude. Sirve para
                   revisar preguntas, flujo y PDF sin gastar un peso en tokens.
        ?demo=1  — salta directo al resultado. Solo para iterar el diseño del PDF.
    */
    const parametros = new URLSearchParams(location.search);
    const SIN_IA = parametros.get('sinia') === '1';

    $('btn-empezar-pie').addEventListener('click', () => $('btn-empezar').click());

    $('btn-empezar').addEventListener('click', () => {
      actualizarBarra('Contexto', 0);
      mostrar('ramal');
    });

    document.querySelectorAll('.opcion-ramal').forEach((b) => {
      b.addEventListener('click', () => {
        estado.ramal = banco.ramales.find((r) => r.id === b.dataset.ramal);
        // Tronco primero (es la parte comparable), después el ramal elegido.
        estado.cola = [
          ...banco.tronco.map((p) => ({ ...p, bloque: 'tronco' })),
          ...estado.ramal.preguntas.map((p) => ({ ...p, bloque: 'ramal' })),
        ];
        estado.indice = 0;
        estado.respuestas = [];
        pintarPregunta();
      });
    });

    function actualizarBarra(etapa, respondidas) {
      $('barra-etapa').textContent = etapa;
      $('barra-conteo').textContent = `${Math.min(respondidas + 1, banco.total)} / ${banco.total}`;
      $('barra-avance').style.width = `${(respondidas / banco.total) * 100}%`;
    }

    function pintarPregunta() {
      const p = estado.cola[estado.indice];
      actualizarBarra(p.bloque === 'tronco' ? 'Su operación' : estado.ramal.dolor, estado.indice);
      $('pregunta-texto').textContent = p.texto;

      const cont = $('pregunta-opciones');
      cont.innerHTML = '';
      p.opciones.forEach((o) => {
        const btn = document.createElement('button');
        // Misma clase que el selector de dolor: sin fondo propio las tarjetas
        // desaparecían contra el tinte de la página.
        btn.className = 'opcion-ramal p-4 text-left';
        btn.textContent = o.texto;
        btn.addEventListener('click', () => responder(p, o));
        cont.appendChild(btn);
      });

      $('btn-volver').classList.toggle('hidden', estado.indice === 0);
      mostrar('pregunta');
    }

    function responder(pregunta, opcion) {
      const max = Math.max(...pregunta.opciones.map((o) => o.puntos));
      estado.respuestas[estado.indice] = {
        bloque: pregunta.bloque,
        id: pregunta.id,
        dimension: pregunta.dimension || null,
        pregunta: pregunta.texto,
        respuesta: opcion.texto,
        puntos: opcion.puntos,
        max,
        horasMes: opcion.horasMes || null,
      };
      estado.indice += 1;
      if (estado.indice < estado.cola.length) {
        pintarPregunta();
      } else {
        actualizarBarra('Última', estado.cola.length);
        mostrar('abierta');
      }
    }

    $('btn-volver').addEventListener('click', () => {
      if (estado.indice > 0) {
        estado.indice -= 1;
        pintarPregunta();
      }
    });

    $('btn-abierta').addEventListener('click', () => {
      estado.abierta = $('campo-abierta').value.trim();
      actualizarBarra('Sus datos', banco.total);
      mostrar('datos');
    });

    const puntajeDe = (bloque) => {
      const items = estado.respuestas.filter((r) => r.bloque === bloque);
      const max = items.reduce((s, r) => s + r.max, 0);
      return max ? Math.round((items.reduce((s, r) => s + r.puntos, 0) / max) * 100) : 0;
    };

    // Puntaje por dimensión: son las barras. Salen de las 6 del tronco.
    const dimensiones = () =>
      estado.respuestas
        .filter((r) => r.dimension)
        .map((r) => ({ etiqueta: r.dimension, valor: Math.round((r.puntos / r.max) * 100) }));

    const tramoDe = (p) => banco.tramos.find((t) => p <= t.hasta) ?? banco.tramos.at(-1);

    const hoyLargo = () =>
      new Date().toLocaleDateString('es-CL', { day: 'numeric', month: 'long', year: 'numeric' });

    $('form-datos').addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const datos = Object.fromEntries(new FormData(ev.target));
      const error = $('error-datos');
      error.classList.add('hidden');

      const barras = dimensiones();
      const cuerpo = {
        nombre: datos.nombre,
        empresa: datos.empresa,
        email: datos.email,
        telefono: datos.telefono,
        botcheck: datos.botcheck,
        ramal: { id: estado.ramal.id, dolor: estado.ramal.dolor, servicio: estado.ramal.servicio },
        puntaje: { tronco: puntajeDe('tronco') },
        dimensiones: Object.fromEntries(barras.map((d) => [d.etiqueta, d.valor])),
        respuestas: estado.respuestas,
        abierta: estado.abierta,
      };

      // El puntaje ya está calculado: se pinta al instante y el análisis llega
      // transmitido debajo. Así no hay espera muerta mirando un spinner.
      pintarPortada(cuerpo);
      pintarEncabezado(cuerpo, barras);
      avanceIniciar();
      mostrar('resultado');

      if (SIN_IA) return transmitirMuestra();

      try {
        const res = await fetch('/api/diagnostico', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(cuerpo),
        });
        if (!res.ok) {
          const detalle = await res.json().catch(() => ({}));
          throw new Error(detalle.error || 'No pudimos generar el análisis.');
        }
        await transmitir(res);

        // LA conversión. Va acá y no antes: recién en este punto el informe se
        // pidió, llegó completo y el visitante lo tiene en pantalla. Si el
        // fetch falla o la transmisión se corta, el catch de abajo se lleva el
        // control y no se cuenta nada. El modo de muestra (SIN_IA) tampoco pasa
        // por acá, que es justo lo que corresponde: ese informe no es real.
        medir('diagnostico_completado', {
          ramal: cuerpo.ramal.id,
          servicio: cuerpo.ramal.servicio,
          puntaje: cuerpo.puntaje.tronco,
        });
      } catch (err) {
        // Si ya había informe en pantalla, devolverlo al formulario sería borrarle
        // algo que es suyo y que además es correcto: el puntaje y las barras los
        // calcula el front, y el servidor guarda el lead y despacha los correos
        // ANTES de cerrar la respuesta. Se avisa sin quitarle nada.
        if (avance.recibido > 0) {
          avanceFallo();
          return;
        }
        mostrar('datos');
        error.textContent = `${err.message} Puede reintentar o escribirnos a contacto@buffoconsulting.cl.`;
        error.classList.remove('hidden');
      }
    });

    // --- Portada, membrete y pie: solo existen en el PDF ---

    function pintarPortada(cuerpo) {
      const tramo = tramoDe(cuerpo.puntaje.tronco);
      const cliente = cuerpo.empresa || cuerpo.nombre;
      estado.datosCliente = cliente;

      $('portada-pdf').innerHTML = `
        <img src="/logo-firma.png" alt="Buffo IA Consulting" class="portada-logo" />
        <div class="portada-centro">
          <p class="eyebrow">Diagnóstico de operación</p>
          <p class="wordmark">Buffo<span class="verde"> IA</span></p>
          <p class="wordmark-cliente"><span class="por">×</span> ${escapar(cliente)}</p>
          <div class="portada-puntaje">
            <div>
              <p class="cifra">${cuerpo.puntaje.tronco}<span class="de">/100</span></p>
              <p class="cifra-rotulo">Visibilidad de su operación</p>
            </div>
            <div class="portada-tramo">
              <p class="tramo-etiqueta">${escapar(tramo.etiqueta)}</p>
              <p class="tramo-resumen">${escapar(tramo.resumen)}</p>
            </div>
          </div>
        </div>
        <div class="portada-pie">
          <span>Preparado para ${escapar(cuerpo.nombre)}</span>
          <span>${hoyLargo()}</span>
        </div>`;

      $('membrete').innerHTML = `
        <span class="membrete-marca">Buffo<span class="verde"> IA</span> · Diagnóstico</span>
        <span>${escapar(cliente)} · ${hoyLargo()}</span>`;

      $('pie-impreso').innerHTML = `
        <p><strong>Buffo IA Consulting</strong> · buffoconsulting.cl · contacto@buffoconsulting.cl</p>
        <p>Este informe se elaboró a partir de doce respuestas. Para agendar treinta minutos sin
        costo: ${escapar(banco.calendly)}</p>`;
    }

    function pintarEncabezado(cuerpo, barras) {
      const tramo = tramoDe(cuerpo.puntaje.tronco);
      $('resultado-encabezado').innerHTML = `
        <div class="no-imprimir">
          <p class="text-sm uppercase tracking-widest text-primary">Diagnóstico</p>
          <h2 class="mt-3 font-display text-3xl leading-tight sm:text-4xl">${escapar(cuerpo.empresa || cuerpo.nombre)}</h2>
          <div class="mt-10 flex flex-wrap items-end gap-x-10 gap-y-4 border-y border-outline-variant py-6">
            <div>
              <p class="font-display text-5xl text-primary">${cuerpo.puntaje.tronco}</p>
              <p class="mt-1 text-sm text-on-surface-variant">de 100 en visibilidad</p>
            </div>
            <div>
              <p class="text-lg font-medium">${escapar(tramo.etiqueta)}</p>
              <p class="mt-1 max-w-md text-sm text-on-surface-variant">${escapar(tramo.resumen)}</p>
            </div>
          </div>
        </div>

        <section class="mt-10 bloque">
          <h3 class="rotulo">Dónde está parado</h3>
          <div class="mt-5 grid gap-3">
            ${barras
              .map(
                (d) => `
              <div class="fila-barra grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-1 sm:grid-cols-[13rem_1fr_2.5rem]">
                <span class="text-sm text-on-surface-variant">${escapar(d.etiqueta)}</span>
                <div class="order-3 h-1.5 w-full bg-surface-container sm:order-none">
                  <div class="h-1.5 bg-primary transition-all duration-700" style="width:${d.valor}%"></div>
                </div>
                <span class="text-right text-sm tabular-nums ${d.valor < 50 ? 'text-error' : 'text-on-surface-variant'}">${d.valor}</span>
              </div>`
              )
              .join('')}
          </div>
        </section>`;
    }

    // --- Transmisión ---

    // Modo sin IA: reproduce un análisis de muestra imitando la escritura en vivo,
    // para que el flujo se sienta igual sin llamar a la API. Deja un aviso visible
    // arriba, porque el texto NO corresponde a las respuestas que acaba de dar.
    async function transmitirMuestra() {
      const muestra = `/_demo-${estado.ramal?.id || 'visibilidad'}.txt`;
      const texto = await fetch(muestra).then((r) => r.text());
      const trozo = Math.ceil(texto.length / 60);

      for (let i = trozo; i < texto.length; i += trozo) {
        pintarAnalisis(texto.slice(0, i), true);
        avanceActualizar(texto.slice(0, i));
        await new Promise((r) => setTimeout(r, 40));
      }
      pintarAnalisis(texto, false);
      avanceTerminar();

      $('resultado-analisis').insertAdjacentHTML(
        'afterbegin',
        `<p class="no-imprimir mt-8 border border-error/50 bg-error/5 p-4 text-sm text-error">
           Modo sin IA: el análisis de abajo es una muestra del ramal
           &laquo;${escapar(estado.ramal?.dolor || '')}&raquo; y <strong>no corresponde a las respuestas
           que acaba de dar</strong>. El puntaje, las barras y el cuadro de costo sí son suyos.
         </p>`
      );
      $('teaser-pdf').classList.remove('hidden');
      $('resultado-cierre').classList.remove('hidden');
    }

    // --- Señal de avance ---

    // Once bloques "### ": titulares, resumen, tres hallazgos, horas, vistazo,
    // atencion, limites, propuesta y pasos. Si el prompt de api/diagnostico.js
    // cambia de secciones, este número se corrige acá.
    const BLOQUES_ESPERADOS = 11;
    // Largo del informe real medido el 27-ago-2026 (5.935 caracteres). Sirve para
    // que la barra avance de forma continua mientras el texto llega, en vez de
    // saltar solo once veces. Es una referencia, no una promesa: por eso la barra
    // se topa en 97% y solo la llega a 100 el final de verdad.
    const LARGO_TIPICO = 5900;

    const avance = { pct: 0, recibido: 0, seccion: '', hechos: 0 };

    function avanceIniciar() {
      avance.pct = 0;
      avance.recibido = 0;
      avance.seccion = '';
      avance.hechos = 0;
      const panel = $('avance-informe');
      panel.classList.remove('hidden', 'avance-listo', 'avance-roto');
      panel.classList.add('avance-vivo');
      $('avance-barra').style.width = '2%';
      $('avance-detalle').textContent = 'Preparando su informe…';
    }

    function avanceActualizar(texto) {
      avance.recibido = texto.length;

      // La barra nunca retrocede: un texto que se reescribe no puede leerse como
      // que el trabajo se deshizo.
      const estimado = Math.round((texto.length / LARGO_TIPICO) * 100);
      avance.pct = Math.min(97, Math.max(avance.pct, estimado));
      $('avance-barra').style.width = `${Math.max(2, avance.pct)}%`;
      $('avance-barra-pista').setAttribute('aria-valuenow', String(avance.pct));

      const marcadores = texto.match(/^### +(\w+)/gm) || [];
      if (!marcadores.length) return;

      const actual = marcadores[marcadores.length - 1].replace(/^### +/, '');
      const hechos = Math.min(marcadores.length, BLOQUES_ESPERADOS);
      if (actual === avance.seccion && hechos === avance.hechos) return;
      avance.seccion = actual;
      avance.hechos = hechos;

      // Decir QUÉ se está escribiendo es lo que convierte la espera en algo que
      // se ve avanzar. Y de paso cuenta lo que trae el informe, que es contenido
      // que en pantalla no se muestra nunca.
      const rotulo = ROTULOS[actual] || actual;
      $('avance-detalle').textContent = `Escribiendo: ${rotulo} · ${hechos} de ${BLOQUES_ESPERADOS}`;
    }

    function avanceTerminar() {
      const panel = $('avance-informe');
      panel.classList.remove('avance-vivo', 'avance-roto');
      panel.classList.add('avance-listo');
      $('avance-barra').style.width = '100%';
      $('avance-barra-pista').setAttribute('aria-valuenow', '100');
      $('avance-detalle').textContent = 'Informe completo.';
    }

    function avanceFallo() {
      const panel = $('avance-informe');
      panel.classList.remove('avance-vivo', 'avance-listo');
      panel.classList.add('avance-roto');
      $('avance-detalle').textContent =
        'La conexión se cortó antes de terminar. Lo que ve arriba es suyo y es correcto; ' +
        'el informe completo va camino a su correo. Si no llega en unos minutos, escríbanos a ' +
        'contacto@buffoconsulting.cl.';
    }

    async function transmitir(res) {
      const lector = res.body.getReader();
      const decodificador = new TextDecoder();
      let texto = '';

      while (true) {
        const { done, value } = await lector.read();
        if (done) break;
        texto += decodificador.decode(value, { stream: true });
        if (texto.startsWith('__ERROR__')) throw new Error(texto.replace('__ERROR__', ''));
        pintarAnalisis(texto, true);
        avanceActualizar(texto);
      }

      pintarAnalisis(texto, false);
      avanceTerminar();
      $('teaser-pdf').classList.remove('hidden');
      $('resultado-cierre').classList.remove('hidden');
    }

    const ROTULOS = {
      titulares: 'Lo que salta a la vista',
      resumen: 'Resumen',
      hallazgo: 'Lo que detectamos',
      horas: 'Lo que cuesta el trabajo repetitivo',
      vistazo: 'Cómo se vería su información',
      propuesta: 'Lo que proponemos',
      atencion: 'Lo que más nos llama la atención',
      limites: 'Lo que no podemos decirle sin conocerlos mejor',
      pasos: 'Próximos pasos',
    };

    function pintarAnalisis(texto, enCurso) {
      const bloques = texto.split(/^### /m).filter((s) => s.trim());
      let html = '';
      let nHallazgo = 0;
      let hallazgosAbiertos = false;

      const cerrarHallazgos = () => {
        if (hallazgosAbiertos) {
          html += '</div></section>';
          hallazgosAbiertos = false;
        }
      };

      bloques.forEach((bloque) => {
        const salto = bloque.indexOf('\n');
        const nombre = (salto === -1 ? bloque : bloque.slice(0, salto)).trim();
        const contenido = salto === -1 ? '' : bloque.slice(salto + 1).trim();
        if (!contenido) return;

        if (nombre === 'hallazgo') {
          // Un mismo bloque puede traer varios hallazgos seguidos: se separa por
          // cada "titulo:" en vez de depender de que el modelo repita el marcador.
          const cuerpos = contenido
            .split(/^(?=titulo:)/mi)
            .map((c) => pintarHallazgo(c))
            .filter(Boolean);
          if (!cuerpos.length) return;

          if (!hallazgosAbiertos) {
            html += `<section class="mt-12 bloque-largo solo-imprimir"><h3 class="rotulo">${ROTULOS.hallazgo}</h3><div class="mt-4">`;
            hallazgosAbiertos = true;
          }
          cuerpos.forEach((c) => {
            nHallazgo += 1;
            html += c;
          });
          return;
        }

        cerrarHallazgos();

        // En pantalla solo los titulares. Todo lo demás existe pero solo se
        // imprime: el PDF es el entregable, la pantalla es el anzuelo.
        const enPantalla = nombre === 'titulares';
        const clase = enPantalla ? 'bloque' : 'bloque solo-imprimir';

        if (nombre === 'titulares') {
          html += `<section class="mt-10 ${clase}">${pintarTitulares(contenido)}</section>`;
          return;
        }
        if (nombre === 'vistazo') {
          html += `<section class="mt-12 ${clase}">${pintarVistazo(contenido)}</section>`;
          return;
        }
        if (nombre === 'propuesta') {
          html += `<section class="mt-12 ${clase}">${pintarPropuesta(contenido)}</section>`;
          return;
        }
        if (nombre === 'pasos') {
          html += `<section class="mt-12 ${clase}">${pintarPasos(contenido)}</section>`;
          return;
        }

        const destacado = nombre === 'atencion';
        // Al párrafo de horas se le cuelga el cuadro de plata, que lo calcula el
        // código sobre el rango que él declaró — no el modelo.
        const extra = nombre === 'horas' ? pintarCosto() : '';
        html += `
          <section class="mt-12 ${clase}">
            <h3 class="rotulo">${ROTULOS[nombre] || escapar(nombre)}</h3>
            <div class="mt-4 ${destacado ? 'destacado border border-primary/40 bg-primary/5 p-5' : ''} leading-relaxed ${destacado ? '' : 'text-on-surface-variant'}">${escapar(contenido).replace(/\n/g, '<br>')}</div>
            ${extra}
          </section>`;
      });

      cerrarHallazgos();
      if (enCurso) html += '<span class="ml-1 inline-block h-4 w-2 animate-pulse bg-primary align-middle"></span>';
      $('resultado-analisis').innerHTML = html;
    }

    function pintarHallazgo(contenido) {
      const campo = (clave) => {
        const m = contenido.match(new RegExp(`^${clave}:\\s*(.+)$`, 'mi'));
        return m ? m[1].trim() : '';
      };
      const titulo = campo('titulo');
      // Mientras el bloque se está escribiendo puede no haber título todavía.
      if (!titulo) return '';

      const fila = (rotulo, valor) =>
        valor
          ? `<p class="mt-1 text-sm text-on-surface-variant"><span class="text-outline">${rotulo}:</span> ${escapar(valor)}</p>`
          : '';

      return `
        <div class="hallazgo border-l border-outline-variant pl-5 [&:not(:first-child)]:mt-8">
          <p class="font-medium">${escapar(titulo)}</p>
          ${fila('Lo que vemos', campo('vemos'))}
          ${fila('Cómo se resuelve', campo('resolvemos'))}
          ${fila('Qué gana', campo('beneficio'))}
        </div>`;
    }

    const pesos = (n) => '$' + Math.round(n).toLocaleString('es-CL');

    /*
      Cuadro de costo. La aritmética la hace el código, no el modelo: horas
      declaradas x 12 x valor hora del sueldo mínimo. Se usa el mínimo porque es
      el piso indiscutible — quien consolida planillas casi siempre gana más — y
      el cuadro lo dice, para que la cifra no se pueda discutir.
    */
    function pintarCosto() {
      const r = estado.respuestas.find((x) => x.horasMes);
      if (!r) return '';

      const [minMes, maxMes] = r.horasMes;
      const vh = banco.costo.valorHora;
      const minAno = minMes * 12;
      const maxAno = maxMes * 12;

      // Un mes de jornada completa son ~182 horas: sirve para expresar el total
      // anual en meses de una persona, que es la unidad que de verdad se entiende.
      const horasMesJornada = banco.costo.horasSemana * 4.333;
      const mesesMin = minAno / horasMesJornada;
      const mesesMax = maxAno / horasMesJornada;
      const cifra = (n) => n.toFixed(1).replace('.', ',').replace(',0', '');

      return `
        <div class="costo mt-6">
          <p class="costo-titulo">Lo que cuesta ese tiempo en un año</p>
          <p class="costo-cifra">${pesos(minAno * vh)} <span class="a">a</span> ${pesos(maxAno * vh)}</p>

          <div class="cifras">
            <div class="cifra-tarjeta">
              <p class="cifra-valor">${minMes} a ${maxMes}</p>
              <p class="cifra-etiqueta">horas al mes en trabajo repetitivo, según su respuesta</p>
            </div>
            <div class="cifra-tarjeta">
              <p class="cifra-valor">${minAno} a ${maxAno}</p>
              <p class="cifra-etiqueta">horas al año, multiplicando por los doce meses</p>
            </div>
            <div class="cifra-tarjeta">
              <p class="cifra-valor">${cifra(mesesMin)} a ${cifra(mesesMax)}</p>
              <p class="cifra-etiqueta">meses completos de una persona, dedicados a rehacer lo que ya existe</p>
            </div>
          </div>

          <p class="costo-remate">
            Y esta es la parte barata del problema: es lo único que se puede contar con doce
            respuestas. Lo caro son las decisiones que se toman con información que llega tarde
            — el precio que se movió mal, el cliente que se fue sin que nadie lo notara, la compra
            que se hizo sobre un dato equivocado. Eso no aparece en ninguna planilla de horas.
          </p>
          <div class="supuestos">
            <p class="mini-rotulo">Supuestos del cálculo</p>
            <div class="supuestos-filas">
              <span>Sueldo base del trabajo<b>${pesos(banco.costo.sueldoBase)}</b></span>
              <span>Leyes sociales<b>+${Math.round((banco.costo.leyesSociales - 1) * 100)}%</b></span>
              <span>Jornada legal<b>${banco.costo.horasSemana} h semanales</b></span>
              <span>Costo por hora<b>${pesos(banco.costo.valorHora)}</b></span>
            </div>
            <p class="supuestos-nota">
              Conservador: este trabajo lo suele hacer alguien que gana más. Si su caso es otro,
              el cálculo se rehace con su cifra en la reunión.
            </p>
          </div>
        </div>`;
    }

    /*
      La maqueta. Antes eran cajas vacías y no mostraba nada: ahora se dibuja un
      tablero de verdad, con un tipo de visualización distinto por tarjeta. Los
      números son de muestra y el sello lo dice — el punto es que vea la forma.
    */
    const CHISPA = '4,22 14,17 24,19 34,12 44,14 54,8 64,10 74,4';

    function pintarVistazo(contenido) {
      const lineas = contenido.split('\n').map((l) => l.trim()).filter(Boolean);
      const intro = lineas.filter((l) => !l.toLowerCase().startsWith('tarjeta:')).join(' ');
      const tarjetas = lineas
        .filter((l) => l.toLowerCase().startsWith('tarjeta:'))
        .map((l) => l.replace(/^tarjeta:\s*/i, '').split('::').map((x) => x.trim()));

      if (!tarjetas.length) return '';

      // Un tipo de visualización por posición, para que parezca un tablero y no
      // cuatro cajas iguales.
      const visual = [
        // 1. Cifra grande con variación y curva
        `<div class="t-cifra">
           <span class="valor">$4.280.500</span>
           <span class="chip sube">+12%</span>
         </div>
         <svg class="chispa" viewBox="0 0 78 26" preserveAspectRatio="none">
           <polyline points="${CHISPA}" />
         </svg>`,
        // 2. Avance con barra de progreso
        `<div class="t-avance">
           <span class="valor">63<span class="pct">%</span></span>
           <span class="sub">día 12 de 30</span>
         </div>
         <div class="progreso"><div style="width:63%"></div></div>`,
        // 3. Ranking de tres filas
        `<div class="t-lista">
           ${[82, 54, 31]
             .map(
               (v) => `<div class="fila">
                 <span class="etiq"></span>
                 <div class="mini"><div style="width:${v}%" class="${v < 60 ? 'bajo' : ''}"></div></div>
                 <span class="num">${v}%</span>
               </div>`
             )
             .join('')}
         </div>`,
        // 4. Alertas
        `<div class="t-alertas">
           ${['alta', 'alta', 'media']
             .map(
               (n) => `<div class="alerta"><span class="punto ${n}"></span><span class="etiq"></span></div>`
             )
             .join('')}
         </div>`,
      ];

      return `
        <h3 class="rotulo">${ROTULOS.vistazo}</h3>
        ${intro ? `<p class="mt-4 leading-relaxed text-on-surface-variant">${escapar(intro)}</p>` : ''}
        <div class="maqueta mt-6">
          <div class="maqueta-barra">
            <span></span><span></span><span></span>
            <span class="sello">Datos de ejemplo</span>
          </div>
          <div class="maqueta-grilla">
            ${tarjetas
              .slice(0, 4)
              .map(
                ([nombre, detalle], i) => `
              <div class="maqueta-tarjeta">
                <p class="maqueta-nombre">${escapar(nombre)}</p>
                <div class="maqueta-visual">${visual[i % visual.length]}</div>
                <p class="maqueta-detalle">${escapar(detalle || '')}</p>
              </div>`
              )
              .join('')}
          </div>
        </div>
        <p class="maqueta-nota">
          Ejemplo de la estructura, con datos de muestra. Los indicadores son los suyos; los valores
          salen de sus sistemas.
        </p>`;
    }

    /*
      La propuesta. El párrafo del "por qué" lo escribe el modelo; los entregables,
      lo que incluye siempre y los plazos salen de la configuración del sitio —
      son compromiso comercial y no pueden variar por prospecto. Sin precios: se
      conversan en la reunión.
    */
    // Los titulares: lo único que se ve en pantalla. Cada línea es una frase
    // que cita una respuesta suya.
    function pintarTitulares(contenido) {
      const lineas = contenido
        .split('\n')
        .map((l) => l.replace(/^[-•*]\s*/, '').trim())
        .filter(Boolean)
        .slice(0, 5);
      if (!lineas.length) return '';

      return `
        <h3 class="rotulo">${ROTULOS.titulares}</h3>
        <ul class="titulares mt-5">
          ${lineas.map((l) => `<li>${escapar(l)}</li>`).join('')}
        </ul>`;
    }

    function pintarPropuesta(contenido) {
      const servicio = estado.ramal?.servicio;
      const ficha = banco.propuesta[servicio];
      if (!ficha) return '';

      return `
        <h3 class="rotulo">${ROTULOS.propuesta}</h3>
        <p class="propuesta-titular">${escapar(ficha.titular)}</p>
        <p class="mt-3 leading-relaxed text-on-surface-variant">${escapar(contenido).replace(/\n/g, '<br>')}</p>

        <div class="propuesta-caja">
          <div class="propuesta-cols">
            <div>
              <p class="mini-rotulo">Qué le entregamos</p>
              <ul class="lista-check">
                ${ficha.entregables.map((e) => `<li>${escapar(e)}</li>`).join('')}
              </ul>
            </div>
            <div>
              <p class="mini-rotulo">Incluido siempre</p>
              <ul class="lista-check">
                ${banco.incluye.map((e) => `<li>${escapar(e)}</li>`).join('')}
              </ul>
            </div>
          </div>

          <p class="mini-rotulo mt-6">Cómo se implementa</p>
          <div class="fases">
            ${banco.fases
              .map(
                (f) => `
              <div class="fase">
                <p class="fase-plazo">${escapar(f.plazo)}</p>
                <p class="fase-que">${escapar(f.que)}</p>
                <p class="fase-detalle">${escapar(f.detalle)}</p>
              </div>`
              )
              .join('')}
          </div>

          <div class="stack">
            <p class="mini-rotulo">Herramientas que usamos</p>
            <div class="stack-logos">
              ${banco.stack.map((h) => `<span><span class="marca">${h.svg}</span>${h.nombre}</span>`).join('')}
            </div>
            <p class="stack-nota">
              Infraestructura de nivel mundial, operada por nosotros. Usted no administra
              servidores ni licencias.
            </p>
          </div>
        </div>`;
    }

    function pintarPasos(contenido) {
      const pasos = contenido
        .split('\n')
        .map((l) => l.trim())
        .filter((l) => l.toLowerCase().startsWith('paso:'))
        .map((l) => l.replace(/^paso:\s*/i, '').split('::').map((x) => x.trim()));

      if (!pasos.length) return '';

      return `
        <h3 class="rotulo">${ROTULOS.pasos}</h3>
        <ol class="pasos mt-5">
          ${pasos
            .map(
              ([que, resultado], i) => `
            <li>
              <span class="paso-n">${i + 1}</span>
              <div>
                <p class="paso-que">${escapar(que)}</p>
                ${resultado ? `<p class="paso-resultado">${escapar(resultado)}</p>` : ''}
              </div>
            </li>`
            )
            .join('')}
        </ol>
        <a class="boton-agendar" href="${banco.calendly}">Agendar los 30 minutos &rarr;</a>`;
    }

    // El navegador imprime el <title> en su cabecera. Si el usuario dejó esa
    // casilla activada, al menos que se lea como documento y no como pestaña.
    $('btn-pdf').addEventListener('click', () => {
      const titulo = document.title;
      document.title = `Diagnóstico — ${estado.datosCliente || 'Buffo IA Consulting'}`;
      window.print();
      setTimeout(() => { document.title = titulo; }, 500);
    });

    // Modo demo (?demo=1): pinta el resultado con una muestra guardada, sin pasar
    // por el cuestionario ni llamar a la API. Existe para poder revisar el diseño
    // del PDF sin gastar tokens en cada iteración. No está enlazado en ninguna parte.
    if (parametros.has('demo')) {
      const cual = parametros.get('demo');
      const ramalDemo = banco.ramales.find((r) => r.id === cual) || banco.ramales[0];
      // Los mismos casos con los que se generaron las muestras, para que la
      // portada no muestre un contacto ni un puntaje que no calzan con el texto.
      const CASOS_DEMO = {
        visibilidad: { empresa: 'Distribuidora Andes', nombre: 'Rodrigo Salas', puntaje: 17, horas: [60, 150] },
        datos: { empresa: 'Maestranza Pacífico', nombre: 'Carolina Vidal', puntaje: 33, horas: [20, 60] },
        procesos: { empresa: 'Servicios Altamira', nombre: 'Felipe Cortés', puntaje: 44, horas: [60, 150] },
        vigilancia: { empresa: 'Comercial Los Robles', nombre: 'Andrés Peña', puntaje: 83, horas: [5, 20] },
      };
      const caso = CASOS_DEMO[ramalDemo.id];
      // El cuadro de costo se calcula desde la respuesta de horas: hay que
      // sembrarla con las mismas del caso o el texto y el cuadro se contradicen.
      estado.respuestas = [{ bloque: 'tronco', horasMes: caso.horas }];
      const ejemplo = {
        nombre: caso.nombre,
        empresa: caso.empresa,
        puntaje: { tronco: caso.puntaje },
      };
      const barras = [
        { etiqueta: 'Rapidez del dato', valor: 0 },
        { etiqueta: 'Origen del dato', valor: 33 },
        { etiqueta: 'Fuentes dispersas', valor: 33 },
        { etiqueta: 'Dependencia de personas', valor: 0 },
        { etiqueta: 'Confiabilidad', valor: 0 },
        { etiqueta: 'Trabajo manual', valor: 33 },
      ];
      // El cuadro de costo se calcula desde la respuesta de horas, así que hay
      // que sembrarla o el bloque no aparece.
      // El mismo rango con el que se generaron las muestras, para que el texto
      // y el cuadro de costo no se contradigan.
      estado.respuestas = [{ bloque: 'tronco', horasMes: caso.horas }];
      estado.ramal = ramalDemo;
      pintarPortada(ejemplo);
      pintarEncabezado(ejemplo, barras);
      mostrar('resultado');
      fetch(`/_demo-${ramalDemo.id}.txt`)
        .then((r) => r.text())
        .then((t) => {
          pintarAnalisis(t, false);
          $('teaser-pdf').classList.remove('hidden');
          $('resultado-cierre').classList.remove('hidden');
        });
    }
  </script>

  <style is:global>
    /* Centra el bloque en la pantalla. Lo lleva el cuestionario, no el intro:
       el intro ya trae contenido de sobra y centrarlo dejaba un tercio de
       pantalla en blanco arriba y otro abajo. */
    .paso-centrado {
      align-items: center;
      min-height: calc(100vh - 4rem);
    }

    /* --- Señal de avance de la transmisión --- */

    /* Encabeza el resultado, así que su tamaño tiene que ser estable: cualquier
       crecimiento empuja hacia abajo todo lo que la persona está leyendo. */
    #avance-informe {
      margin-bottom: 2.25rem;
    }

    #avance-barra-pista {
      height: 3px;
      background: rgb(var(--c-on-surface) / 0.09);
      overflow: hidden;
    }

    #avance-barra {
      height: 100%;
      width: 2%;
      background: rgb(var(--c-primary));
      transition: width 0.45s ease-out;
    }

    /* Mientras transmite, la barra respira. Entre sección y sección el ancho casi
       no cambia, y sin esto un tramo lento se lee igual que un cuelgue. */
    .avance-vivo #avance-barra {
      background-image: linear-gradient(
        90deg,
        rgb(var(--c-primary)) 0%,
        rgb(var(--c-primary) / 0.55) 50%,
        rgb(var(--c-primary)) 100%
      );
      background-size: 200% 100%;
      animation: avanceLatido 1.4s linear infinite;
    }

    @keyframes avanceLatido {
      from { background-position: 200% 0; }
      to { background-position: 0 0; }
    }

    #avance-detalle {
      margin-top: 0.6rem;
      font-size: 0.8125rem;
      line-height: 1.45;
      min-height: 1.45em;
      color: rgb(var(--c-on-surface) / 0.55);
      /* Una línea siempre. En 390 px un rótulo como "Lo que no podemos decirle
         sin conocerlos mejor" ocuparía tres, y el salto de alto en cada sección
         se vería como que la página se mueve sola. */
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .avance-listo #avance-detalle {
      color: rgb(var(--c-primary));
    }

    .avance-roto #avance-barra {
      background: rgb(var(--c-error, 239 68 68));
      animation: none;
    }

    /* El aviso de corte sí puede ocupar lo que necesite: es un estado terminal y
       hay que poder leerlo entero. Ya no hay transmisión que interrumpir. */
    .avance-roto #avance-detalle {
      white-space: normal;
      color: rgb(var(--c-error, 239 68 68));
    }

    @media (prefers-reduced-motion: reduce) {
      #avance-barra {
        transition: none;
      }
      .avance-vivo #avance-barra {
        animation: none;
        background-image: none;
      }
    }

    /* Los titulares son lo único que se lee en pantalla: tipografía grande y
       aire, para que se puedan barrer en cinco segundos. */
    .titulares { list-style: none; padding: 0; margin: 0; }
    .titulares li {
      position: relative;
      padding-left: 1.6rem;
      margin-bottom: 1rem;
      font-size: 1.0625rem;
      line-height: 1.6;
    }
    .titulares li::before {
      content: '';
      position: absolute;
      left: 0;
      top: .68em;
      width: .7rem;
      height: 1px;
      background: rgb(var(--c-primary));
    }

    /* Tarjeta de opción. Antes era solo un borde sin fondo, así que sobre el
       tinte de la página se perdía. Ahora tiene cuerpo blanco y sombra: se lee
       como algo que se puede tomar, no como una línea dibujada. */
    .opcion-ramal {
      background-color: rgb(var(--c-surface));
      border: 1px solid rgb(var(--c-hairline) / 0.1);
      border-radius: 14px;
      box-shadow: var(--elev);
      transition: transform .18s ease, box-shadow .25s ease, border-color .2s ease;
    }
    .opcion-ramal:hover {
      border-color: rgb(var(--c-primary) / 0.55);
      box-shadow: var(--elev-hover);
      transform: translateY(-2px);
    }
    /* Foco visible para quien navega con teclado: el hover solo no basta. */
    .opcion-ramal:focus-visible {
      outline: 2px solid rgb(var(--c-primary));
      outline-offset: 3px;
    }
    @media (prefers-reduced-motion: reduce) {
      .opcion-ramal, .opcion-ramal:hover { transform: none; transition: none; }
    }

    /* Etiqueta del frente de trabajo en el selector de dolor. Mono y en gris
       para que el ojo lea primero el dolor; se enciende al pasar por encima. */
    .etiqueta-frente {
      font-family: 'IBM Plex Mono', monospace;
      font-size: .68rem;
      letter-spacing: .12em;
      text-transform: uppercase;
      /* Estos dos eran #8E9099 y #44474E, de la paleta oscura vieja: sobre el
         tema claro el borde quedaba casi negro. Ahora siguen el tema. */
      color: rgb(var(--c-on-surface) / 0.5);
      border: 1px solid rgb(var(--c-hairline) / 0.14);
      padding: .3rem .6rem;
      white-space: nowrap;
      transition: color .2s, border-color .2s;
    }
    .opcion-ramal:hover .etiqueta-frente {
      color: rgb(var(--c-primary));
      border-color: rgb(var(--c-primary));
    }

    /* Estos bloques solo existen en el PDF, nunca en pantalla. */
    .solo-imprimir { display: none; }

    /*
      EL PDF
      En outbound este documento es lo primero que ve el prospecto, antes que la
      home. Por eso no se imprime la pantalla en blanco: se arma un documento con
      el sistema visual de las presentaciones de Buffo — tema claro, Inter 800 en
      titulares, IBM Plex Mono en rótulos, verde Buffo de acento.
    */
    @media print {
      /*
        La fecha y la URL que el navegador imprime arriba y abajo NO salen de acá:
        las agrega el diálogo de impresión, en la casilla "Encabezados y pies de
        página". Solo desaparecen con margen 0, pero entonces el padding aplica una
        sola vez y las páginas interiores quedan pegadas al borde. Se prefiere el
        margen real y se apaga la casilla; el navegador recuerda la elección.
      */
      @page { size: A4; margin: 15mm 14mm 16mm; }

      /* Sin esto el navegador descarta fondos y las barras salen vacías. */
      * {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }

      header, footer, .accent-line, #barra, .no-imprimir {
        display: none !important;
      }
      body, .hero-bg, main, section {
        background: #fff !important;
        color: #0d0e10 !important;
      }
      .max-w-3xl { max-width: none !important; }
      #paso-resultado {
        font-family: 'Inter', sans-serif;
        font-size: 10pt;
        line-height: 1.6;
        color: #0d0e10;
      }

      .solo-imprimir { display: block !important; }

      /* ---------- Portada ---------- */
      #portada-pdf {
        position: relative;
        height: 247mm;                /* alto útil de la hoja: la portada va sola */
        display: flex;
        flex-direction: column;
        justify-content: center;
        break-after: page;
      }
      .portada-logo { position: absolute; top: 0; right: 0; width: 42mm; }
      .portada-centro { margin-top: -10mm; }
      #portada-pdf .eyebrow {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 8.5pt; text-transform: uppercase; letter-spacing: .2em;
        color: #0e8a4f; margin-bottom: 10mm;
      }
      #portada-pdf .eyebrow::before {
        content: ''; display: inline-block; width: 7mm; height: 1.5pt;
        background: #09726a; vertical-align: middle; margin-right: 3mm;
      }
      #portada-pdf .wordmark,
      #portada-pdf .wordmark-cliente {
        font-weight: 900; letter-spacing: -.03em; line-height: 1.02;
        font-size: 40pt; margin: 0;
      }
      #portada-pdf .wordmark-cliente { color: #0d0e10; }
      #portada-pdf .verde { color: #09726a; }
      #portada-pdf .por { color: #5b616b; font-weight: 800; }

      .portada-puntaje {
        margin-top: 16mm; padding-top: 6mm;
        border-top: 1.5pt solid #0d0e10;
