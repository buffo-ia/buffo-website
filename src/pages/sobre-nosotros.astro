---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceSteps from '../components/ServiceSteps.astro';
import { SITE, FOUNDER } from '../config/site';
import founderPhoto from '../assets/simon-espinoza.jpg';

const path = '/sobre-nosotros';
const metaTitle = 'Sobre nosotros | Buffo IA Consulting';
const metaDescription =
  'Buffo IA es una consultora chilena de inteligencia artificial nacida en las áreas comerciales. Conozca su origen, su forma de trabajar y a quién está detrás.';

// Texto de Comercial (12-oct-2026, tono senior: estrategia y retorno; salen el
// relato de origen, «software que trabaja solo» y «pymes»). Fuente:
// S-Lab/Buffo Consulting/Sitio 2.0/SOBRE_NOSOTROS_borrador.md.
const lead =
  'Buffo es una consultora chilena de inteligencia de negocios con IA. Acompañamos a gerencias y directorios en tres frentes: definir dónde está el retorno, ordenar la información para decidir y llevar la IA a la operación.';

// Biografía que se VE en la página. FOUNDER.bio (config/site.ts) no se toca:
// alimenta el schema Person, que es terreno de SEO.
const bioVisible =
  'Ingeniero Comercial de la Universidad Central y MBA de la Universidad del Desarrollo, con formación en IA aplicada a los negocios y análisis de datos. Más de diez años en áreas comerciales de retail y consumo masivo, y dos años en consultoría comercial, IA empresarial y automatización de procesos.';

const principios = [
  {
    icon: 'flag',
    title: 'Estrategia antes que tecnología',
    body: 'Cada proyecto parte de un objetivo de negocio y de su retorno esperado. La tecnología se elige en función de ese objetivo.',
  },
  {
    icon: 'lightbulb',
    title: 'Lectura, no solo información',
    body: 'Cada entrega incluye la interpretación: qué se salió de lo esperado, qué priorizar y cuál es la acción recomendada.',
  },
  {
    icon: 'handshake',
    title: 'Implementación acompañada',
    body: 'Avanzamos por etapas, con un resultado utilizable en cada una, y seguimos con su gerencia y su equipo hasta que la solución está en operación.',
  },
];

// Schema: AboutPage + Person (líder) vinculado a la Organization.
// Este Person será reutilizado como author de los artículos del blog (Fase 4).
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE.url}/#founder`,
  name: FOUNDER.name,
  jobTitle: FOUNDER.role,
  description: FOUNDER.bio,
  alumniOf: FOUNDER.alumniOf.map((u) => ({ '@type': 'CollegeOrUniversity', name: u })),
  worksFor: { '@id': `${SITE.url}/#organization` },
  image: new URL(founderPhoto.src, SITE.url).href,
  sameAs: [FOUNDER.linkedin],
};
const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: metaTitle,
  description: metaDescription,
  url: new URL(path, SITE.url).href,
  mainEntity: { '@id': `${SITE.url}/#organization` },
};
---

<BaseLayout title={metaTitle} description={metaDescription} path={path} schema={[aboutSchema, personSchema]} heroAncla>
  <!-- HERO -->
  <section class="bloque-ancla resplandor px-8 md:px-12 pt-28 pb-24">
    <div class="max-w-4xl mx-auto">
      <p class="reveal text-primary text-[0.7rem] tracking-[0.2em] uppercase font-semibold mb-8">Sobre nosotros</p>
      <h1 class="reveal reveal-delay-1 text-[2.5rem] md:text-[3.4rem] font-display leading-[1.08] mb-7 tracking-[-0.02em]">
        Estrategia de negocio,<br /><span class="text-primary">inteligencia de datos e IA</span>.
      </h1>
      <p class="reveal reveal-delay-2 text-lg md:text-xl text-on-surface-variant leading-relaxed">
        {lead}
      </p>
    </div>
  </section>

  <!-- ORIGEN / PROPÓSITO -->
  <section class="px-8 md:px-12 py-20 bg-surface-container-low border-b border-on-surface/5">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-14 items-center">
      <div class="reveal">
        <p class="text-primary tracking-widest uppercase text-xs font-semibold mb-3">Nuestra tesis</p>
        <h2 class="text-[2rem] md:text-[2.4rem] font-display mb-6 leading-tight">
          La IA es una decisión de inversión antes que una decisión de tecnología.
        </h2>
        <p class="text-on-surface-variant leading-relaxed mb-4">
          La mayoría de las iniciativas de IA parten por la herramienta. Nosotros partimos por el
          objetivo de negocio y por el retorno que se espera de él. Con eso definido, se decide qué
          información hace falta, qué se automatiza y dónde un agente de IA aporta valor.
        </p>
        <p class="text-on-surface-variant leading-relaxed">
          El resultado no es un proyecto tecnológico aislado. Es una capacidad instalada en la
          empresa: información confiable, decisiones mejor fundadas y un equipo que usa la IA en su
          trabajo diario.
        </p>
      </div>
      <div class="reveal reveal-delay-1 gradient-border p-10">
        <span class="material-symbols-outlined text-primary/40 text-4xl mb-4 block">format_quote</span>
        <p class="text-xl md:text-2xl font-display leading-relaxed text-on-surface">
          Trabajamos como socio estratégico de la gerencia. El avance se mide en resultado, adopción
          y retorno.
        </p>
      </div>
    </div>
  </section>

  <!-- CÓMO TRABAJAMOS (principios) -->
  <ServiceSteps eyebrow="Cómo trabajamos" title="Tres principios" steps={principios} />

  <!-- LÍDER VISIBLE -->
  <section class="px-8 md:px-12 py-20 bg-background">
    <div class="max-w-4xl mx-auto">
      <div class="mb-12 reveal">
        <p class="text-primary tracking-widest uppercase text-xs font-semibold mb-3">Quién está detrás</p>
        <h2 class="text-[2rem] md:text-[2.4rem] font-display">Dirección estratégica, con foco en el retorno</h2>
      </div>
      <div class="reveal reveal-delay-1 bg-surface-container-low border border-on-surface/5 p-9 md:p-12 flex flex-col md:flex-row gap-9 items-start">
        <div class="flex-shrink-0">
          <Image
            src={founderPhoto}
            alt={`${FOUNDER.name} — ${FOUNDER.role} de ${SITE.shortName}`}
            width={224}
            height={224}
            class="w-28 h-28 md:w-32 md:h-32 object-cover border border-primary/20 grayscale hover:grayscale-0 transition-all duration-500"
            loading="lazy"
          />
        </div>
        <div>
          <h3 class="font-display text-2xl mb-1">{FOUNDER.name}</h3>
          <p class="text-primary text-sm font-semibold mb-5">{FOUNDER.role}</p>
          <p class="text-on-surface-variant leading-relaxed mb-6">{bioVisible}</p>
          <ul class="space-y-2 mb-7">
            {
              FOUNDER.education.map((e) => (
                <li class="flex items-start gap-3 text-sm text-on-surface/90">
                  <span class="material-symbols-outlined text-primary text-base flex-shrink-0 mt-0.5">school</span>
                  <span>{e}</span>
                </li>
              ))
            }
          </ul>
          <a
            href={FOUNDER.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-primary text-sm font-semibold hover:underline"
          >
            <span class="material-symbols-outlined text-base">link</span>
            Perfil de LinkedIn
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CÓMO TRABAJAMOS
       El plan de Perplexity marca E-E-A-T de "Sobre nosotros" como pendiente:
       no basta con las credenciales, hay que mostrar cómo se trabaja. Los
       encabezados van en pregunta, que es lo que piden los motores de
       respuesta. Sin cifras ni casos: todavía no hay data autorizada. -->
  <section class="px-8 md:px-12 py-20 bg-surface-container-lowest border-t border-on-surface/5">
    <div class="max-w-3xl mx-auto space-y-12">
      <div class="reveal">
        <h2 class="text-[1.6rem] md:text-[2rem] font-display leading-tight mb-5">
          ¿Con qué empresas trabajamos?
        </h2>
        <p class="text-on-surface-variant leading-relaxed">
          Con empresas medianas y grandes en Chile, en industrias donde la decisión comercial y
          operacional pesa todos los días: retail, consumo masivo, distribución, industria y
          servicios. El punto en común es una gerencia que quiere decidir con mejor información y
          medir el retorno de lo que invierte.
        </p>
        <p class="text-on-surface-variant leading-relaxed mt-4">
          El trabajo se puede hacer de forma remota de principio a fin, así que también trabajamos
          con empresas fuera de Chile.
        </p>
      </div>
      <div class="reveal reveal-delay-1">
        <h2 class="text-[1.6rem] md:text-[2rem] font-display leading-tight mb-5">
          ¿Cómo es trabajar con nosotros?
        </h2>
        <p class="text-on-surface-variant leading-relaxed mb-4">
          El proyecto parte de una conversación estratégica. Primero se acuerda el objetivo de
          negocio y el retorno esperado, y después se define qué construir.
        </p>
        <p class="text-on-surface-variant leading-relaxed">
          El trabajo avanza por etapas cortas, con un resultado utilizable en cada una. Si el
          alcance cambia en el camino, lo ya entregado sigue sirviendo.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="px-8 md:px-12 py-20 bg-surface-container-low border-t border-on-surface/5">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-display mb-8 leading-tight">
        ¿Conversamos sobre su empresa?
      </h2>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={SITE.calendly} target="_blank" rel="noopener noreferrer" class="btn-glow bg-primary text-on-primary px-10 py-5 font-semibold text-base">
          Agende una llamada de 30 minutos
        </a>
        <a href="/contacto" class="border border-outline-variant text-on-surface px-10 py-5 font-semibold text-base hover:border-primary/30 transition-all">
          Enviar un mensaje
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
