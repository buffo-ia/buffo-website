---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, SERVICES, SERVICE_PAINS } from '../config/site';
import DashboardMockup from '../components/DashboardMockup.astro';
import ForecastMockup from '../components/ForecastMockup.astro';
import AutomationMockup from '../components/AutomationMockup.astro';
import AgentMockup from '../components/AgentMockup.astro';
import VentanaNavegador from '../components/VentanaNavegador.astro';

// Mapeo slug → mockup animado, para el escaparate de servicios.
const MOCKS: Record<string, any> = {
  'dashboards-ejecutivos': DashboardMockup,
  'modelamiento-predictivo': ForecastMockup,
  'automatizacion-procesos': AutomationMockup,
  'agentes-ia': AgentMockup,
};

// Escaparate de servicios del home: cada fila combina texto + su mockup.
// El titular es el DOLOR (SERVICE_PAINS); el nombre del producto va de eyebrow.
// Mismo criterio que el selector del diagnóstico: nadie elige por el nombre del producto.
const SHOWCASE = [
  {
    slug: 'dashboards-ejecutivos',
    url: 'app.buffoconsulting.cl/dashboard',
    eyebrow: 'Dashboards ejecutivos',
    title: SERVICE_PAINS['dashboards-ejecutivos'],
    desc: 'Sus ventas, su margen y su avance contra presupuesto en una pantalla que se actualiza sola. Con la lectura puesta: qué está fuera de lo esperado y dónde mirar primero.',
  },
  {
    slug: 'modelamiento-predictivo',
    url: 'app.buffoconsulting.cl/proyeccion',
    eyebrow: 'Modelamiento de datos',
    title: SERVICE_PAINS['modelamiento-predictivo'],
    desc: 'Cada área guarda lo suyo a su manera y las cifras no cuadran entre sistemas. Conectamos las fuentes una vez, con definiciones únicas. Recién ahí se puede proyectar, presupuestar y anticipar un quiebre.',
  },
  {
    slug: 'automatizacion-procesos',
    url: 'app.buffoconsulting.cl/flujos',
    eyebrow: 'Automatización de procesos',
    title: SERVICE_PAINS['automatizacion-procesos'],
    desc: 'Copiar y pegar entre planillas, rearmar el mismo informe cada lunes. Trabajo necesario, pero que no aprovecha el criterio de su equipo. Lo dejamos corriendo solo, empezando por el proceso que más horas libera.',
  },
  {
    slug: 'agentes-ia',
    url: 'app.buffoconsulting.cl/agentes',
    eyebrow: 'Agentes IA',
    title: SERVICE_PAINS['agentes-ia'],
    desc: 'Un agente vigila el negocio de forma continua: revisa el pipeline cada mañana, detecta la cobranza en riesgo, avisa del quiebre de stock antes de que ocurra. No lo inunda: le avisa cuando hay que actuar.',
  },
];

// Stack tecnológico real para el marquee (logos en public/stack/).
const STACK = [
  { src: '/stack/anthropic.svg', name: 'Anthropic' },
  { src: '/stack/openai.svg', name: 'OpenAI' },
  { src: '/stack/perplexity.svg', name: 'Perplexity' },
  { src: '/stack/gemini.svg', name: 'Gemini' },
  { src: '/stack/googlecloud.svg', name: 'Google Cloud' },
  { src: '/stack/python.svg', name: 'Python' },
  { src: '/stack/pandas.svg', name: 'pandas' },
  { src: '/stack/numpy.svg', name: 'NumPy' },
  { src: '/stack/react.svg', name: 'React' },
  { src: '/stack/typescript.svg', name: 'TypeScript' },
  { src: '/stack/nodedotjs.svg', name: 'Node.js' },
  { src: '/stack/supabase.svg', name: 'Supabase' },
  { src: '/stack/postgresql.svg', name: 'PostgreSQL' },
  { src: '/stack/tailwindcss.svg', name: 'Tailwind CSS' },
  { src: '/stack/vercel.svg', name: 'Vercel' },
  { src: '/stack/railway.svg', name: 'Railway' },
];

// Preguntas frecuentes de un decisor que llega frío. El plan de Perplexity las
// pide explícitamente (5-8) y alimentan el FAQPage schema, que es de lo que más
// aparece citado en respuestas generadas.
// ⚠️ Sin precios: la tarifa depende del alcance y no se publica.
const FAQ_HOME = [
  {
    q: '¿Qué tipo de consultoría de inteligencia artificial es Buffo?',
    a: 'De inteligencia artificial aplicada a la gestión comercial y operacional: ventas, margen, presupuesto, stock, cobranza y reportería. No es un laboratorio de investigación ni un equipo que entrena modelos experimentales: la técnica es el medio y la decisión de negocio es el objetivo.',
  },
  {
    q: '¿Cuánto cuesta una consultoría de inteligencia artificial en Chile?',
    a: 'No hay una tarifa única: el alcance cambia mucho entre ordenar unas planillas y dejar agentes operando. El diagnóstico de tres minutos es gratuito y entrega por escrito por dónde partir, sin compromiso.',
  },
  {
    q: '¿Cuánto demora ver el primer resultado?',
    a: 'Los proyectos se ordenan por etapas para que el primer entregable útil llegue pronto y no en varios meses: se parte por la fuente de datos más importante y por el proceso que más horas libera.',
  },
  {
    q: '¿Tengo que cambiar mi ERP o mis sistemas actuales?',
    a: 'No. Todo se construye encima de lo que la empresa ya usa: el ERP, el sistema de ventas, las planillas de control de gestión. Conectar es más barato y menos riesgoso que reemplazar.',
  },
  {
    q: '¿Por dónde empiezo si todavía no sé qué necesito?',
    a: 'Por el diagnóstico: doce preguntas sobre cómo se mueve hoy su información y un informe con lo que detectamos y qué conviene resolver primero.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ_HOME.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// Schema de servicios para la home
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${SITE.url}/#service`,
  name: SITE.name,
  provider: { '@id': `${SITE.url}/#organization` },
  serviceType: 'Consultoría en Inteligencia Artificial aplicada a la gestión comercial y operacional',
  areaServed: { '@type': 'Country', name: 'Chile' },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios Buffo IA',
    itemListElement: SERVICES.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.title, description: s.short },
    })),
  },
};
---

<BaseLayout schema={[serviceSchema, faqSchema]} heroAncla>
  <!-- HERO -->
  <section class="bloque-ancla resplandor relative px-8 md:px-12 pt-24 pb-28 md:pt-28 md:pb-32">
    <div class="relative z-10 max-w-5xl mx-auto text-center">
      <!-- La cejilla ya NO repite "aplicada a la gestión": esa frase subió al
           H1, que es donde se lee. Acá queda el contexto geográfico, que es lo
           que pide el plan de Perplexity y no estaba en ninguna parte visible. -->
      <p
        class="reveal text-primary text-[0.7rem] tracking-[0.2em] uppercase font-semibold mb-7"
      >
        Consultora de IA para gestión comercial · Santiago de Chile
      </p>
      <!-- Antes el H1 decía "Inteligencia Artificial" a secas: más amplio que
           el negocio real, y ni siquiera coincidía con el <title>, que ya
           prometía "aplicada a la gestión".
           Va "gestión EMPRESARIAL", no "gestión" a secas: en Chile "una
           gestión" es un trámite, así que la frase corta se puede leer como
           que ayudamos con papeleo.
           ⚠️ Queda una diferencia con el <title> y la meta description, que
           siguen diciendo "aplicada a la gestión". Es deliberado por ahora:
           ese texto está indexado y el título ya se pasa de largo (79 car.).
           Ver el pendiente de acortarlo. -->
      <!-- prettier-ignore -->
      <h1
        class="reveal reveal-delay-1 text-[2.15rem] md:text-[3.5rem] font-display leading-[1.06] md:leading-[1.03] tracking-[-0.025em]"
      >
        Consultoría en<br /><span class="text-primary md:whitespace-nowrap">Inteligencia Artificial</span><br />aplicada a la gestión empresarial
      </h1>
      <p class="reveal reveal-delay-1 text-lg md:text-xl font-display text-on-surface mt-4 mb-5" style="font-weight:600; letter-spacing:-0.01em;">
        Cuando el dato llega, la decisión ya se tomó.
      </p>
      <p
        class="reveal reveal-delay-2 text-base md:text-lg text-on-surface-variant max-w-2xl mx-auto mb-8 leading-relaxed"
      >
        Consultora especializada en modelamiento de datos, dashboards ejecutivos, automatización de
        procesos y agentes de inteligencia artificial.
      </p>
      <div class="reveal reveal-delay-3 flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/diagnostico"
          class="btn-glow bg-primary text-on-primary px-10 py-5 font-semibold text-base text-center"
        >
          Diagnóstico gratis · 12 preguntas · 3 minutos
        </a>
        <a
          href={SITE.calendly}
          target="_blank"
          rel="noopener noreferrer"
          class="border border-outline-variant bg-surface-container-highest/20 backdrop-blur-sm text-on-surface px-10 py-5 font-semibold text-base text-center hover:bg-surface-container-highest/40 hover:border-primary/25 transition-all"
        >
          Agendar 30 minutos
        </a>
      </div>
    </div>
  </section>

  <!-- PROBLEMA + SOLUCIÓN -->
  <section class="py-24 px-8 md:px-12 bg-background" id="approach">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-10 lg:gap-14 items-center">
      <div class="space-y-5 reveal">
        <div class="text-error uppercase tracking-widest text-xs font-semibold">El Conflicto</div>
        <h2 class="text-xl md:text-2xl font-display leading-snug">
          ¿Tiene datos, reportes y herramientas, y aun así llega al lunes sin saber qué
          corregir primero?
        </h2>
        <p class="text-on-surface-variant leading-relaxed text-sm md:text-base">
          No es déficit de información: es déficit de <strong class="text-on-surface font-semibold"
            >oportunidad</strong
          >. Cuando el reporte llega el día 10, lo que informa del día 3 ya es historia.
        </p>
      </div>
      <div class="reveal reveal-delay-2 relative p-8 md:p-10 gradient-border">
        <div class="text-primary uppercase tracking-widest text-xs font-semibold mb-4">La Respuesta</div>
        <p class="text-lg md:text-xl font-display leading-snug text-on-surface mb-4">
          Su sistema le dice lo que pasó. Nosotros le decimos qué hacer.
        </p>
        <p class="text-base md:text-lg mb-6 leading-relaxed text-on-surface-variant">
          No reemplazamos sus sistemas: los leemos, y a cada número le ponemos la lectura encima.
          Qué se salió de rango y qué revisar primero — con el criterio de quien tuvo que responder
          por esos números.
        </p>
        <div class="flex flex-wrap gap-2">
          {['Visualiza', 'Proyecta', 'Automatiza', 'Actúa'].map((t) => (
            <span class="text-[0.7rem] tracking-wide uppercase font-semibold text-primary border border-primary/25 bg-primary/5 px-3 py-1.5">{t}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICIOS — escaparate visual con mockups -->
  <section class="pt-28 pb-16 px-8 md:px-12 bg-surface" id="services">
    <div class="max-w-6xl mx-auto">
      <div class="mb-20 reveal flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <div>
          <p class="text-primary tracking-widest uppercase text-xs font-semibold mb-3">Capacidades</p>
          <h2 class="text-[2rem] md:text-[2.4rem] font-display leading-tight max-w-2xl">
            Cuatro formas de enterarse a tiempo.
          </h2>
        </div>
        <a
          href="/servicios"
          class="text-primary text-sm font-semibold hover:underline whitespace-nowrap"
        >
          Ver todos los servicios →
        </a>
      </div>

    </div>
  </section>

  <!-- Cada servicio se lleva su PROPIA banda de borde a borde, con su propio
       fondo. Antes los cuatro flotaban sobre la misma superficie y el ojo los
       leía como una lista; ahora son cuatro escenas y el fondo marca el ritmo.
       El tercero cae en bloque oscuro: es el respiro de contraste al medio. -->
  {
    SHOWCASE.map((s, i) => {
      const Mock = MOCKS[s.slug];
      const flip = i % 2 === 1; // filas impares: mockup a la izquierda
      const escena = ['bg-surface', 'bg-background', 'bloque-ancla resplandor filo-acento', 'bg-surface'][i];
      return (
        <section class:list={['px-8 md:px-12 py-20 md:py-24', escena]}>
          <div class="max-w-6xl mx-auto grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
            <div class:list={['reveal', flip ? 'lg:order-2' : 'lg:order-1']}>
              <p class="text-primary tracking-[0.2em] uppercase text-xs font-semibold mb-4">
                {String(i + 1).padStart(2, '0')} · {s.eyebrow}
              </p>
              <h3 class="text-[1.7rem] md:text-[2.1rem] font-display mb-5 leading-tight">{s.title}</h3>
              <p class="text-on-surface-variant text-lg leading-relaxed mb-8">{s.desc}</p>
              <a
                href={`/servicios/${s.slug}`}
                class="inline-flex items-center gap-2 text-primary font-semibold text-sm group"
              >
                Conocer más
                <span class="material-symbols-outlined text-base group-hover:translate-x-1 transition-transform">arrow_forward</span>
              </a>
            </div>
            <div class:list={['reveal reveal-delay-1', flip ? 'lg:order-1' : 'lg:order-2']}>
              <VentanaNavegador url={s.url} pestana={s.eyebrow}>
                <Mock />
              </VentanaNavegador>
            </div>
          </div>
        </section>
      );
    })
  }

  <!-- RESULTADOS (cualitativo, sin cifras inventadas) -->
  <section class="py-28 px-8 md:px-12 bg-background">
    <div class="max-w-screen-2xl mx-auto">
      <div class="flex flex-col md:flex-row justify-between items-baseline mb-20 gap-6">
        <div class="reveal">
          <p class="text-primary tracking-widest uppercase text-xs font-semibold mb-3">En operación</p>
          <h2 class="text-[2rem] md:text-[2.4rem] font-display">El tablero que sí se abre</h2>
        </div>
        <div class="hidden md:block h-px flex-grow bg-on-surface/8 mx-10"></div>
        <div class="reveal max-w-md">
          <p class="text-on-surface-variant text-sm leading-relaxed">
            Muchos proyectos de datos mueren en la capacitación: se entregan, se celebran, y a los
            dos meses nadie entra.
          </p>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-10 bg-surface-container-low border border-on-surface/5 card-hover reveal">
          <span class="material-symbols-outlined text-primary text-4xl opacity-60 mb-5 block"
            >event_repeat</span
          >
          <h4 class="text-lg font-display mb-3">Se usa todas las semanas</h4>
          <p class="text-on-surface-variant text-sm leading-relaxed">
            Nuestro módulo más usado lleva uso semanal ininterrumpido desde el lanzamiento, sin una
            sola campaña interna de adopción.
          </p>
        </div>
        <div class="p-10 bg-surface-container-low border border-on-surface/5 card-hover reveal reveal-delay-1">
          <span class="material-symbols-outlined text-primary text-4xl opacity-60 mb-5 block"
            >construction</span
          >
          <h4 class="text-lg font-display mb-3">Se sigue construyendo</h4>
          <p class="text-on-surface-variant text-sm leading-relaxed">
            No entregamos un proyecto y nos despedimos. Cada mes entra una función nueva, decidida
            con el cliente.
          </p>
        </div>
        <div class="p-10 bg-surface-container-low border border-on-surface/5 card-hover reveal reveal-delay-2">
          <span class="material-symbols-outlined text-primary text-4xl opacity-60 mb-5 block"
            >verified_user</span
          >
          <h4 class="text-lg font-display mb-3">Corre en producción, no en demo</h4>
          <p class="text-on-surface-variant text-sm leading-relaxed">
            Infraestructura propia y datos aislados: el mismo sistema opera para clientes distintos
            sin que uno vea al otro.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- LO QUE CONSTRUIMOS -->
  <section class="py-28 px-8 md:px-12 bg-surface" id="portfolio">
    <div class="max-w-screen-2xl mx-auto">
      <div class="mb-16 reveal">
        <p class="text-primary tracking-widest uppercase text-xs font-semibold mb-3">Portafolio</p>
        <h2 class="text-[2rem] md:text-[2.4rem] font-display">¿Qué construimos exactamente?</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
        <div
          class="md:col-span-8 bg-surface-container-low p-12 relative overflow-hidden border border-on-surface/5 card-hover reveal"
        >
          <div class="relative z-10">
            <h3 class="text-primary font-display text-2xl mb-7">Área Comercial y Ventas</h3>
            <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 text-on-surface/80">
              <li class="flex items-center gap-3 text-sm">
                <span class="w-1.5 h-1.5 bg-primary flex-shrink-0"></span>Dashboard vs presupuesto
              </li>
              <li class="flex items-center gap-3 text-sm">
                <span class="w-1.5 h-1.5 bg-primary flex-shrink-0"></span>Forecasting de ventas
              </li>
              <li class="flex items-center gap-3 text-sm">
                <span class="w-1.5 h-1.5 bg-primary flex-shrink-0"></span>Alertas de quiebre de stock
              </li>
              <li class="flex items-center gap-3 text-sm">
                <span class="w-1.5 h-1.5 bg-primary flex-shrink-0"></span>Campañas en Google y Meta
                Ads
              </li>
            </ul>
          </div>
          <div class="absolute right-0 bottom-0 opacity-[0.025] scale-150 rotate-6 pointer-events-none">
            <span class="material-symbols-outlined text-[18rem] text-primary">trending_up</span>
          </div>
        </div>
        <div
          class="md:col-span-4 bg-surface-container-high p-12 border border-on-surface/5 card-hover reveal reveal-delay-1"
        >
          <h3 class="text-primary font-display text-xl mb-7">Área Financiera</h3>
          <ul class="space-y-3 text-on-surface/80">
            <li class="flex items-center gap-3 text-sm">
              <span class="w-1.5 h-1.5 bg-primary flex-shrink-0"></span>Análisis de Estado de
              Resultados
            </li>
            <li class="flex items-center gap-3 text-sm">
              <span class="w-1.5 h-1.5 bg-primary flex-shrink-0"></span>Elaboración de flujo de caja
            </li>
          </ul>
        </div>
        <div class="md:col-span-12 gradient-border p-12 reveal reveal-delay-2">
          <span class="material-symbols-outlined text-primary/40 text-4xl mb-4 block">format_quote</span>
          <p class="text-xl md:text-2xl font-display leading-relaxed text-on-surface">
            No entregamos un número sin interpretación. Cada solución llega con la sugerencia puesta: qué
            mirar primero, y qué haría alguien que ya tuvo que responder por ese número frente a un
            directorio.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- STACK TECNOLÓGICO (marquee) -->
  <section class="bloque-ancla resplandor filo-acento py-28 px-8 md:px-12 overflow-hidden">
    <div class="max-w-5xl mx-auto text-center mb-14 reveal">
      <p class="text-primary tracking-widest uppercase text-xs font-semibold mb-3">Infraestructura</p>
      <h2 class="text-[2rem] md:text-[2.4rem] font-display leading-tight mb-4">
        Tecnología de clase mundial, al servicio de su negocio
      </h2>
      <p class="text-on-surface-variant leading-relaxed max-w-2xl mx-auto">
        Las mismas herramientas que usan las grandes tecnológicas. Usted ve decisiones simples;
        debajo, una base seria.
      </p>
    </div>

    <div class="marquee-mask reveal reveal-delay-1">
      <div class="marquee-track gap-10 md:gap-14">
        {[...STACK, ...STACK].map((t, i) => (
          <div class="flex items-center gap-2.5 shrink-0 group" aria-hidden={i >= STACK.length ? 'true' : undefined}>
            {/* El SVG va de MÁSCARA, no de imagen: los archivos de Simple Icons
                traen fill="#ffffff" quemado adentro y como <img> desaparecen
                sobre fondo claro. De máscara, el color lo pone el tema. */}
            <span
              class="stack-logo h-6 w-6 md:h-7 md:w-7 shrink-0"
              style={`--logo:url('${t.src}')`}
              aria-hidden="true"></span>
            <span class="text-sm md:text-base font-semibold text-on-surface/55 group-hover:text-on-surface transition-colors whitespace-nowrap">
              {t.name}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA CONTACTO -->
    <!-- PREGUNTAS FRECUENTES
       Pedido explícito del plan de Perplexity (5-8 preguntas de decisores) y
       alimenta el FAQPage schema, que es de lo que más se cita en respuestas
       generadas. El texto va arriba, en FAQ_HOME. -->
  <section class="px-8 md:px-12 py-24 bg-surface">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-[2rem] md:text-[2.4rem] font-display mb-10 reveal">Preguntas frecuentes</h2>
      <div class="grid gap-px bg-on-surface/5 border border-on-surface/5">
        {
          FAQ_HOME.map((f, i) => (
            <details class:list={['faq-item bg-surface-container-low group reveal', i > 0 && 'reveal-delay-1']}>
              <summary class="flex cursor-pointer items-center justify-between gap-6 p-6 md:p-7">
                <h3 class="font-display text-base md:text-lg leading-snug">{f.q}</h3>
                <span class="material-symbols-outlined text-on-surface-variant transition-transform group-open:rotate-45">
                  add
                </span>
              </summary>
              <p class="px-6 pb-6 md:px-7 md:pb-7 text-on-surface-variant leading-relaxed">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

<section class="bloque-ancla filo-acento py-28 px-8 md:px-12">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-primary tracking-widest uppercase text-xs font-semibold mb-4 reveal">Contacto</p>
      <h2 class="text-3xl md:text-4xl font-display mb-10 leading-tight reveal">
        La próxima decisión importante ya está esperando un dato que todavía no llega.
      </h2>
      <div class="reveal reveal-delay-1 flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/diagnostico"
          class="inline-block btn-glow bg-primary text-on-primary px-12 py-5 text-base font-semibold tracking-tight"
        >
          Empezar el diagnóstico · 3 minutos
        </a>
        <a
          href={SITE.calendly}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block border border-outline-variant text-on-surface px-12 py-5 text-base font-semibold hover:border-primary/30 transition-all"
        >
          Agendar 30 minutos
        </a>
      </div>
