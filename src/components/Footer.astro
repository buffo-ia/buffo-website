---
import Logotipo from './Logotipo.astro';
import IconoRed from './IconoRed.astro';
import { SITE } from '../config/site';
import { SERVICES_CONTENT } from '../data/services';
const year = new Date().getFullYear();

const recursos = [
  { label: 'Blog', href: '/blog' },
  { label: 'Sobre nosotros', href: '/sobre-nosotros' },
  { label: 'Servicios', href: '/servicios' },
];
---

<footer class="bg-background border-t border-on-surface/5">
  <div class="max-w-screen-2xl mx-auto px-8 md:px-12 py-11">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-8 mb-9">
      <!-- Marca -->
      <div class="col-span-2 md:col-span-1">
        <!-- Sin placa blanca detrás: acá va la variante de palabra blanca, que
             se apoya directo sobre el fondo del pie y conserva el colibrí
             turquesa. La placa resolvía el contraste pero se leía como un
             sticker pegado encima del pie. -->
        <Logotipo tamano="pie" fondo="auto" class="mb-4" />
        <p class="text-on-surface-variant text-sm leading-relaxed max-w-xs">
          Inteligencia artificial aplicada a la gestión comercial y operacional. Para pymes y
          grandes empresas en Chile.
        </p>
      </div>

      <!-- Servicios -->
      <div>
        <p class="text-xs tracking-widest uppercase text-on-surface/40 font-semibold mb-4">Servicios</p>
        <ul class="space-y-2.5">
          {
            SERVICES_CONTENT.map((s) => (
              <li>
                <a
                  href={`/servicios/${s.slug}`}
                  class="text-sm text-on-surface/55 hover:text-primary transition-colors"
                >
                  {s.navTitle}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Recursos -->
      <div>
        <p class="text-xs tracking-widest uppercase text-on-surface/40 font-semibold mb-4">Recursos</p>
        <ul class="space-y-2.5">
          {
            recursos.map((r) => (
              <li>
                <a href={r.href} class="text-sm text-on-surface/55 hover:text-primary transition-colors">
                  {r.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contacto.
           En celular ocupa las dos columnas, igual que el bloque de marca. Con
           media columna el correo no cabía y se partía a mitad de palabra
           ("contacto@buffoconsultin / g.cl"): 27 caracteres más el ícono no
           entran en 163 px. -->
      <div class="col-span-2 md:col-span-1">
        <p class="text-xs tracking-widest uppercase text-on-surface/40 font-semibold mb-4">Contacto</p>
        <!-- Los íconos son los mismos que usan las tarjetas de /contacto: si el
             correo lleva un sobre allá, acá también, o el visitante tiene que
             volver a aprender la página.

             ⚠️ Van DENTRO del <a>, no al lado. Un ícono afuera es decoración
             muerta: se ve como parte del enlace, pero al hacerle clic no pasa
             nada y el que apuntó al sobre queda pensando que la página está
             rota. Adentro, el par entero es una sola zona de clic. -->
        <ul class="space-y-2.5">
          <li>
            <a
              href={`mailto:${SITE.email}`}
              class="pie-enlace group text-sm text-on-surface/55 hover:text-primary transition-colors"
            >
              <span class="material-symbols-outlined pie-icono" aria-hidden="true">mail</span>
              <span class="break-words">{SITE.email}</span>
            </a>
          </li>
          <li>
            <a
              href={SITE.calendly}
              target="_blank"
              rel="noopener noreferrer"
              class="pie-enlace group text-sm text-on-surface/55 hover:text-primary transition-colors"
            >
              <span class="material-symbols-outlined pie-icono" aria-hidden="true">event_available</span>
              <span>Agende una llamada</span>
            </a>
          </li>
          <li>
            <a
              href={`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(SITE.whatsappMensaje)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="pie-enlace group text-sm text-on-surface/55 hover:text-primary transition-colors"
            >
              <span class="material-symbols-outlined pie-icono" aria-hidden="true">chat</span>
              <span>WhatsApp</span>
            </a>
          </li>
          <li>
            <a
              href={SITE.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="pie-enlace group text-sm text-on-surface/55 hover:text-primary transition-colors"
            >
              <IconoRed red="linkedin" class="marca-red" />
              <span>LinkedIn</span>
            </a>
          </li>
          <li>
            <a
              href={SITE.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="pie-enlace group text-sm text-on-surface/55 hover:text-primary transition-colors"
            >
              <IconoRed red="instagram" class="marca-red" />
              <span>Instagram</span>
            </a>
          </li>
          <!-- La dirección ahora sí lleva a alguna parte: al mapa. Es lo que el
               visitante espera de un pin, y era la única línea de la columna que
               no respondía al clic. El <address> queda por dentro para que los
               buscadores sigan leyendo el domicilio. -->
          <li>
            <a
              href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(SITE.direccion.completa)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="pie-enlace group text-sm text-on-surface/55 hover:text-primary transition-colors"
            >
              <span class="material-symbols-outlined pie-icono" aria-hidden="true">location_on</span>
              <address class="not-italic leading-relaxed">
                {SITE.direccion.calle}<br />{SITE.direccion.comuna}, Santiago
              </address>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-on-surface/5 pt-6 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-xs tracking-widest uppercase text-on-surface/45 text-center md:text-left">
        © {year} {SITE.name}. Todos los derechos reservados.
      </p>
      <!-- El sitio mide con Analytics y Ads, así que la política no es adorno:
           Google exige que el anunciante declare el uso de cookies publicitarias
           y el visitante tiene que poder encontrarla sin buscarla. -->
      <a
        href="/privacidad"
        class="text-xs tracking-widest uppercase text-on-surface/45 hover:text-primary transition-colors"
      >
        Política de privacidad
      </a>
    </div>
  </div>
</footer>

<style>
  /* El enlace envuelve al ícono y al texto, así que tiene que comportarse como
     una fila y no como una línea de texto corrida. */
  .pie-enlace {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
  }

  .pie-icono {
    font-size: 18px;
    line-height: 1.35;
    /* Los íconos acompañan, no compiten: quedan un punto más apagados que el
       texto, que ya va al 55%. */
    color: rgb(var(--c-on-surface) / 0.38);
    flex-shrink: 0;
    /* Material Symbols tiene más altura de caja que la línea de texto de al
       lado; sin esto el ícono se sienta un pelo más abajo que la primera letra. */
    margin-top: 1px;
  }

  /* Los logos de red son SVG dentro de otro componente, así que el ámbito de
     este archivo no les llega: la regla va en :global. Miden un poco menos que
     los Material Symbols porque una marca sólida pesa más a igual caja. */
  .pie-enlace :global(.marca-red) {
    width: 16px;
    height: 16px;
    margin-top: 3px;
    flex-shrink: 0;
    color: rgb(var(--c-on-surface) / 0.38);
    transition: color 0.2s ease;
  }
  .pie-enlace:hover :global(.marca-red) {
    color: rgb(var(--c-primary) / 0.8);
  }

  /* El ícono sigue al enlace en el hover: si solo cambiara el texto, el par se
     partiría en dos al pasar el mouse. */
  .pie-icono {
    transition: color 0.2s ease;
  }
  .pie-enlace:hover .pie-icono {
    color: rgb(var(--c-primary) / 0.8);
  }
</style>
