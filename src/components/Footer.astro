---
import Logotipo from './Logotipo.astro';
import { SITE } from '../config/site';
import { SERVICES_CONTENT } from '../data/services';
const year = new Date().getFullYear();

const recursos = [
  { label: 'Blog', href: '/blog' },
  { label: 'Sobre nosotros', href: '/sobre-nosotros' },
  { label: 'Servicios', href: '/servicios' },
];
---

<footer class="bg-background border-t border-on-surface/5">
  <div class="max-w-screen-2xl mx-auto px-8 md:px-12 py-16">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-10 md:gap-8 mb-14">
      <!-- Marca -->
      <div class="col-span-2 md:col-span-1">
        <!-- El logotipo va sobre una placa blanca, igual que en el header y por
             el mismo motivo: el archivo del diseñador trae el colibrí turquesa
             con la palabra en negro, y sobre el azul noche del pie esa palabra
             casi desaparecía. La alternativa era la versión monocroma blanca,
             que sí se leía pero perdía el turquesa — o sea, dejaba el logo sin
             el único color de la marca justo donde se firma la página. -->
        <span class="placa-logo mb-5">
          <Logotipo tamano="pie" />
        </span>
        <p class="text-on-surface-variant text-sm leading-relaxed max-w-xs">
          Inteligencia artificial aplicada a la gestión comercial y operacional. Para pymes y
          grandes empresas en Chile.
        </p>
      </div>

      <!-- Servicios -->
      <div>
        <p class="text-xs tracking-widest uppercase text-on-surface/40 font-semibold mb-5">Servicios</p>
        <ul class="space-y-3">
          {
            SERVICES_CONTENT.map((s) => (
              <li>
                <a
                  href={`/servicios/${s.slug}`}
                  class="text-sm text-on-surface/55 hover:text-primary transition-colors"
                >
                  {s.navTitle}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Recursos -->
      <div>
        <p class="text-xs tracking-widest uppercase text-on-surface/40 font-semibold mb-5">Recursos</p>
        <ul class="space-y-3">
          {
            recursos.map((r) => (
              <li>
                <a href={r.href} class="text-sm text-on-surface/55 hover:text-primary transition-colors">
                  {r.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contacto.
           En celular ocupa las dos columnas, igual que el bloque de marca. Con
           media columna el correo no cabía y se partía a mitad de palabra
           ("contacto@buffoconsultin / g.cl"): 27 caracteres más el ícono no
           entran en 163 px. -->
      <div class="col-span-2 md:col-span-1">
        <p class="text-xs tracking-widest uppercase text-on-surface/40 font-semibold mb-5">Contacto</p>
        <!-- Los íconos son los mismos que usan las tarjetas de /contacto: si el
             correo lleva un sobre allá, acá también, o el visitante tiene que
             volver a aprender la página. Van en aria-hidden porque no aportan
             nada que el texto de al lado no diga ya. -->
        <ul class="space-y-3.5">
          <li class="flex items-start gap-2.5">
            <span class="material-symbols-outlined pie-icono" aria-hidden="true">mail</span>
            <a
              href={`mailto:${SITE.email}`}
              class="text-sm text-on-surface/55 hover:text-primary transition-colors break-words"
            >
              {SITE.email}
            </a>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="material-symbols-outlined pie-icono" aria-hidden="true">event_available</span>
            <a
              href={SITE.calendly}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-on-surface/55 hover:text-primary transition-colors"
            >
              Agende una llamada
            </a>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="material-symbols-outlined pie-icono" aria-hidden="true">link</span>
            <a
              href={SITE.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-on-surface/55 hover:text-primary transition-colors"
            >
              LinkedIn
            </a>
          </li>
          <!-- La dirección no es un enlace: no hay a dónde llevar al visitante
               que no sea un mapa de un tercero. Va como <address>, que es lo
               que los buscadores leen como el domicilio del sitio. -->
          <li class="flex items-start gap-2.5">
            <span class="material-symbols-outlined pie-icono" aria-hidden="true">location_on</span>
            <address class="text-sm text-on-surface/55 not-italic leading-relaxed">
              {SITE.direccion.calle}<br />{SITE.direccion.comuna}, Santiago
            </address>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-on-surface/5 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-xs tracking-widest uppercase text-on-surface/45 text-center md:text-left">
        © {year} {SITE.name}. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>

<style>
  /* La placa del logotipo. Ancho al contenido —no al ancho de la columna— para
     que se lea como el sello de la marca y no como una tarjeta vacía con algo
     adentro. El radio es el de "lo que contiene" de la escala del sitio. */
  .placa-logo {
    display: inline-block;
    background: #ffffff;
    padding: 0.7rem 1.1rem;
    border-radius: 12px;
    line-height: 0;
  }

  .pie-icono {
    font-size: 18px;
    line-height: 1.35;
    /* Los íconos acompañan, no compiten: quedan un punto más apagados que el
       texto, que ya va al 55%. */
    color: rgb(var(--c-on-surface) / 0.38);
    flex-shrink: 0;
    /* Material Symbols tiene más altura de caja que la línea de texto de al
       lado; sin esto el ícono se sienta un pelo más abajo que la primera letra. */
    margin-top: 1px;
  }

  /* El ícono sigue al enlace en el hover: si solo cambiara el texto, el par se
     partiría en dos al pasar el mouse. */
  li:hover .pie-icono {
    color: rgb(var(--c-primary) / 0.75);
    transition: color 0.2s ease;
  }
</style>
