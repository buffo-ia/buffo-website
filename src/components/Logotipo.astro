---
/**
 * Logotipo BUFFO × IA — tipográfico, sin imagen.
 *
 * Reemplaza al átomo verde. Tres razones por las que es tipográfico y no un
 * archivo: (1) el átomo era lo último que quedaba de la paleta vieja y chocaba
 * con el turquesa; (2) al ser texto se repinta solo con el tema, así que no hace
 * falta una versión para fondo claro y otra para oscuro; (3) escala sin perder
 * nitidez y pesa cero.
 *
 * El significado de la ×: viene del sello de los decks ("Buffo × Cliente"), pero
 * acá multiplica BUFFO por IA — el criterio comercial por la tecnología, que es
 * el posicionamiento de la empresa.
 *
 * ⚠️ REGLA DE USO: si el logotipo lleva ×, no puede convivir con el sello
 * "Buffo × Cliente" en la misma pieza, o queda "BUFFO × IA × CLIENTE".
 *
 * ⚠️ El nombre de registro sigue siendo "Buffo IA Consulting". Este es el
 * logotipo, no un nombre nuevo: el <title>, el schema y los correos mantienen
 * el nombre completo.
 */
interface Props {
  /** Alto del logotipo. 'header' para la barra, 'pie' más chico. */
  tamano?: 'header' | 'pie';
  class?: string;
}
const { tamano = 'header', class: clase = '' } = Astro.props;
---

<span class:list={['logotipo', `logotipo-${tamano}`, clase]} aria-label="Buffo IA Consulting">
  <span class="lt-linea" aria-hidden="true">Buffo <span class="lt-equis">×</span> <span class="lt-ia">IA</span></span>
  <span class="lt-desc" aria-hidden="true">CONSULTING</span>
</span>

<style>
  /* Logotipo tipográfico. Se probó justificar el descriptor al ancho exacto del
     nombre (separando las letras para que el navegador pudiera repartir el
     espacio) y Simón prefirió la versión simple: el descriptor con su propio
     tracking, alineado a la izquierda. Queda anotado para no reintentarlo. */
  .logotipo {
    display: inline-block;
    line-height: 1;
    white-space: nowrap;
    color: rgb(var(--c-on-surface));
    user-select: none;
  }

  .lt-linea {
    display: block;
    font-family: Inter, sans-serif;
    font-weight: 800;
    /* En caja mixta las ascendentes ya separan las letras, así que el tracking
       apretado del titular funciona y le da unidad al bloque. En versal habría
       que abrirlo: sin ascendentes, el negativo empasta. */
    letter-spacing: -0.02em;
  }

  /* La × en gris: es un signo de relación, no una letra del nombre. Va algo
     más chica y subida, porque viene diseñada para fórmulas y se apoya en el
     eje matemático, más arriba que la base del texto. */
  .lt-equis {
    display: inline-block;
    font-size: 0.8em;
    font-weight: 600;
    color: rgb(var(--c-on-surface) / 0.4);
    transform: translateY(-0.04em);
    margin: 0 0.14em;
  }

  .lt-ia { color: rgb(var(--c-primary)); }

  .lt-desc {
    display: block;
    font-family: 'IBM Plex Mono', monospace;
    font-weight: 500;
    letter-spacing: 0.26em;
    color: rgb(var(--c-on-surface) / 0.5);
    padding-left: 0.12em;
  }

  .logotipo-header .lt-linea { font-size: 1.45rem; }
  .logotipo-header .lt-desc { font-size: 0.5rem; margin-top: 0.4rem; }

  .logotipo-pie .lt-linea { font-size: 1.15rem; }
  .logotipo-pie .lt-desc { font-size: 0.44rem; margin-top: 0.34rem; }

  /* Bajo cierto tamaño el descriptor deja de leerse y estorba: se cae. */
  @media (max-width: 420px) {
    .logotipo-header .lt-linea { font-size: 1.18rem; }
    .logotipo-header .lt-desc { display: none; }
  }

  /* Versión de una sola tinta: factura, sello, un PDF en blanco y negro. */
  .logotipo-mono .lt-ia,
  .logotipo-mono .lt-equis { color: inherit; }
  .logotipo-mono .lt-equis { opacity: 0.45; }
</style>
