---
/**
 * Logotipo Buffo — el archivo original del diseñador.
 *
 * Desde el 25-ago-2026 el logo es el de milogotipo.cl: el colibrí suelto (ya no
 * dentro de un disco) con el ave en turquesa y relleno propio. Se usan los PNG
 * que él entregó, recortados al arte por `scripts/importar-logo.mjs` y sin
 * ningún otro cambio. Antes esto era un SVG con la palabra en `currentColor`,
 * recurso que servía cuando el ave era espacio negativo; el logo nuevo trae su
 * color adentro, así que ya no hay nada que teñir desde el CSS.
 *
 * Una sola variante: colibrí turquesa con la palabra en negro. Los dos lugares
 * donde aparece —el header y el pie— le ponen fondo claro debajo, así que no
 * hace falta intercambiar archivos por tema. La versión monocroma blanca sigue
 * en src/assets, pero la usa `scripts/generar-og.mjs`, que sí dibuja sobre el
 * azul noche.
 */
import { Image } from 'astro:assets';
import logoNegro from '../assets/logo-buffo-negro.png';

interface Props {
  /** 'header' para la barra, 'pie' más chico. */
  tamano?: 'header' | 'pie';
  class?: string;
}
const { tamano = 'header', class: clase = '' } = Astro.props;

const ALT = 'Buffo IA Consulting';
// El logo entra a 1452 px de ancho y se muestra a ~150. Se declaran los anchos
// para que Astro emita el srcset y el celular no descargue el archivo grande.
const ANCHOS = [180, 300, 440];
---

<span class:list={['logotipo', `logotipo-${tamano}`, clase]}>
  <Image
    src={logoNegro}
    alt={ALT}
    widths={ANCHOS}
    sizes="220px"
    loading={tamano === 'header' ? 'eager' : 'lazy'}
  />
</span>

<style>
  .logotipo {
    display: inline-block;
    line-height: 0;
  }

  .logotipo :global(img) {
    height: 100%;
    width: auto;
    display: block;
  }

  /* Con line-height 0 y sin altura el <span> no mide nada y la imagen con
     height:100% se queda en cero. Ya pasó una vez: el logotipo desapareció. */
  /* El logo nuevo mide dos tercios de alto que el anterior a igual ancho: el
     de antes era un disco casi cuadrado, éste es una tira horizontal con la
     bajada "IA CONSULTING" en cuerpo muy chico. Ajustado a ojo hasta que la
     bajada se lee sin forzar la vista. */
  .logotipo-header {
    height: 2.7rem;
  }
  .logotipo-pie {
    height: 2.4rem;
  }

  /* En celular el logotipo compite con el botón del diagnóstico por un ancho
     que no alcanza para los dos. Se achica en vez de dejar que se monten. */
  @media (max-width: 480px) {
    .logotipo-header {
      height: 1.9rem;
    }
  }

</style>
