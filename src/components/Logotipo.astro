---
/**
 * Logotipo Buffo — el archivo original del diseñador.
 *
 * Desde el 25-ago-2026 el logo es el de milogotipo.cl: el colibrí suelto (ya no
 * dentro de un disco) con el ave en turquesa y relleno propio. Antes esto era un
 * SVG con la palabra en `currentColor`, recurso que servía cuando el ave era
 * espacio negativo; el logo nuevo trae su color adentro, así que ya no hay nada
 * que teñir desde el CSS y hacen falta dos archivos.
 *
 * La diferencia entre los dos es solo la palabra —el colibrí va en turquesa en
 * los dos casos, que es lo que hace que la marca se reconozca igual en cualquier
 * fondo. Los genera `scripts/importar-logo.mjs`; el de palabra blanca se
 * reconstruye desde el mismo original, porque el diseñador lo entregó únicamente
 * como JPG con el fondo negro quemado.
 *
 * Van los dos <img> al HTML y el CSS esconde el que sobra. Es a propósito: el
 * tema se resuelve antes de pintar, así que un intercambio por JavaScript
 * mostraría el logo equivocado durante el primer cuadro.
 */
import { Image } from 'astro:assets';
import logoClaro from '../assets/logo-sobre-claro.png';
import logoOscuro from '../assets/logo-sobre-oscuro.png';

interface Props {
  /** 'header' para la barra, 'pie' más chico. */
  tamano?: 'header' | 'pie';
  /**
   * 'claro' fija la palabra en negro. Lo usa el header, que es una barra blanca
   * en los dos temas, así que ahí el tema de la página no manda.
   * 'auto' sigue al tema, para donde el fondo sí cambia.
   */
  fondo?: 'claro' | 'auto';
  class?: string;
}
const { tamano = 'header', fondo = 'claro', class: clase = '' } = Astro.props;

const ALT = 'Buffo IA Consulting';
// El logo entra a 1452 px de ancho y se muestra a ~180. Se declaran los anchos
// para que Astro emita el srcset y el celular no descargue el archivo grande.
const ANCHOS = [200, 340, 520];
---

<span class:list={['logotipo', `logotipo-${tamano}`, `fondo-${fondo}`, clase]}>
  <Image
    src={logoClaro}
    alt={ALT}
    widths={ANCHOS}
    sizes="260px"
    class="sobre-claro"
    loading={tamano === 'header' ? 'eager' : 'lazy'}
  />
  {
    fondo === 'auto' && (
      <Image src={logoOscuro} alt={ALT} widths={ANCHOS} sizes="260px" class="sobre-oscuro" loading="lazy" />
    )
  }
</span>

<style>
  .logotipo {
    display: inline-block;
    line-height: 0;
  }

  .logotipo :global(img) {
    height: 100%;
    width: auto;
    display: block;
  }

  /* Con line-height 0 y sin altura el <span> no mide nada y la imagen con
     height:100% se queda en cero. Ya pasó una vez: el logotipo desapareció. */
  /* El logo nuevo es una tira horizontal con la bajada "IA CONSULTING" en cuerpo
     muy chico, así que a igual altura se lee bastante menos que el anterior, que
     era un disco casi cuadrado. Sube hasta donde da la barra sin empujarla: el
     botón del diagnóstico mide 42 px y es lo que fija el alto del header. */
  .logotipo-header {
    height: 3.35rem;
  }
  .logotipo-pie {
    height: 2.6rem;
  }

  /* En celular el logotipo compite con el botón del diagnóstico por un ancho
     que no alcanza para los dos. Se achica en vez de dejar que se monten. */
  @media (max-width: 480px) {
    .logotipo-header {
      height: 2.5rem;
    }
  }

  /* El intercambio por tema. Solo aplica a 'auto': con 'claro' el segundo
     archivo ni siquiera se emite. El script inline del <head> siempre deja
     data-theme puesto, así que no hace falta cubrir el caso "sin atributo". */
  .fondo-auto .sobre-oscuro {
    display: none;
  }
  :global(:root[data-theme='dark']) .fondo-auto .sobre-claro {
    display: none;
  }
  :global(:root[data-theme='dark']) .fondo-auto .sobre-oscuro {
    display: block;
  }

  /* El informe del diagnóstico se imprime siempre en claro (ver global.css),
     así que en papel va la palabra negra, no la blanca. */
  @media print {
    .fondo-auto .sobre-claro {
      display: block;
    }
    .fondo-auto .sobre-oscuro {
      display: none;
    }
  }
</style>
