---
/**
 * Logotipo BUFFO × IA — tipográfico, sin imagen.
 *
 * Reemplaza al átomo verde. Tres razones por las que es tipográfico y no un
 * archivo: (1) el átomo era lo último que quedaba de la paleta vieja y chocaba
 * con el turquesa; (2) al ser texto se repinta solo con el tema, así que no hace
 * falta una versión para fondo claro y otra para oscuro; (3) escala sin perder
 * nitidez y pesa cero.
 *
 * El significado de la ×: viene del sello de los decks ("Buffo × Cliente"), pero
 * acá multiplica BUFFO por IA — el criterio comercial por la tecnología, que es
 * el posicionamiento de la empresa.
 *
 * ⚠️ REGLA DE USO: si el logotipo lleva ×, no puede convivir con el sello
 * "Buffo × Cliente" en la misma pieza, o queda "BUFFO × IA × CLIENTE".
 *
 * ⚠️ El nombre de registro sigue siendo "Buffo IA Consulting". Este es el
 * logotipo, no un nombre nuevo: el <title>, el schema y los correos mantienen
 * el nombre completo.
 */
interface Props {
  /** Alto del logotipo. 'header' para la barra, 'pie' más chico. */
  tamano?: 'header' | 'pie';
  class?: string;
}
const { tamano = 'header', class: clase = '' } = Astro.props;
---

<span class:list={['logotipo', `logotipo-${tamano}`, clase]} aria-label="Buffo IA Consulting">
  <span class="lt-linea" aria-hidden="true">BUFFO <span class="lt-equis">×</span> <span class="lt-ia">IA</span></span>
  <span class="lt-desc" aria-hidden="true">CONSULTING</span>
</span>

<style>
  .logotipo {
    display: inline-block;
    line-height: 1;
    white-space: nowrap;
    color: rgb(var(--c-on-surface));
    user-select: none;
  }
  .lt-linea {
    display: block;
    font-family: Inter, sans-serif;
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  /* La × en gris: es un signo de relación, no una letra del nombre. Si va en
     el mismo tono que el resto compite con las palabras. */
  .lt-equis { color: rgb(var(--c-on-surface) / 0.42); padding: 0 0.06em; }
  .lt-ia { color: rgb(var(--c-primary)); }

  /* El descriptor va en mono: separa el nombre de la categoría de un vistazo,
     y es el mismo registro de los rótulos del sitio. */
  .lt-desc {
    display: block;
    font-family: 'IBM Plex Mono', monospace;
    font-weight: 500;
    letter-spacing: 0.26em;
    color: rgb(var(--c-on-surface) / 0.5);
    padding-left: 0.12em;
  }

  .logotipo-header .lt-linea { font-size: 1.45rem; }
  .logotipo-header .lt-desc { font-size: 0.5rem; margin-top: 0.36rem; }

  .logotipo-pie .lt-linea { font-size: 1.15rem; }
  .logotipo-pie .lt-desc { font-size: 0.44rem; margin-top: 0.3rem; }

  @media (max-width: 420px) {
    .logotipo-header .lt-linea { font-size: 1.2rem; }
    .logotipo-header .lt-desc { font-size: 0.44rem; letter-spacing: 0.2em; }
  }
</style>
