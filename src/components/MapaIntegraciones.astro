---
// Mapa de integraciones — los sistemas del CLIENTE conectados a Buffo.
//
// ⭐ POR QUÉ EXISTE (Simón, 4-sep-2026). Trajo heatlatam.com como referencia y
// pidió "exactamente el mismo, con fondo oscuro dentro de nuestra paleta, con
// matices y brillos". Lo que hace que ESO funcione —y que la hélice del hero,
// rechazada el mismo día, no funcionara— es que no es decoración: el dibujo
// dice una frase. La frase es la que va escrita al lado: no reemplazamos sus
// sistemas, los leemos donde están.
//
// ⚠️ EL RESPLANDOR ES UNA EXCEPCIÓN DELIBERADA, NO UN DESCUIDO.
// El diagnóstico del rediseño de agosto listaba el glow entre los tics que
// hacían ver el sitio "hecho con IA" y se limpió de todo el sitio. Vuelve acá
// por pedido explícito de Simón y CONTENIDO dentro de este panel: es una pieza
// cerrada, con su propio fondo oscuro, que no se derrama al resto de la página.
// Si aparece glow FUERA de este componente es un descuido; acá adentro es una
// decisión. No extenderlo a otras secciones sin preguntarle.
//
// ── EL ANILLO ──────────────────────────────────────────────────────────────
// Las posiciones eran un desorden a mano y Simón pidió ordenarlo. Ahora son
// tres por lado en un anillo simétrico. Se ganó lectura: con doce cosas
// alrededor, la simetría es lo que hace que se entienda de un vistazo; el
// desorden solo funciona con pocos elementos.
//
// ── LOGOS ──────────────────────────────────────────────────────────────────
// Los .svg de public/sistemas/ vienen de simple-icons y se pintan con el hex
// OFICIAL de cada marca. El trazo se lee en tiempo de BUILD y se incrusta: cero
// peticiones de red y ningún salto al pintar.
//
// ⛔ Excel y SQL Server van con glifo y no con logotipo, a propósito: Microsoft
// pidió que sus iconos se retiraran de simple-icons, y dibujarlos igual sería
// pasar por encima de una restricción del titular.
// ⛔ Defontana y Bsale no tienen marca vectorial pública: van con inicial.
//
// ── EL COLIBRÍ DEL CENTRO ──────────────────────────────────────────────────
// ⚠️ Va como PNG incrustado y no como trazo. El diseñador entregó el logotipo
// en PNG y .ai, nunca en SVG, y calcarlo a mano sería dibujar la marca de nuevo
// — el mismo motivo por el que el favicon vectorial se retiró en agosto.
// El isotipo original es TURQUESA y el hub también, así que sería invisible: se
// generó `isotipo-oscuro.png` conservando el alfa y cambiando el color al azul
// noche. Si algún día aparece el vectorial, se reemplaza y se borra ese PNG.
import { readFileSync, existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

const dirLogos = fileURLToPath(new URL('../../public/sistemas/', import.meta.url));
function trazo(archivo: string): string | null {
  const ruta = `${dirLogos}${archivo}.svg`;
  if (!existsSync(ruta)) return null;
  return readFileSync(ruta, 'utf8').match(/ d="([^"]+)"/)?.[1] ?? null;
}
const isotipo = `data:image/png;base64,${readFileSync(`${dirLogos}isotipo-oscuro.png`).toString('base64')}`;

const GLIFOS = {
  planilla: 'M3 4h18v16H3zM3 9h18M3 14h18M9 4v16M15 4v16',
  base: 'M4 6c0-1.1 3.6-2 8-2s8 .9 8 2-3.6 2-8 2-8-.9-8-2zM4 6v12c0 1.1 3.6 2 8 2s8-.9 8-2V6M4 12c0 1.1 3.6 2 8 2s8-.9 8-2',
} as const;

// ── geometría ──────────────────────────────────────────────────────────────
const W = 660, H = 660;
const CX = 330, CY = 330;
const HUB = 152;
const BI = CX - HUB / 2, BD = CX + HUB / 2, BA = CY - HUB / 2, BB = CY + HUB / 2;
const LADO = 58, R = LADO / 2;

type Nodo = {
  nombre: string; logo?: string; glifo?: keyof typeof GLIFOS; inicial?: string;
  hex: string; x: number; y: number; d: string;
};

// Tres por lado. `d` es el cable con codos rectos, entrando por el borde más
// cercano del hub; los de esquina salen de costado para no cruzar su rótulo.
const NODOS: Nodo[] = [
  // arriba
  { nombre: 'SAP', logo: 'sap', hex: '#0FAAFF', x: 176, y: 70, d: 'M 205 70 H 268 V 254' },
  { nombre: 'Defontana', inicial: 'D', hex: '#19D3C5', x: 330, y: 62, d: 'M 330 91 V 254' },
  { nombre: 'Odoo', logo: 'odoo', hex: '#A16B93', x: 484, y: 70, d: 'M 455 70 H 392 V 254' },

  // derecha
  { nombre: 'Sheets', logo: 'googlesheets', hex: '#34A853', x: 582, y: 206, d: 'M 553 206 H 460 V 292 H 406' },
  { nombre: 'Drive', logo: 'googledrive', hex: '#4285F4', x: 596, y: 330, d: 'M 567 330 H 406' },
  { nombre: 'Gmail', logo: 'gmail', hex: '#EA4335', x: 582, y: 454, d: 'M 553 454 H 460 V 368 H 406' },

  // abajo
  { nombre: 'Excel', glifo: 'planilla', hex: '#21A366', x: 484, y: 590, d: 'M 455 590 H 392 V 406' },
  { nombre: 'SQL Server', glifo: 'base', hex: '#E14B49', x: 330, y: 598, d: 'M 330 569 V 406' },
  { nombre: 'Bsale', inicial: 'B', hex: '#19D3C5', x: 176, y: 590, d: 'M 205 590 H 268 V 406' },

  // izquierda
  { nombre: 'Meta Ads', logo: 'meta', hex: '#0081FB', x: 78, y: 454, d: 'M 107 454 H 200 V 368 H 254' },
  { nombre: 'Google Ads', logo: 'googleads', hex: '#4285F4', x: 64, y: 330, d: 'M 93 330 H 254' },
  { nombre: 'WhatsApp', logo: 'whatsapp', hex: '#25D366', x: 78, y: 206, d: 'M 107 206 H 200 V 292 H 254' },
];

const rutas = NODOS.map((n) => ({ ...n, trazo: n.logo ? trazo(n.logo) : null }));
const TURNO = 1.9;                       // segundos que cada sistema queda encendido
const CICLO = (rutas.length * TURNO).toFixed(1);
---

<figure class="mapa" aria-labelledby="mapa-pie">
  <!-- ⚠️ En celular el SVG NO se encoge hasta caber: los rótulos quedarían
       ilegibles. Conserva un ancho mínimo y se desliza dentro de esta caja. La
       PÁGINA no gana scroll horizontal —eso sí está prohibido—, solo el mapa. -->
  <div class="riel" tabindex="0" role="group" aria-label="Mapa de integraciones, deslizable">
    <svg viewBox={`0 0 ${W} ${H}`} role="img"
         style={`--ciclo:${CICLO}s`}
         aria-label="Los sistemas que su empresa ya usa, conectados a Buffo">
      <defs>
        <radialGradient id="mi-fondo" cx="50%" cy="48%" r="72%">
          <stop offset="0%" stop-color="#0C3A52" />
          <stop offset="55%" stop-color="#082A3F" />
          <stop offset="100%" stop-color="#04151F" />
        </radialGradient>
        <linearGradient id="mi-hub" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#2BE8D8" />
          <stop offset="55%" stop-color="#19D3C5" />
          <stop offset="100%" stop-color="#0E8FA6" />
        </linearGradient>
        <linearGradient id="mi-borde" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#19D3C5" stop-opacity="0.34" />
          <stop offset="100%" stop-color="#19D3C5" stop-opacity="0.10" />
        </linearGradient>
        <filter id="mi-brillo" x="-70%" y="-70%" width="240%" height="240%">
          <feGaussianBlur stdDeviation="15" />
        </filter>
        <filter id="mi-realce" x="-120%" y="-120%" width="340%" height="340%">
          <feGaussianBlur stdDeviation="9" />
        </filter>
      </defs>

      <rect x="1" y="1" width={W - 2} height={H - 2} rx="24"
            fill="url(#mi-fondo)" stroke="url(#mi-borde)" stroke-width="1.5" />

      <g fill="none" stroke="#19D3C5" stroke-opacity="0.20" stroke-width="1.2"
         stroke-linecap="round" stroke-linejoin="round">
        {rutas.map((r) => <path d={r.d} />)}
      </g>

      <!-- el pulso: un guion corto recorriendo el MISMO cable hacia el centro -->
      <g class="pulsos" fill="none" stroke="#4FF3E4" stroke-width="2.4" stroke-linecap="round">
        {rutas.map((r, i) => <path d={r.d} style={`animation-delay:${(i * 0.47).toFixed(2)}s`} />)}
      </g>

      {rutas.map((r, i) => (
        <g class="nodo" style={`--turno:${(i * TURNO).toFixed(2)}s`}>
          {/* El realce que va pasando de sistema en sistema. En la referencia era
              UNO fijo; Simón lo quiso rotando, y así además dice algo: no es un
              adorno, es "ahora estoy leyendo este". */}
          <rect class="halo" x={r.x - R} y={r.y - R} width={LADO} height={LADO} rx="16"
                fill="none" stroke="#FFFFFF" stroke-width="3" filter="url(#mi-realce)" />
          <rect class="marco" x={r.x - R} y={r.y - R} width={LADO} height={LADO} rx="16"
                fill="#07222F" stroke="#19D3C5" stroke-opacity="0.18" stroke-width="1.2" />
          <rect class="marco-vivo" x={r.x - R} y={r.y - R} width={LADO} height={LADO} rx="16"
                fill="none" stroke="#FFFFFF" stroke-opacity="0.85" stroke-width="1.4" />
          {r.trazo ? (
            <g transform={`translate(${r.x - 15} ${r.y - 15}) scale(1.25)`}>
              <path d={r.trazo} fill={r.hex} />
            </g>
          ) : r.glifo ? (
            <g transform={`translate(${r.x - 14} ${r.y - 14}) scale(1.1667)`} fill="none"
               stroke={r.hex} stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d={GLIFOS[r.glifo]} />
            </g>
          ) : (
            <text x={r.x} y={r.y + 8} text-anchor="middle" class="inicial" fill={r.hex}>{r.inicial}</text>
          )}
          <text x={r.x} y={r.y + R + 19} text-anchor="middle" class="rotulo">{r.nombre}</text>
        </g>
      ))}

      <!-- el hub: su resplandor debajo, y encima la pieza con el colibrí -->
      <rect x={BI} y={BA} width={HUB} height={HUB} rx="37"
            fill="#19D3C5" opacity="0.42" filter="url(#mi-brillo)" />
      <rect x={BI} y={BA} width={HUB} height={HUB} rx="37" fill="url(#mi-hub)" />
      <image href={isotipo} x={CX - 31} y={BA + 26} width="62" height="62" preserveAspectRatio="xMidYMid meet" />
      <text x={CX} y={BB - 26} text-anchor="middle" class="marca">buffo<tspan class="punto">.</tspan></text>
    </svg>
  </div>

  <figcaption id="mapa-pie">
    Estos son los que más vemos. Si el suyo no está, igual se conecta.
  </figcaption>
</figure>

<style>
  .mapa { margin: 0; }

  .riel { overflow-x: auto; overflow-y: hidden; -webkit-overflow-scrolling: touch; border-radius: 24px; }
  .riel::-webkit-scrollbar { height: 4px; }
  .riel::-webkit-scrollbar-thumb { background: rgb(var(--c-primary) / 0.35); border-radius: 4px; }

  /* El halo exterior del panel va en CSS y no en el SVG porque tiene que
     desbordar la caja; dentro del viewBox quedaría recortado. */
  .mapa svg {
    display: block;
    width: 100%;
    height: auto;
    min-width: 520px;
    border-radius: 24px;
    box-shadow: 0 0 80px -24px rgb(25 211 197 / 0.30), 0 20px 50px -28px rgb(4 21 31 / 0.7);
  }
  @media (min-width: 620px) { .mapa svg { min-width: 0; } }

  /* Guion corto y hueco largo: el cable queda vacío casi todo el ciclo, así el
     conjunto respira en vez de parpadear. */
  .pulsos path {
    stroke-dasharray: 12 620;
    stroke-dashoffset: 632;
    animation: correr 5s linear infinite;
    filter: drop-shadow(0 0 4px rgb(79 243 228 / 0.85));
  }
  @keyframes correr { to { stroke-dashoffset: 0; } }

  /* El realce recorre los sistemas de a uno. El desfase es el turno de cada
     baldosa dentro del ciclo completo; con doce, cada una se enciende una vez
     por vuelta y el ojo siempre tiene un solo punto al que ir. */
  .halo, .marco-vivo {
    opacity: 0;
    animation: turno var(--ciclo) linear infinite;
    animation-delay: var(--turno);
  }
  .halo { animation-name: turno-halo; }
  @keyframes turno {
    0%, 8.34%, 100% { opacity: 0; }
    1.2%, 6.5% { opacity: 1; }
  }
  @keyframes turno-halo {
    0%, 8.34%, 100% { opacity: 0; }
    1.2%, 6.5% { opacity: 0.55; }
  }

  .rotulo { fill: #BCD6E0; font-size: 13px; font-weight: 500; }
  .inicial { font-size: 24px; font-weight: 800; letter-spacing: -0.02em; }
  .marca { fill: #04222C; font-size: 27px; font-weight: 800; letter-spacing: -0.03em; }
  .marca .punto { fill: #FFFFFF; }

  figcaption {
    margin: 1.1rem 0 0;
    font-size: 0.85rem;
    line-height: 1.55;
    color: rgb(var(--c-on-surface-variant) / 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .pulsos path { animation: none; stroke-dasharray: none; stroke-dashoffset: 0; opacity: 0.35; filter: none; }
    .halo, .marco-vivo { animation: none; opacity: 0; }
  }
</style>
