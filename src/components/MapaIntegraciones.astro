---
// Mapa de integraciones — los sistemas del CLIENTE conectados a Buffo.
//
// ⭐ POR QUÉ EXISTE (Simón, 4-sep-2026). Trajo heatlatam.com como referencia:
// el producto al centro, las herramientas alrededor, pulsos viajando por las
// líneas. Lo que hace que ESO funcione —y que la hélice del hero, rechazada el
// mismo día, no funcionara— es que no es decoración: el dibujo dice una frase.
// La memoria del rediseño ya lo tenía escrito: "lo que de verdad hace que algo
// no se vea hecho con IA es que una decisión visual tenga una razón detrás".
//
// La frase que dice este diagrama es la que ya estaba escrita al lado sin
// ninguna imagen que la sostuviera: «No reemplazamos sus sistemas: los leemos».
// Por eso son los sistemas del cliente y NO nuestro stack: el carrusel de
// Anthropic/React/Vercel que el sitio ya tiene son nuestras herramientas, no
// los problemas de un gerente.
//
// ⚠️ SE ROBÓ LA IDEA, NO LA PIEL. Heat va con morado neón sobre casi negro y
// resplandor en todo — el look del que este sitio se salió a propósito. Acá:
// líneas finas, la paleta del sitio, y el color lo ponen los logotipos.
//
// ── LOGOS ──────────────────────────────────────────────────────────────────
// Los `.svg` de public/sistemas/ vienen de simple-icons y se pintan con el hex
// OFICIAL de cada marca. Se leen en tiempo de build y se incrustan: cero
// peticiones de red y ningún salto al pintar.
//
// ⛔ Excel y SQL Server van como MARCA DENOMINATIVA, no como logotipo, y es a
// propósito: Microsoft pidió que sus iconos se retiraran de simple-icons.
// Dibujarlos igual sería pasar por encima de una restricción del titular. El
// nombre en su color de marca dice lo mismo sin ese problema.
//
// ⛔ Defontana, Bsale, Softland y KAME no tienen marca vectorial pública, así
// que también van como texto. Además, escrito así el diagrama no insinúa una
// alianza comercial que no existe: dice "leemos esto", no "somos partners".
import { readFileSync, existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

const dirLogos = fileURLToPath(new URL('../../public/sistemas/', import.meta.url));

// Del SVG de simple-icons solo interesa el trazo: el resto se arma acá para
// poder darle el color, el tamaño y el encuadre que necesita este diagrama.
function trazo(archivo: string): string | null {
  const ruta = `${dirLogos}${archivo}.svg`;
  if (!existsSync(ruta)) return null;
  return readFileSync(ruta, 'utf8').match(/ d="([^"]+)"/)?.[1] ?? null;
}

// ── los sistemas ───────────────────────────────────────────────────────────
// Elegidos por lo que de verdad aparece en los clientes: los ERP que usan, la
// planilla donde termina todo, y de dónde sale el dato de marketing.
// `x`/`y` están puestos a mano y a propósito descolocados: una grilla perfecta
// se lee como plantilla; el desorden ordenado se lee como diagrama.
type Nodo = { nombre: string; logo?: string; glifo?: 'planilla' | 'base'; inicial?: string;
              hex: string; x: number; y: number; bus: number; entrada: number; lado: 'izq' | 'der' };

// Para los que no tienen logotipo: un glifo cuando la cosa tiene forma evidente
// (una planilla, una base de datos) y UNA inicial cuando no. Se probó con
// siglas de dos letras — "DE", "BS", "EX" — y se leían como un error de carga.
const GLIFOS = {
  planilla: 'M3 4h18v16H3zM3 9h18M3 14h18M9 4v16M15 4v16',
  base: 'M4 6c0-1.1 3.6-2 8-2s8 .9 8 2-3.6 2-8 2-8-.9-8-2zM4 6v12c0 1.1 3.6 2 8 2s8-.9 8-2V6M4 12c0 1.1 3.6 2 8 2s8-.9 8-2',
} as const;

const NODOS: Nodo[] = [
  // izquierda — de dónde sale el dato
  { nombre: 'SAP',           logo: 'sap',          hex: '#0FAAFF', x: 168, y: 86,  bus: 392, entrada: 214, lado: 'izq' },
  { nombre: 'Defontana', inicial: 'D',             hex: '#0E9E93', x: 330, y: 46,  bus: 428, entrada: 228, lado: 'izq' },
  { nombre: 'Odoo',          logo: 'odoo',         hex: '#714B67', x: 84,  y: 262, bus: 358, entrada: 242, lado: 'izq' },
  { nombre: 'Bsale', inicial: 'B',                 hex: '#0E9E93', x: 262, y: 232, bus: 452, entrada: 256, lado: 'izq' },
  { nombre: 'Excel', glifo: 'planilla',            hex: '#217346', x: 160, y: 424, bus: 392, entrada: 292, lado: 'izq' },
  { nombre: 'SQL Server', glifo: 'base',           hex: '#CC2927', x: 344, y: 458, bus: 428, entrada: 306, lado: 'izq' },

  // derecha — dónde vive el resto
  { nombre: 'Google Sheets', logo: 'googlesheets', hex: '#34A853', x: 878,  y: 62,  bus: 800, entrada: 214, lado: 'der' },
  { nombre: 'Drive',         logo: 'googledrive',  hex: '#4285F4', x: 1046, y: 118, bus: 764, entrada: 228, lado: 'der' },
  { nombre: 'Gmail',         logo: 'gmail',        hex: '#EA4335', x: 946,  y: 258, bus: 838, entrada: 242, lado: 'der' },
  { nombre: 'WhatsApp',      logo: 'whatsapp',     hex: '#25D366', x: 1108, y: 300, bus: 740, entrada: 256, lado: 'der' },
  { nombre: 'Google Ads',    logo: 'googleads',    hex: '#4285F4', x: 892,  y: 432, bus: 800, entrada: 292, lado: 'der' },
  { nombre: 'Meta Ads',      logo: 'meta',         hex: '#0081FB', x: 1054, y: 470, bus: 764, entrada: 306, lado: 'der' },
];

// ── geometría ──────────────────────────────────────────────────────────────
// Todo en un viewBox fijo: el SVG escala solo, sin cálculos en el navegador y
// sin que haya que sincronizar posiciones de HTML con las líneas.
const W = 1200, H = 540;
const CX = 600, CY = 260;
const HUB_W = 176, HUB_H = 104;
const HUB_IZQ = CX - HUB_W / 2, HUB_DER = CX + HUB_W / 2;
const LADO = 62;

const rutas = NODOS.map((n) => ({
  ...n,
  d: n.lado === 'izq'
    ? `M ${n.x + LADO / 2} ${n.y} H ${n.bus} V ${n.entrada} H ${HUB_IZQ}`
    : `M ${n.x - LADO / 2} ${n.y} H ${n.bus} V ${n.entrada} H ${HUB_DER}`,
  trazo: n.logo ? trazo(n.logo) : null,
}));
---

<figure class="mapa" aria-labelledby="mapa-pie">
  <!-- ⚠️ En celular el SVG NO se encoge hasta caber: a 390 px un lienzo de 1200
       deja los rótulos en 4 px, ilegibles. Conserva su ancho mínimo y se desliza
       dentro de esta caja. La PÁGINA no gana scroll horizontal —eso sí está
       prohibido—, solo el mapa, que es un gesto que el visitante entiende. -->
  <div class="riel" tabindex="0" role="group" aria-label="Mapa de integraciones, deslizable">
  <svg viewBox={`0 0 ${W} ${H}`} role="img"
       aria-label="Los sistemas que su empresa ya usa, conectados a Buffo">

    <!-- las líneas, quietas -->
    <g class="hilos" fill="none" stroke="currentColor" stroke-width="1.25"
       stroke-linecap="round" stroke-linejoin="round">
      {rutas.map((r) => <path d={r.d} />)}
    </g>

    <!-- el pulso: un guion corto recorriendo la MISMA línea hacia el centro.
         Es stroke-dashoffset animado, no una librería. Los desfases no son
         múltiplos entre sí para que nunca lleguen todos juntos. -->
    <g class="pulsos" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round">
      {rutas.map((r, i) => <path d={r.d} style={`animation-delay:${(i * 0.61).toFixed(2)}s`} />)}
    </g>

    <!-- los sistemas del cliente -->
    {rutas.map((r) => (
      <g class="nodo">
        <rect x={r.x - LADO / 2} y={r.y - LADO / 2} width={LADO} height={LADO} rx="17" />
        {r.trazo ? (
          <g transform={`translate(${r.x - 16} ${r.y - 16}) scale(1.3333)`}>
            <path d={r.trazo} fill={r.hex} />
          </g>
        ) : r.glifo ? (
          <g transform={`translate(${r.x - 15} ${r.y - 15}) scale(1.25)`} fill="none"
             stroke={r.hex} stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d={GLIFOS[r.glifo]} />
          </g>
        ) : (
          <text x={r.x} y={r.y + 8} text-anchor="middle" class="inicial" fill={r.hex}>{r.inicial}</text>
        )}
        <text x={r.x} y={r.y + LADO / 2 + 19} text-anchor="middle" class="rotulo">{r.nombre}</text>
      </g>
    ))}

    <!-- el hub -->
    <g class="hub">
      <rect x={HUB_IZQ} y={CY - HUB_H / 2} width={HUB_W} height={HUB_H} rx="20" />
      <text x={CX} y={CY + 2} text-anchor="middle" class="marca">buffo<tspan class="punto">.</tspan></text>
      <text x={CX} y={CY + 26} text-anchor="middle" class="marca-pie">IA CONSULTING</text>
    </g>
  </svg>
  </div>

  <figcaption id="mapa-pie">
    Estos son los que más vemos. Si el suyo no está, igual se conecta.
  </figcaption>
</figure>

<style>
  .mapa { margin: 0; }
  .riel { overflow-x: auto; overflow-y: hidden; -webkit-overflow-scrolling: touch; }
  .riel::-webkit-scrollbar { height: 4px; }
  .riel::-webkit-scrollbar-thumb { background: rgb(var(--c-primary) / 0.35); border-radius: 4px; }
  .mapa svg { display: block; width: 100%; height: auto; min-width: 880px; }
  /* Desde que cabe entero, el ancho mínimo estorba: se saca. */
  @media (min-width: 940px) { .mapa svg { min-width: 0; } }

  .hilos  { color: rgb(var(--c-primary) / 0.30); }
  .pulsos { color: rgb(var(--c-primary) / 0.95); }

  /* Guion corto y hueco largo: la línea queda vacía casi todo el ciclo, así el
     conjunto respira en vez de parpadear. */
  .pulsos path {
    stroke-dasharray: 12 900;
    stroke-dashoffset: 912;
    animation: correr 6.5s linear infinite;
  }
  @keyframes correr { to { stroke-dashoffset: 0; } }

  /* La baldosa es del color de la superficie, no un gris inventado: en claro es
     blanca y en oscuro es el azul del sitio, y el único color lo pone el logo. */
  .nodo rect {
    fill: rgb(var(--c-container-high) / 1);
    stroke: rgb(var(--c-outline-variant) / 1);
    stroke-width: 1;
  }
  .rotulo {
    fill: rgb(var(--c-on-surface-variant) / 1);
    font-size: 13px;
    font-weight: 500;
  }
  .inicial { font-size: 25px; font-weight: 800; letter-spacing: -0.02em; }

  .hub rect {
    fill: rgb(var(--c-primary) / 0.12);
    stroke: rgb(var(--c-primary) / 0.6);
    stroke-width: 1.5;
  }
  .marca {
    fill: rgb(var(--c-on-surface) / 1);
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .marca .punto { fill: rgb(var(--c-primary) / 1); }
  .marca-pie {
    fill: rgb(var(--c-primary) / 0.9);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.24em;
  }

  figcaption {
    margin: 1.4rem auto 0;
    max-width: 46rem;
    text-align: center;
    font-size: 0.9rem;
    line-height: 1.55;
    color: rgb(var(--c-on-surface-variant) / 1);
  }

  /* Quien pidió menos movimiento ve el diagrama completo y quieto: el dibujo ya
     dice lo que tiene que decir sin que nada se mueva. */
  @media (prefers-reduced-motion: reduce) {
    .pulsos path { animation: none; stroke-dasharray: none; stroke-dashoffset: 0; opacity: 0.3; }
  }
</style>
