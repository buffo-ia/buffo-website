---
/**
 * Muestra del informe que recibe quien completa el diagnóstico.
 *
 * Responde la pregunta que se hace un prospecto frío frente al botón
 * "Empezar": ¿qué me llevo por tres minutos? Antes esa mitad de la pantalla
 * estaba vacía y la pregunta quedaba sin contestar.
 *
 * La hoja va SIEMPRE clara, dé lo mismo el tema del visitante. No es un
 * descuido: el informe se imprime siempre en claro (ver la regla de impresión
 * en global.css), así que esto es una pieza que vive en su propio fondo, no
 * una que sigue al tema. Por eso lleva colores fijos y no tokens.
 *
 * Datos ilustrativos: es una muestra de formato, no el resultado de nadie.
 */
const PUNTAJE = 47; // cae en el tramo "Con esfuerzo"
const TRAMO = 'Con esfuerzo';

const HALLAZGOS = [
  { grave: 'alto', texto: 'El cierre comercial depende de una planilla que consolida una sola persona.' },
  { grave: 'alto', texto: 'El quiebre de stock se detecta cuando el cliente reclama, no antes.' },
  { grave: 'medio', texto: 'Hay reportes por área, pero las cifras no cuadran entre sistemas.' },
];

const R = 34;
const CIRC = 2 * Math.PI * R;
---

<div class="informe" aria-label="Muestra del informe en PDF">
  <div class="hoja">
    <!-- membrete -->
    <div class="membrete">
      <span class="marca">buffo <b>IA</b> consulting</span>
      <span class="sello">Informe · PDF</span>
    </div>

    <p class="cejilla">Diagnóstico de visibilidad operacional</p>
    <h3 class="titulo">Su operación hoy</h3>

    <!-- puntaje -->
    <div class="puntaje">
      <svg viewBox="0 0 84 84" width="84" height="84" aria-hidden="true">
        <circle cx="42" cy="42" r={R} class="pista" />
        <circle
          cx="42" cy="42" r={R} class="avance"
          stroke-dasharray={CIRC}
          style={`--largo:${CIRC}; --hasta:${CIRC * (1 - PUNTAJE / 100)}`}
        />
      </svg>
      <div>
        <div class="cifra">{PUNTAJE}<span>/100</span></div>
        <div class="tramo">{TRAMO}</div>
      </div>
    </div>

    <!-- hallazgos -->
    <p class="subtitulo">Lo que detectamos</p>
    <ul class="hallazgos">
      {HALLAZGOS.map((h, i) => (
        <li style={`--i:${i}`}>
          <span class:list={['punto', h.grave]} aria-hidden="true"></span>
          <span>{h.texto}</span>
        </li>
      ))}
    </ul>

    <!-- el corte: se ve que el documento sigue -->
    <p class="subtitulo">Qué se puede resolver</p>
    <div class="lineas" aria-hidden="true">
      <span style="width:92%"></span>
      <span style="width:70%"></span>
    </div>
    <div class="corte" aria-hidden="true"></div>
  </div>

  <p class="pie">Muestra del formato. El informe real usa sus respuestas.</p>
</div>

<style>
  /* Paleta fija: el documento no sigue al tema (ver comentario de arriba). */
  .informe {
    --tinta: #101815;
    --tinta-suave: #4f5b56;
    --papel: #ffffff;
    --verde: #0b7340;
    --linea: #e2e8e5;
  }

  .hoja {
    background: var(--papel);
    color: var(--tinta);
    padding: 1.4rem;
    border: 1px solid var(--linea);
    /* Elevación hacia el blanco, como el resto de las tarjetas en claro. */
    box-shadow:
      0 1px 2px rgb(16 24 21 / 0.06),
      0 10px 24px -8px rgb(16 24 21 / 0.14),
      0 30px 60px -24px rgb(16 24 21 / 0.22);
    position: relative;
    overflow: hidden;
  }

  .membrete {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--linea);
  }
  .marca {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .marca b {
    color: var(--verde);
    font-weight: 600;
  }
  .sello {
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--tinta-suave);
  }

  .cejilla {
    margin-top: 1.25rem;
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--verde);
  }
  .titulo {
    margin-top: 0.35rem;
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .puntaje {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.9rem;
  }
  .pista {
    fill: none;
    stroke: var(--linea);
    stroke-width: 7;
  }
  .avance {
    fill: none;
    stroke: var(--verde);
    stroke-width: 7;
    stroke-linecap: round;
    transform: rotate(-90deg);
    transform-origin: 50% 50%;
    stroke-dashoffset: var(--largo);
    animation: llenar 1.1s cubic-bezier(0.4, 0, 0.2, 1) 0.35s forwards;
  }
  @keyframes llenar {
    to {
      stroke-dashoffset: var(--hasta);
    }
  }
  .cifra {
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .cifra span {
    font-size: 0.9rem;
    color: var(--tinta-suave);
    letter-spacing: -0.02em;
  }
  .tramo {
    margin-top: 0.3rem;
    font-size: 0.8rem;
    color: var(--tinta-suave);
  }

  .subtitulo {
    margin-top: 1.1rem;
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--tinta-suave);
  }

  .hallazgos {
    margin-top: 0.6rem;
    display: grid;
    gap: 0.55rem;
    list-style: none;
    padding: 0;
  }
  .hallazgos li {
    display: flex;
    gap: 0.6rem;
    font-size: 0.82rem;
    line-height: 1.45;
    opacity: 0;
    animation: entrar 0.45s ease-out forwards;
    animation-delay: calc(0.6s + var(--i) * 0.12s);
  }
  @keyframes entrar {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .punto {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    margin-top: 0.42rem;
    flex: none;
  }
  .punto.alto {
    background: #b0261e;
  }
  .punto.medio {
    background: #b8860b;
  }

  .lineas {
    margin-top: 0.7rem;
    display: grid;
    gap: 0.45rem;
  }
  .lineas span {
    height: 6px;
    background: var(--linea);
    display: block;
  }

  /* El documento se desvanece abajo: deja claro que hay más y que esto es
     solo la portada. Sin esto parece un informe de media página. */
  .corte {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 5.5rem;
    background: linear-gradient(to bottom, rgb(255 255 255 / 0), var(--papel) 78%);
  }

  .pie {
    margin-top: 0.85rem;
    font-size: 0.72rem;
    color: rgb(var(--c-on-surface-variant));
  }

  @media (prefers-reduced-motion: reduce) {
    .avance {
      animation: none;
      stroke-dashoffset: var(--hasta);
    }
    .hallazgos li {
      animation: none;
      opacity: 1;
    }
  }
</style>
