---
/**
 * Muestra del informe que recibe quien completa el diagnóstico.
 *
 * Responde la pregunta que se hace un prospecto frío frente al botón
 * "Empezar": ¿qué me llevo por tres minutos? Antes esa mitad de la pantalla
 * estaba vacía y la pregunta quedaba sin contestar.
 *
 * La hoja va SIEMPRE clara, dé lo mismo el tema del visitante. No es un
 * descuido: el informe se imprime siempre en claro (ver la regla de impresión
 * en global.css), así que esto es una pieza que vive en su propio fondo, no
 * una que sigue al tema. Por eso lleva colores fijos y no tokens.
 *
 * Datos ilustrativos: es una muestra de formato, no el resultado de nadie.
 */
import { valorHora } from '../data/diagnostico';
const PUNTAJE = 47; // cae en el tramo "Con esfuerzo"
const TRAMO = 'Con esfuerzo';

// La cifra NO se inventa: sale de valorHora(), la misma función con la que el
// informe real calcula el costo. Si mañana cambia el sueldo base o la jornada
// legal, esta muestra se corrige sola y nunca promete un número que el informe
// no vaya a entregar.
const HORAS_MES = [20, 60];
const ANUAL = HORAS_MES.map((h) => h * 12 * valorHora());
const pesos = (n) => '$' + Math.round(n).toLocaleString('es-CL');

const HALLAZGOS = [
  { grave: 'alto', texto: 'El cierre comercial depende de una planilla que consolida una sola persona.' },
  { grave: 'alto', texto: 'El quiebre de stock se detecta cuando el cliente reclama, no antes.' },
  { grave: 'medio', texto: 'Hay reportes por área, pero las cifras no cuadran entre sistemas.' },
];

const R = 26;
const CIRC = 2 * Math.PI * R;
---

<div class="informe" aria-label="Muestra del informe en PDF">
  <div class="pila">
    <!-- Dos hojas asomando detrás. Dicen "esto es un documento de varias
         páginas" sin obligar a leer nada, que es lo que un prospecto hace de
         verdad con un PDF de muestra: lo reconoce, no lo lee. Cuestan 14 px de
         alto; meter las nueve secciones en esta columna habría costado
         tipografía de 8 px, o sea textura en vez de información. -->
    <div class="hoja-fondo hoja-fondo-2" aria-hidden="true"></div>
    <div class="hoja-fondo" aria-hidden="true"></div>
  <div class="hoja">
    <!-- membrete -->
    <div class="membrete">
      <img src="/logo-firma.png" alt="Buffo IA Consulting" class="marca" />
      <span class="sello">
        <span class="material-symbols-outlined" aria-hidden="true">picture_as_pdf</span>
        Informe · PDF
      </span>
    </div>

    <p class="cejilla">Diagnóstico de visibilidad operacional</p>
    <h3 class="titulo">Su operación hoy</h3>

    <!-- La plata primero. Pone el problema en pesos, que es el idioma en que
         decide un gerente, y es lo único de esta muestra que nombra una
         consecuencia. Va arriba porque la hoja se recorta por abajo cuando la
         pantalla es baja: lo que va primero es lo que sobrevive al corte. -->
    <div class="plata">
      <p class="plata-rotulo">Lo que le cuesta al año el trabajo repetitivo</p>
      <p class="plata-cifra">{pesos(ANUAL[0])} <span>a</span> {pesos(ANUAL[1])}</p>
    </div>

    <!-- Puntaje. Va compacto y NO de protagonista: el sitio promete "no
         entregamos un número sin interpretación", así que un 47 gigante como
         elemento dominante decía justo lo contrario de lo que vendemos. -->
    <div class="puntaje">
      <svg viewBox="0 0 64 64" width="64" height="64" aria-hidden="true">
        <circle cx="32" cy="32" r={R} class="pista" />
        <circle
          cx="32" cy="32" r={R} class="avance"
          stroke-dasharray={CIRC}
          style={`--largo:${CIRC}; --hasta:${CIRC * (1 - PUNTAJE / 100)}`}
        />
      </svg>
      <div>
        <div class="cifra">{PUNTAJE}<span>/100</span></div>
        <div class="tramo">{TRAMO}</div>
      </div>
    </div>

    <!-- hallazgos -->
    <p class="subtitulo">Lo que detectamos</p>
    <ul class="hallazgos">
      {HALLAZGOS.map((h, i) => (
        <li style={`--i:${i}`}>
          <span class:list={['punto', h.grave]} aria-hidden="true"></span>
          <span>{h.texto}</span>
        </li>
      ))}
    </ul>

    <!-- Y el qué hacer. Sin esto la muestra decía solo lo que pasó, que es
         justo lo que hace cualquier test: el diferenciador declarado de Buffo
         es "su sistema le dice lo que pasó, nosotros le decimos qué hacer". -->
    <p class="subtitulo">Lo que proponemos</p>
    <p class="propuesta">
      Consolidar el cierre comercial en una fuente única y dejarlo corriendo solo. Primer tablero
      en operación en cuatro semanas.
    </p>

    <!-- El corte, y nada más: el degradado ya dice que el documento sigue.
         El bloque "Qué se puede resolver" con sus líneas de relleno decía lo
         mismo y costaba 55 px de la primera pantalla, que es justo donde se
         decide si esta persona aprieta Empezar. -->
    <div class="corte" aria-hidden="true"></div>
  </div>
  </div>

  <p class="pie">Muestra del formato · 9 secciones · El informe real usa sus respuestas.</p>
</div>

<style>
  /* Paleta fija: el documento no sigue al tema (ver comentario de arriba). */
  .informe {
    --tinta: #101815;
    --tinta-suave: #4f5b56;
    --papel: #ffffff;
    --verde: #0b7340;
    --linea: #e2e8e5;
  }

  .pila {
    position: relative;
  }
  .hoja-fondo {
    position: absolute;
    left: 0.5rem;
    right: -0.5rem;
    top: -0.45rem;
    bottom: 0.45rem;
    background: var(--papel);
    border: 1px solid var(--linea);
    box-shadow: 0 6px 16px -8px rgb(16 24 21 / 0.18);
  }
  .hoja-fondo-2 {
    left: 1rem;
    right: -1rem;
    top: -0.9rem;
    bottom: 0.9rem;
    opacity: 0.6;
  }

  .hoja {
    background: var(--papel);
    color: var(--tinta);
    padding: 1.4rem;
    border: 1px solid var(--linea);
    /* Elevación hacia el blanco, como el resto de las tarjetas en claro. */
    box-shadow:
      0 1px 2px rgb(16 24 21 / 0.06),
      0 10px 24px -8px rgb(16 24 21 / 0.14),
      0 30px 60px -24px rgb(16 24 21 / 0.22);
    position: relative;
    z-index: 1;
    overflow: hidden;
  }

  .membrete {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--linea);
  }
  .marca {
    height: 1.15rem;
    width: auto;
    display: block;
  }
  .marca b {
    color: var(--verde);
    font-weight: 600;
  }
  .sello {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    color: var(--tinta-suave);
    white-space: nowrap;
  }
  /* El ícono es el genérico de documento PDF, no el logotipo de Adobe: meter
     una marca ajena adentro de nuestro entregable no dice nada nuestro y nos
     obligaría a respetar SUS reglas de uso. */
  .sello .material-symbols-outlined {
    font-size: 0.95rem;
    color: var(--verde);
  }

  .cejilla {
    margin-top: 1.25rem;
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--verde);
  }
  .titulo {
    margin-top: 0.35rem;
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .puntaje {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.9rem;
  }
  .pista {
    fill: none;
    stroke: var(--linea);
    stroke-width: 7;
  }
  .avance {
    fill: none;
    stroke: var(--verde);
    stroke-width: 7;
    stroke-linecap: round;
    transform: rotate(-90deg);
    transform-origin: 50% 50%;
    stroke-dashoffset: var(--largo);
    animation: llenar 1.1s cubic-bezier(0.4, 0, 0.2, 1) 0.35s forwards;
  }
  @keyframes llenar {
    to {
      stroke-dashoffset: var(--hasta);
    }
  }
  .cifra {
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .cifra span {
    font-size: 0.9rem;
    color: var(--tinta-suave);
    letter-spacing: -0.02em;
  }
  .tramo {
    margin-top: 0.3rem;
    font-size: 0.8rem;
    color: var(--tinta-suave);
  }

  .plata {
    margin-top: 0.9rem;
    border: 1px solid var(--verde);
    background: #f4faf7;
    padding: 0.7rem 0.85rem;
  }
  .plata-rotulo {
    margin: 0;
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    color: var(--tinta-suave);
  }
  .plata-cifra {
    margin: 0.3rem 0 0;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.1;
    color: var(--verde);
  }
  .plata-cifra span {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--tinta-suave);
  }

  .propuesta {
    margin-top: 0.5rem;
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--tinta-suave);
  }

  .subtitulo {
    margin-top: 1.1rem;
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--tinta-suave);
  }

  .hallazgos {
    margin-top: 0.6rem;
    display: grid;
    gap: 0.55rem;
    list-style: none;
    padding: 0;
  }
  .hallazgos li {
    display: flex;
    gap: 0.6rem;
    font-size: 0.82rem;
    line-height: 1.45;
    opacity: 0;
    animation: entrar 0.45s ease-out forwards;
    animation-delay: calc(0.6s + var(--i) * 0.12s);
  }
  @keyframes entrar {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .punto {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    margin-top: 0.42rem;
    flex: none;
  }
  .punto.alto {
    background: #b0261e;
  }
  .punto.medio {
    background: #b8860b;
  }

  .lineas {
    margin-top: 0.7rem;
    display: grid;
    gap: 0.45rem;
  }
  .lineas span {
    height: 6px;
    background: var(--linea);
    display: block;
  }

  /* El documento se desvanece abajo: deja claro que hay más y que esto es
     solo la portada. Sin esto parece un informe de media página. */
  /* En un notebook de 13" a 15" el alto útil del navegador es de 600 a 750 px,
     no los 900 y tantos de un monitor de escritorio. Ahí este mockup es lo que
     decide si el visitante alcanza a ver qué hace Buffo antes de tener que
     hacer scroll, así que se recorta por ALTURA de ventana.
     No hace falta inventar nada para que se vea bien cortado: .hoja ya tiene
     overflow hidden y el degradado de .corte encima, que es justo lo que
     comunica "el documento sigue". */
  @media (max-height: 960px) {
    .hoja { max-height: 420px; }
  }
  @media (max-height: 820px) {
    .hoja { max-height: 330px; }
    .pie { display: none; }
  }
  @media (max-height: 760px) {
    .hoja { max-height: 275px; }
    /* Degradado más corto: con 5.5rem se comía el bloque de la cifra. */
    .corte { height: 2.5rem; }
  }

  .corte {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 5.5rem;
    background: linear-gradient(to bottom, rgb(255 255 255 / 0), var(--papel) 78%);
  }

  .pie {
    margin-top: 0.85rem;
    font-size: 0.72rem;
    color: rgb(var(--c-on-surface-variant));
  }

  @media (prefers-reduced-motion: reduce) {
    .avance {
      animation: none;
      stroke-dashoffset: var(--hasta);
    }
    .hallazgos li {
      animation: none;
      opacity: 1;
    }
  }
</style>
