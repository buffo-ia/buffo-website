---
// Casos y quién está detrás (recorte del home propuesto por Comercial,
// 12-oct-2026). El home dice dos veces «el criterio de quien tuvo que
// responder por esos números» sin decir quién; este bloque es el lugar.
//
// ⛔ ESPACIO ARMADO, CONTENIDO PENDIENTE. Todo lo que va entre corchetes es
// relleno a la vista: lo redacta Comercial y lo aprueba Simón. No se inventan
// casos ni cifras de clientes, y este bloque no se publica con relleno.
const CASOS = ['[Caso 1 · pendiente]', '[Caso 2 · pendiente]', '[Caso 3 · pendiente]'];
---

<section class="v2-seccion v2-respaldo">
  <div class="v2-marco">
    <div class="v2-cabeza v2-e-sube" data-v2-entra>
      <p class="v2-indice">Quién responde</p>
      <h2 class="v2-titulo">[Titular pendiente] <em>[casos y quién está detrás]</em></h2>
    </div>
    <div class="v2-rejilla v2-e-sube" data-v2-entra="0.7">
      {
        CASOS.map((c) => (
          <div class="v2-celda v2-respaldo__pendiente">
            <p class="v2-celda__rotulo">{c}</p>
            <p class="v2-celda__chica">[Rubro del cliente, qué decisión se mejoró y qué cambió. Texto de Comercial, aprobado por Simón.]</p>
          </div>
        ))
      }
      <div class="v2-celda v2-celda--ancha v2-respaldo__pendiente">
        <p class="v2-celda__rotulo">[Quién está detrás · pendiente]</p>
        <p class="v2-celda__chica">[Quién es la persona que «tuvo que responder por esos números»: nombre, trayectoria y por qué importa para un gerente. Texto de Comercial, aprobado por Simón.]</p>
      </div>
      <div class="v2-celda v2-respaldo__pendiente">
        <p class="v2-celda__rotulo">[Dato de respaldo · pendiente]</p>
        <p class="v2-celda__chica">[Solo si existe y es verificable.]</p>
      </div>
    </div>
  </div>
</section>
