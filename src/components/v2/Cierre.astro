---
// Cierre de la portada: la frase y los mismos dos botones del principio.
import { SITE } from '../../config/site';

// Provisorio: son los temas de decisión que ya nombra la línea 01.
const OPCIONES = ['Precios', 'Margen', 'Metas de venta', 'Cobranza', 'Stock'];
---

<section class="v2-seccion v2-cierre">
  <div class="v2-marco v2-e-sube" data-v2-entra="0.6">
    <h2 class="v2-cierre__frase">
      Conversemos sobre la próxima <em>decisión estratégica de su empresa.</em>
    </h2>
    <!-- El cierre pregunta en vez de pedir (referencia: Framer, 12-oct-2026):
         cada opción lleva al diagnóstico. Todas cuentan como la posición
         «cierre» del evento clic_cta_diagnostico. -->
    <div class="v2-elegir">
      <p class="v2-elegir__pregunta">¿Qué decisión quiere mejorar?</p>
      <div class="v2-elegir__opciones">
        {
          OPCIONES.map((o) => (
            <a href="/diagnostico" data-cta-diagnostico="cierre">{o}</a>
          ))
        }
        <a href="/diagnostico" data-cta-diagnostico="cierre" class="v2-elegir__ir">
          Empezar el diagnóstico en 3 minutos
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
      </div>
    </div>
    <p class="v2-cierre__otra">
      ¿Prefiere conversarlo? <a href={SITE.calendly} target="_blank" rel="noopener noreferrer" class="v2-enlace">Agendar 30 minutos</a>
    </p>
    <p class="v2-nota">Sin costo. El informe llega a su correo al terminar el diagnóstico.</p>
  </div>
</section>
