---
// Cierre de la portada: la frase y los mismos dos botones del principio.
import { SITE } from '../../config/site';
---

<section class="v2-seccion v2-cierre">
  <div class="v2-marco v2-e-sube" data-v2-entra="0.6">
    <h2 class="v2-cierre__frase">
      La próxima decisión importante ya está esperando <em>un dato que todavía no llega.</em>
    </h2>
    <div class="v2-botones">
      <a href="/diagnostico" data-cta-diagnostico="cierre" class="v2-boton v2-boton--principal">
        Empezar el diagnóstico · 3 minutos
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
      <a href={SITE.calendly} target="_blank" rel="noopener noreferrer" class="v2-boton v2-boton--segundo">
        Agendar 30 minutos
      </a>
    </div>
    <p class="v2-nota">Sin costo y sin presentación de ventas. El informe llega a su correo apenas termina.</p>
  </div>
</section>
