---
// Cintas de luz del sitio 2.0: el fondo animado del bloque negro.
//
// Es un lienzo 2D, sin librerías: dos cintas hechas de hebras finas que se
// suman entre sí (`lighter`), así donde se cruzan se encienden solas. La forma
// de cada cinta depende del avance del scroll por el bloque, que es lo que hace
// que «cambien al bajar».
//
// Cuidados de rendimiento, porque esta página es el destino de la pauta:
//  · en celular hay la mitad de hebras, sin halo y a ~30 cuadros por segundo;
//  · se detiene cuando el bloque sale de pantalla o la pestaña queda oculta;
//  · con movimiento reducido se dibuja un solo cuadro quieto.
---

<div class="v2-cintas" aria-hidden="true">
  <canvas id="v2-cintas"></canvas>
</div>

<script>
  const lienzo = document.getElementById('v2-cintas') as HTMLCanvasElement | null;
  const bloque = lienzo?.closest('.v2') as HTMLElement | null;
  const ctx = lienzo?.getContext('2d');

  if (lienzo && bloque && ctx) {
    const movil = matchMedia('(max-width: 767px)').matches;
    const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const CONFIG = {
      hebras: movil ? 44 : 96,
      pasos: movil ? 34 : 56,
      halo: !movil,
      intervalo: movil ? 1000 / 30 : 0,
      // Turquesa de marca, su versión honda y su versión casi blanca: una sola
      // familia de color, para que el acento siga siendo uno.
      colores: [
        [12, 104, 132],
        [32, 194, 188],
        [176, 248, 238],
      ],
    };

    // Cada cinta se define por cuatro puntos de control en dos momentos del
    // scroll (arriba y abajo del bloque), en fracciones del ancho y del alto.
    // Entre medio se interpola. En celular la curva se corre a la derecha y
    // abajo para dejar libre el titular.
    const CINTAS = movil
      ? [
          {
            a: [1.25, 0.02, 0.55, 0.3, 1.2, 0.62, 0.2, 1.08],
            b: [-0.2, 0.1, 0.7, 0.35, 0.1, 0.7, 1.2, 0.95],
            ancho: 0.2, giros: 1.6, fase: 0.4, brillo: 1,
          },
          {
            a: [1.3, 0.55, 0.8, 0.5, 0.75, 0.95, 0.4, 1.2],
            b: [1.2, 0.0, 0.3, 0.4, 0.9, 0.6, -0.2, 1.0],
            ancho: 0.12, giros: 1.1, fase: 2.1, brillo: 0.6,
          },
        ]
      : [
          {
            a: [1.06, -0.1, 0.56, 0.2, 1.02, 0.62, 0.6, 1.14],
            b: [-0.08, 0.2, 0.4, -0.1, 0.55, 1.05, 1.08, 0.72],
            ancho: 0.15, giros: 1.7, fase: 0.4, brillo: 1,
          },
          {
            a: [1.1, 0.42, 0.78, 0.36, 0.86, 0.9, 0.42, 1.12],
            b: [1.08, 0.02, 0.6, 0.5, 0.3, 0.3, -0.08, 0.86],
            ancho: 0.09, giros: 1.2, fase: 2.1, brillo: 0.55,
          },
        ];

    let W = 0;
    let H = 0;
    const medir = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, movil ? 1.5 : 2);
      W = lienzo.clientWidth;
      H = lienzo.clientHeight;
      lienzo.width = Math.round(W * dpr);
      lienzo.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const mezcla = (a: number, b: number, t: number) => a + (b - a) * t;
    const suave = (t: number) => t * t * (3 - 2 * t);

    const color = (u: number, alfa: number) => {
      // u va de -1 a 1 a lo ancho de la cinta.
      const t = (u + 1) / 2;
      const [c0, c1, c2] = CONFIG.colores;
      const de = t < 0.5 ? c0 : c1;
      const a = t < 0.5 ? c1 : c2;
      const k = t < 0.5 ? t * 2 : (t - 0.5) * 2;
      return `rgba(${mezcla(de[0], a[0], k) | 0},${mezcla(de[1], a[1], k) | 0},${mezcla(de[2], a[2], k) | 0},${alfa})`;
    };

    const dibujar = (tiempo: number, avance: number) => {
      ctx.clearRect(0, 0, W, H);
      ctx.globalCompositeOperation = 'lighter';
      const s = suave(avance);

      for (const cinta of CINTAS) {
        // Puntos de control: interpolados por scroll y mecidos apenas por el tiempo.
        const p: number[] = [];
        for (let i = 0; i < 8; i++) {
          const base = mezcla(cinta.a[i], cinta.b[i], s);
          const vaiven = Math.sin(tiempo * 0.17 + i * 1.7 + cinta.fase) * 0.025;
          p.push((base + vaiven) * (i % 2 === 0 ? W : H));
        }
        const anchoMax = cinta.ancho * Math.max(W, H * 0.9);

        for (let h = 0; h < CONFIG.hebras; h++) {
          const u = (h / (CONFIG.hebras - 1)) * 2 - 1;
          // Un valor fijo por hebra, para que unas brillen más que otras.
          const azar = 0.5 + 0.5 * Math.sin(h * 12.9898 + cinta.fase * 7.1);

          ctx.beginPath();
          for (let j = 0; j <= CONFIG.pasos; j++) {
            const t = j / CONFIG.pasos;
            const q = 1 - t;
            // Bézier cúbica y su derivada, para sacar la normal.
            const x = q * q * q * p[0] + 3 * q * q * t * p[2] + 3 * q * t * t * p[4] + t * t * t * p[6];
            const y = q * q * q * p[1] + 3 * q * q * t * p[3] + 3 * q * t * t * p[5] + t * t * t * p[7];
            const dx = 3 * q * q * (p[2] - p[0]) + 6 * q * t * (p[4] - p[2]) + 3 * t * t * (p[6] - p[4]);
            const dy = 3 * q * q * (p[3] - p[1]) + 6 * q * t * (p[5] - p[3]) + 3 * t * t * (p[7] - p[5]);
            const largo = Math.hypot(dx, dy) || 1;

            // La cinta se retuerce: el ancho visible es el coseno del giro, así
            // que hay tramos donde se ve de canto y se afina, como una cinta real.
            const giro = t * Math.PI * cinta.giros + cinta.fase + tiempo * 0.12 + s * 2.2;
            const ancho = anchoMax * (0.18 + 0.82 * Math.sin(Math.PI * t));
            const onda = Math.sin(t * 7 + h * 0.45 + tiempo * 0.5) * 3;
            const lado = u * Math.cos(giro + u * 0.55) * ancho + onda;

            const px = x + (-dy / largo) * lado;
            const py = y + (dx / largo) * lado;
            if (j === 0) ctx.moveTo(px, py);
            else ctx.lineTo(px, py);
          }

          const alfa = (0.06 + 0.2 * azar) * cinta.brillo;
          ctx.strokeStyle = color(u, alfa);
          ctx.lineWidth = 1;
          ctx.stroke();
          if (CONFIG.halo && h % 2 === 0) {
            ctx.strokeStyle = color(u, alfa * 0.16);
            ctx.lineWidth = 11;
            ctx.stroke();
          }
        }
      }
    };

    // Avance del scroll por el bloque negro completo, de 0 a 1.
    const avance = () => {
      const r = bloque.getBoundingClientRect();
      const recorrido = Math.max(1, r.height - window.innerHeight);
      return Math.min(1, Math.max(0, -r.top / recorrido));
    };

    let visible = true;
    let ultimo = 0;
    let cuadro = 0;
    const ciclo = (ahora: number) => {
      cuadro = 0;
      if (!visible || document.hidden) return;
      if (ahora - ultimo >= CONFIG.intervalo) {
        ultimo = ahora;
        dibujar(ahora / 1000, avance());
      }
      cuadro = requestAnimationFrame(ciclo);
    };
    const arrancar = () => {
      if (!cuadro && !quieto) cuadro = requestAnimationFrame(ciclo);
    };

    medir();
    dibujar(0, avance());

    if (quieto) {
      window.addEventListener('scroll', () => dibujar(0, avance()), { passive: true });
    } else {
      new IntersectionObserver(([e]) => {
        visible = e.isIntersecting;
        if (visible) arrancar();
      }).observe(bloque);
      document.addEventListener('visibilitychange', arrancar);
      arrancar();
    }

    // En celular la barra del navegador cambia el alto al hacer scroll y
    // dispara `resize`: solo se vuelve a medir si cambió el ancho.
    let anchoPrevio = window.innerWidth;
    window.addEventListener('resize', () => {
      if (movil && window.innerWidth === anchoPrevio) return;
      anchoPrevio = window.innerWidth;
      medir();
      dibujar(performance.now() / 1000, avance());
    });
  }
</script>
