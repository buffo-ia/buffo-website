---
// La barra de la portada: una pregunta de gerente se escribe sola y aparece la
// respuesta, citando de qué sistema salió cada dato. Es la pieza «viva» que
// muestra el producto sin describirlo (referencia: Qatalog, 12-oct-2026).
//
// ⚠️ PREGUNTAS Y CIFRAS PROVISORIAS E ILUSTRATIVAS. Las confirma Simón. No son
// de ningún cliente, y por eso la pieza lo dice al pie.
//
// Sin librerías: un temporizador escribe letra por letra. Se detiene cuando la
// portada sale de pantalla, y con movimiento reducido muestra la primera
// pregunta ya respondida, quieta. El alto es fijo para que nada salte al
// cambiar de pregunta.
const CASOS = [
  {
    pestana: 'margen',
    pregunta: '¿Por qué cayó el margen en septiembre?',
    lineas: [
      { texto: 'El margen bajó 2,1 puntos frente a agosto.', fuente: 'ERP · ventas' },
      { texto: 'Siete de cada diez pesos de la caída vienen de descuentos a dos clientes.', fuente: 'CRM · condiciones' },
      { texto: 'El costo de importación subió 4% y no se traspasó a precio.', fuente: 'Planilla de costos' },
    ],
    primero: 'Revisar los descuentos de esos dos clientes antes del cierre.',
  },
  {
    pestana: 'ventas',
    pregunta: '¿Llegamos a la meta de ventas del mes?',
    lineas: [
      { texto: 'Octubre va en 82% de la meta con 68% del mes transcurrido.', fuente: 'ERP · ventas' },
      { texto: 'Dos zonas van atrasadas; el resto compensa.', fuente: 'Metas por vendedor' },
      { texto: 'Hay tres pedidos grandes por cerrar esta semana.', fuente: 'CRM · pipeline' },
    ],
    primero: 'Hablar hoy con los vendedores de las dos zonas atrasadas.',
  },
  {
    pestana: 'clientes',
    pregunta: '¿Qué clientes están comprando menos?',
    lineas: [
      { texto: 'Doce clientes bajaron su compra más de 20% en el trimestre.', fuente: 'ERP · ventas' },
      { texto: 'Cuatro de ellos tienen facturas vencidas.', fuente: 'Cobranza' },
      { texto: 'Ninguno recibió visita en los últimos 45 días.', fuente: 'CRM · visitas' },
    ],
    primero: 'Partir por los cuatro con deuda: ahí hay venta y cobranza en juego.',
  },
];
---

<!-- Misma ventana que la terminal de «Cómo trabajamos» (clases v2-term de
     sitio2.css): así el agente se ve igual arriba y abajo. La pestaña activa
     cambia con cada pregunta. -->
<div class="v2-term v2-pregunta v2-sube" style="--i:5" data-v2-pregunta data-casos={JSON.stringify(CASOS)} aria-hidden="true">
  <div class="v2-term__barra">
    <span class="v2-term__botones"><i></i><i></i><i></i></span>
    <span class="v2-term__nombre">buffo-agent</span>
  </div>
  <div class="v2-term__pestanas" data-pestanas>
    {CASOS.map((c, i) => <span class:list={[i === 0 && 'es-activa']}>{c.pestana}</span>)}
    <span class="v2-term__mas">+</span>
  </div>

  <div class="v2-term__cuerpo v2-pregunta__cuerpo">
    <p class="v2-term__pedido"><span data-texto>{CASOS[0].pregunta}</span><i class="v2-pregunta__cursor"></i></p>
    <ul data-lineas>
      {
        CASOS[0].lineas.map((l) => (
          <li class="es-visible">
            <span>{l.texto}</span>
            <b>{l.fuente}</b>
          </li>
        ))
      }
    </ul>
    <p class="v2-pregunta__primero es-visible" data-primero>
      <b>Qué revisar primero</b>
      <span>{CASOS[0].primero}</span>
    </p>
  </div>

  <div class="v2-term__pie">
    <span class="v2-term__entrada"><i style="opacity:1">Pregunte por su negocio…</i></span>
    <span class="v2-term__nota">Ejemplo ilustrativo</span>
  </div>
</div>

<script>
  const caja = document.querySelector<HTMLElement>('[data-v2-pregunta]');
  if (caja && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    type Caso = { pregunta: string; lineas: { texto: string; fuente: string }[]; primero: string };
    const casos: Caso[] = JSON.parse(caja.dataset.casos || '[]');
    const texto = caja.querySelector<HTMLElement>('[data-texto]')!;
    const lista = caja.querySelector<HTMLElement>('[data-lineas]')!;
    const primero = caja.querySelector<HTMLElement>('[data-primero]')!;

    const RITMO = { letra: 38, pensar: 450, linea: 520, leer: 4200, borrar: 14 };
    let visible = true;
    let turno = 0;
    const espera = (ms: number) => new Promise((r) => setTimeout(r, ms));
    // Si la portada salió de pantalla, se queda esperando en vez de seguir.
    const mientrasVisible = async () => {
      while (!visible || document.hidden) await espera(400);
    };

    const mostrar = async (c: Caso) => {
      caja.classList.add('escribiendo');
      lista.querySelectorAll('li').forEach((li) => li.classList.remove('es-visible'));
      primero.classList.remove('es-visible');
      await espera(350);
      lista.innerHTML = c.lineas.map((l) => `<li><span>${l.texto}</span><b>${l.fuente}</b></li>`).join('');
      primero.querySelector('span')!.textContent = c.primero;

      texto.textContent = '';
      for (const letra of c.pregunta) {
        texto.textContent += letra;
        await espera(RITMO.letra + Math.random() * 30);
      }
      caja.classList.remove('escribiendo');
      await espera(RITMO.pensar);
      for (const li of Array.from(lista.children)) {
        li.classList.add('es-visible');
        await espera(RITMO.linea);
      }
      primero.classList.add('es-visible');
    };

    const ciclo = async () => {
      // La primera pregunta ya viene escrita en el HTML: se deja leer y recién
      // después empieza a rotar.
      await espera(RITMO.leer + 1500);
      for (;;) {
        await mientrasVisible();
        for (let n = texto.textContent!.length; n > 0; n -= 2) {
          texto.textContent = texto.textContent!.slice(0, Math.max(0, n - 2));
          await espera(RITMO.borrar);
        }
        turno = (turno + 1) % casos.length;
        caja.querySelectorAll('[data-pestanas] span:not(.v2-term__mas)').forEach((t, i) => t.classList.toggle('es-activa', i === turno));
        await mostrar(casos[turno]);
        await espera(RITMO.leer);
      }
    };

    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(caja);
    if (casos.length > 1) ciclo();
  }
</script>
