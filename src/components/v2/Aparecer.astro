---
// Motor de las entradas atadas al scroll del sitio 2.0.
//
// Cualquier elemento con `data-v2-entra` recibe una variable --e que va de 0
// (recién asoma por abajo) a 1 (ya entró). El CSS decide qué hacer con ella:
// subir desde el desenfoque, enderezar una maqueta, encender palabras.
// El valor del atributo es qué fracción de la pantalla dura la entrada
// (por defecto 0.45; más alto = entrada más larga).
//
// --e vale 1 por defecto en el CSS: sin JavaScript, o con movimiento reducido,
// todo está a la vista y nada depende de que este script corra.
---

<script>
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const todos = Array.from(document.querySelectorAll<HTMLElement>('[data-v2-entra]'));
    const activos = new Set<HTMLElement>();
    let pendiente = false;

    const pintar = () => {
      pendiente = false;
      const vh = window.innerHeight;
      activos.forEach((el) => {
        const tramo = vh * (parseFloat(el.dataset.v2Entra || '') || 0.45);
        const e = Math.min(1, Math.max(0, (vh - el.getBoundingClientRect().top) / tramo));
        el.style.setProperty('--e', e.toFixed(3));
      });
    };
    const alScroll = () => {
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(pintar);
    };

    // Solo se calculan los que están cerca de la pantalla. Los que ya pasaron
    // quedan en 1 y los que no han llegado, en 0.
    const vigia = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((x) => {
          const el = x.target as HTMLElement;
          if (x.isIntersecting) activos.add(el);
          else {
            activos.delete(el);
            el.style.setProperty('--e', x.boundingClientRect.top < 0 ? '1' : '0');
          }
        });
        pintar();
      },
      { rootMargin: '15% 0px' }
    );
    todos.forEach((el) => vigia.observe(el));
    window.addEventListener('scroll', alScroll, { passive: true });
    window.addEventListener('resize', alScroll);

    // Los gráficos de las maquetas (líneas que se dibujan, barras que crecen,
    // la dona) ya traían su animación, pero corría al cargar la página: cuando
    // el visitante llegaba, ya había terminado. Ahora quedan en pausa hasta que
    // la pantalla entra (el CSS las suelta con .es-visto). La clase en <html>
    // es la que activa la pausa: sin este script, todo se ve terminado.
    document.documentElement.classList.add('v2-anima');
    const vistos = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((x) => {
          if (!x.isIntersecting) return;
          x.target.classList.add('es-visto');
          vistos.unobserve(x.target);
        });
      },
      { threshold: 0.3 }
    );
    document.querySelectorAll('.v2-e-panel, [data-v2-visto]').forEach((el) => vistos.observe(el));

    // Cifras que cuentan hasta su valor al entrar en pantalla (data-v2-cuenta
    // = valor final, data-desde = de dónde parte; por defecto 0).
    const contar = (el: HTMLElement) => {
      const hasta = Number(el.dataset.v2Cuenta);
      const desde = Number(el.dataset.desde || 0);
      const dura = 1100;
      let t0 = 0;
      const paso = (t: number) => {
        t0 ||= t;
        const k = Math.min(1, (t - t0) / dura);
        const suave = 1 - Math.pow(1 - k, 3);
        el.textContent = Math.round(desde + (hasta - desde) * suave).toLocaleString('es-CL');
        if (k < 1) requestAnimationFrame(paso);
      };
      requestAnimationFrame(paso);
    };
    const cuentas = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((x) => {
          if (!x.isIntersecting) return;
          contar(x.target as HTMLElement);
          cuentas.unobserve(x.target);
        });
      },
      { threshold: 0.9 }
    );
    document.querySelectorAll<HTMLElement>('[data-v2-cuenta]').forEach((el) => {
      // Solo las que todavía no se ven parten desde su valor inicial.
      if (el.getBoundingClientRect().top > window.innerHeight) el.textContent = el.dataset.desde || '0';
      cuentas.observe(el);
    });
  }
</script>
