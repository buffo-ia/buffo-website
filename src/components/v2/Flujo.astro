---
// Cómo trabajamos: datos de la empresa → agentes de IA → la persona que decide.
//
// Formato del 12-oct-2026 (referencia: Framer): los pasos van a la izquierda y
// a la derecha queda FIJO un panel del agente que cambia con cada paso. El
// paso inactivo queda apagado y se enciende al entrar. La escena está pegada a
// la pantalla y el scroll decide en qué paso va.
//
// El panel cuenta la misma historia que la barra de la portada (la caída del
// margen): leer los sistemas, preparar la propuesta, y una persona que aprueba.
//
// ⚠️ TEXTO Y CIFRAS PROVISORIOS E ILUSTRATIVOS. Dos cuidados que no son de estilo:
//  · los agentes «vigilan, preparan y proponen»: el sitio no afirma más
//    autonomía que la que hoy corre en producción;
//  · quien decide es siempre una persona del equipo del cliente.
const PASOS = [
  { paso: '01', titulo: 'Los datos de su empresa', texto: 'Conectados donde ya están, con una sola definición de cada número.' },
  { paso: '02', titulo: 'Agentes que hacen el trabajo', texto: 'Vigilan, preparan y proponen dentro de sus procesos, todos los días.' },
  { paso: '03', titulo: 'Una persona que decide', texto: 'Cada flujo tiene a alguien de su equipo a cargo. La decisión sigue siendo suya.' },
];
// La conversación de la terminal. `paso` dice con qué paso aparece cada bloque
// (0 datos, 1 agentes, 2 persona) y `orden` su turno dentro de ese paso.
const TERMINAL = {
  contexto: 'ERP · CRM · planilla de costos',
  pedido: '¿Por qué cayó el margen en septiembre?',
  bloques: [
    { paso: 0, orden: 0, accion: 'Conectando las fuentes…', detalle: '', lineas: ['ERP · ventas: 48.210 líneas leídas.', 'CRM · condiciones: 94 clientes.'] },
    { paso: 0, orden: 1, accion: 'Leer', detalle: '(planilla de costos)', lineas: ['312 productos, una sola definición de margen.'] },
    { paso: 1, orden: 0, accion: 'Vigila', detalle: '(margen mensual)', lineas: ['Septiembre salió del rango esperado: −2,1 puntos.'] },
    { paso: 1, orden: 1, accion: 'Prepara', detalle: '(desglose de la caída)', lineas: ['70% descuentos a dos clientes · 30% costo de importación.'] },
    { paso: 1, orden: 2, accion: 'Propone', detalle: '', lineas: ['Revisar los descuentos de esos dos clientes antes del cierre.'] },
    { paso: 2, orden: 0, accion: 'Propuesta enviada al gerente comercial.', detalle: '', lineas: ['La decisión es de una persona de su equipo.'] },
  ],
};
---

<section class="v2-flujo" data-v2-flujo data-paso="0">
  <div class="v2-flujo__escena">
    <div class="v2-marco v2-flujo__grilla">
      <div class="v2-flujo__izq">
        <p class="v2-indice">Cómo trabajamos</p>
        <h2 class="v2-titulo v2-flujo__titulo">Los agentes hacen el trabajo. <em>Las personas deciden.</em></h2>
        <ol class="v2-pasos">
          <li class="v2-pasos__riel" aria-hidden="true"></li>
          {
            PASOS.map((p, i) => (
              <li class="v2-paso" data-n={i}>
                <b>{p.paso}</b>
                <div>
                  <h3>{p.titulo}</h3>
                  <p>{p.texto}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <!-- El panel fijo: una terminal de agente con la conversación en vivo
           (Simón, 12-oct-2026, sobre el panel «framer-agent» de framer.com:
           «los botones, la terminal tipo agente, una conversación en vivo…
           deberíamos hacer esto»). Las líneas se van sumando con cada paso y
           las de pasos anteriores quedan atenuadas, como un registro.
           Es decorativo para un lector de pantalla, que ya tiene los tres
           pasos escritos al lado. -->
      <div class="v2-term" aria-hidden="true">
        <div class="v2-term__barra">
          <span class="v2-term__botones"><i></i><i></i><i></i></span>
          <span class="v2-term__nombre">buffo-agent</span>
        </div>
        <div class="v2-term__pestanas">
          <span class="es-activa">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6L5.6 18.4" /></svg>
            margen
          </span>
          <span>cobranza</span>
          <span>stock</span>
          <span class="v2-term__mas">+</span>
        </div>

        <div class="v2-term__cuerpo">
          <p class="v2-term__marco"><b>Agente de margen</b> · {TERMINAL.contexto}</p>
          <p class="v2-term__pedido">{TERMINAL.pedido}</p>
          {
            TERMINAL.bloques.map((b, k) => (
              <div class="v2-term__bloque" data-n={b.paso} style={`--k:${b.orden}`}>
                <p><i class="v2-term__punto"></i><b>{b.accion}</b>{b.detalle && <span>{b.detalle}</span>}</p>
                {b.lineas.map((l) => <p class="v2-term__sub">{l}</p>)}
              </div>
            ))
          }
          <div class="v2-term__bloque v2-term__decision" data-n="2" style="--k:1">
            <span class="v2-term__ok">Aprobar</span>
            <span>Ajustar</span>
            <span>Descartar</span>
          </div>
        </div>

        <div class="v2-term__pie">
          <span class="v2-term__entrada">
            <i data-n="0">Leyendo los sistemas…</i>
            <i data-n="1">Preparando la propuesta…</i>
            <i data-n="2">Esperando la decisión del gerente comercial</i>
          </span>
          <span class="v2-term__nota">Ejemplo ilustrativo</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Avance del scroll por la sección (0 a 1) → --p (el riel) y data-paso (qué
  // paso y qué vista del panel están encendidos).
  const seccion = document.querySelector<HTMLElement>('[data-v2-flujo]');
  const CORTES = [0.34, 0.67];

  if (seccion && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let pendiente = false;
    const pintar = () => {
      pendiente = false;
      const r = seccion.getBoundingClientRect();
      const recorrido = Math.max(1, r.height - window.innerHeight);
      const p = Math.min(1, Math.max(0, -r.top / recorrido));
      seccion.style.setProperty('--p', p.toFixed(3));
      const paso = p < CORTES[0] ? 0 : p < CORTES[1] ? 1 : 2;
      if (seccion.dataset.paso !== String(paso)) seccion.dataset.paso = String(paso);
    };
    const alScroll = () => {
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(pintar);
    };
    // Solo se escucha el scroll mientras la sección está cerca de la pantalla.
    new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) window.addEventListener('scroll', alScroll, { passive: true });
        else window.removeEventListener('scroll', alScroll);
        pintar();
      },
      { rootMargin: '20% 0px' }
    ).observe(seccion);
    pintar();
  }
</script>
