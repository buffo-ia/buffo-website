---
// «Nos conectamos a todo lo que ya usa»: el mapa del colibrí con los sistemas
// alrededor, que a Simón le encanta, en el formato nuevo. El mapa se arma con
// el scroll: primero el centro, después los cables y los sistemas de a uno.
//
// ⛔ LAS CIFRAS SALEN DE COSAS QUE EL SITIO YA AFIRMA; ninguna se inventó.
//   · «0 sistemas que cambiar» → respuesta publicada en las preguntas frecuentes.
//   · «0 líneas de código de su lado» → es el modelo de trabajo.
//   · «3 minutos» → el diagnóstico.
// Las que más venderían (cuántas integraciones, días al primer resultado) solo
// las tiene Simón: cuando las dé, van acá.
import MapaIntegraciones from '../MapaIntegraciones.astro';

const PUNTOS = [
  'Su ERP, sus planillas y su base de datos',
  'Nadie exporta ni pega nada a mano',
  'Sin migrar a un sistema nuevo',
  'Si no hay API, lo leemos igual',
];
---

<section class="v2-seccion v2-conexion">
  <div class="v2-marco v2-conexion__grilla">
    <div class="v2-e-sube" data-v2-entra>
      <p class="v2-indice">Cómo nos conectamos</p>
      <h2 class="v2-titulo">Nos conectamos a todo <em>lo que ya usa.</em></h2>
      <p class="v2-parrafo">
        Su ERP, sus planillas, la base de datos y las campañas hablan idiomas distintos.
        Los leemos donde están y como están, y encima ponemos la lectura.
      </p>
      {/* Las cifras «0 / 0 / 3 min» que iban acá pasaron a la sección
          «Lo que cambia, en números» (Prueba.astro), el 12-oct-2026. */}
      <ul class="v2-puntos">
        {PUNTOS.map((t) => <li>{t}</li>)}
      </ul>
    </div>
    <div class="v2-conexion__mapa" data-v2-entra="0.8">
      <MapaIntegraciones />
    </div>
  </div>
</section>
