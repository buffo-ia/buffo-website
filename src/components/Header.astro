---
import Logotipo from './Logotipo.astro';
import { NAV } from '../config/site';

const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---

<!-- Al tope el header no tiene fondo: el logo queda apoyado directamente sobre
     el hero. El único elemento con cuerpo es la píldora del menú, que trae su
     propio vidrio. Al bajar aparece el vidrio del header completo (.is-scrolled)
     — sin él, el contenido pasaría por debajo y el menú se volvería ilegible. -->
<header id="site-header" class="site-header sticky top-0 z-50">
  <nav class="relative flex justify-between items-center px-8 md:px-12 py-5 max-w-screen-2xl mx-auto">
    <a
      href="/"
      class="flex items-center opacity-100 hover:opacity-70 transition-opacity duration-200"
      aria-label="Inicio — Buffo IA Consulting"
    >
      <Logotipo />
    </a>

    <!-- Centrada respecto de la página, no del espacio que sobra: si se dejara
         en el flujo, el ancho del logo y el del botón la correrían de a poco. -->
    <div
      class="nav-pill hidden md:flex items-center gap-8 absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2"
    >
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class:list={[
              'nav-link text-sm font-semibold transition-colors tracking-wide',
              isActive(item.href) ? 'text-primary' : 'text-on-surface/60 hover:text-on-surface',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-3">
      <button
        id="theme-toggle"
        type="button"
        class="p-2 text-on-surface/60 hover:text-on-surface transition-colors"
        aria-label="Cambiar entre tema claro y oscuro"
        title="Cambiar tema"
      >
        <span class="material-symbols-outlined text-xl align-middle theme-icon-dark">light_mode</span>
        <span class="material-symbols-outlined text-xl align-middle theme-icon-light">dark_mode</span>
      </button>
      <!-- El header es fijo, así que este botón acompaña todo el scroll: es el
           CTA persistente del sitio. Va el diagnóstico, no "conversación" —
           a un visitante frío se le pide lo barato, no una reunión. -->
      <a
        href="/diagnostico"
        class="btn-glow bg-primary text-on-primary px-7 py-3 text-sm font-semibold tracking-tight hidden sm:inline-block"
      >
        Diagnóstico · 3 min
      </a>
    </div>

    <!-- Botón menú móvil -->
    <button
      id="menu-toggle"
      class="md:hidden text-on-surface"
      aria-label="Abrir menú"
      aria-expanded="false"
    >
      <span class="material-symbols-outlined text-3xl">menu</span>
    </button>
  </nav>

  <!-- Menú móvil desplegable -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-on-surface/5 bg-background px-8 py-6 space-y-4">
    {
      NAV.map((item) => (
        <a
          href={item.href}
          class="block text-base font-semibold text-on-surface/70 hover:text-primary transition-colors"
        >
          {item.label}
        </a>
      ))
    }
    <a
      href="/diagnostico"
      class="block btn-glow bg-primary text-on-primary px-6 py-3 text-sm font-semibold text-center mt-4"
    >
      Diagnóstico gratis · 3 min
    </a>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const header = document.getElementById('site-header');

  // El vidrio del header solo existe cuando hay algo debajo que tapar, o cuando
  // el menú móvil está abierto (si no, la fila de arriba queda flotando suelta).
  const syncHeader = () => {
    const menuAbierto = menu ? !menu.classList.contains('hidden') : false;
    header?.classList.toggle('is-scrolled', window.scrollY > 8 || menuAbierto);
  };
  syncHeader();
  window.addEventListener('scroll', syncHeader, { passive: true });

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
    toggle.querySelector('.material-symbols-outlined')!.textContent = isOpen ? 'menu' : 'close';
    syncHeader();
  });

  // Cambio de tema. La preferencia se recuerda; si nunca se eligió, manda el
  // sistema operativo (lo resuelve el script inline del <head>).
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    root.classList.toggle('dark', next === 'dark');
    root.style.colorScheme = next;
    try {
      localStorage.setItem('buffo-theme', next);
    } catch (e) {}
  });
</script>
