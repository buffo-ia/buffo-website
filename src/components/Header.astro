---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import logoLight from '../assets/logo_light.png';
import { NAV } from '../config/site';

const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---

<header
  class="bg-background/90 backdrop-blur-xl sticky top-0 z-50 border-b border-on-surface/5 section-glow"
>
  <nav class="flex justify-between items-center px-8 md:px-12 py-5 max-w-screen-2xl mx-auto">
    <a
      href="/"
      class="flex items-center opacity-100 hover:opacity-70 transition-opacity duration-200"
      aria-label="Inicio — Buffo IA Consulting"
    >
      <Image src={logo} alt="Buffo IA Consulting" class="logo-dark h-9 w-auto object-contain" loading="eager" />
      <Image src={logoLight} alt="Buffo IA Consulting" class="logo-light h-9 w-auto object-contain" loading="eager" />
    </a>

    <div class="hidden md:flex items-center gap-10">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class:list={[
              'nav-link text-sm font-semibold transition-colors tracking-wide',
              isActive(item.href) ? 'text-primary' : 'text-on-surface/60 hover:text-on-surface',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-3">
      <button
        id="theme-toggle"
        type="button"
        class="p-2 text-on-surface/60 hover:text-on-surface transition-colors"
        aria-label="Cambiar entre tema claro y oscuro"
        title="Cambiar tema"
      >
        <span class="material-symbols-outlined text-xl align-middle theme-icon-dark">light_mode</span>
        <span class="material-symbols-outlined text-xl align-middle theme-icon-light">dark_mode</span>
      </button>
      <!-- El header es fijo, así que este botón acompaña todo el scroll: es el
           CTA persistente del sitio. Va el diagnóstico, no "conversación" —
           a un visitante frío se le pide lo barato, no una reunión. -->
      <a
        href="/diagnostico"
        class="btn-glow bg-primary text-on-primary px-7 py-3 text-sm font-semibold tracking-tight hidden sm:inline-block"
      >
        Diagnóstico · 3 min
      </a>
    </div>

    <!-- Botón menú móvil -->
    <button
      id="menu-toggle"
      class="md:hidden text-on-surface"
      aria-label="Abrir menú"
      aria-expanded="false"
    >
      <span class="material-symbols-outlined text-3xl">menu</span>
    </button>
  </nav>

  <!-- Menú móvil desplegable -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-on-surface/5 bg-background px-8 py-6 space-y-4">
    {
      NAV.map((item) => (
        <a
          href={item.href}
          class="block text-base font-semibold text-on-surface/70 hover:text-primary transition-colors"
        >
          {item.label}
        </a>
      ))
    }
    <a
      href="/diagnostico"
      class="block btn-glow bg-primary text-on-primary px-6 py-3 text-sm font-semibold text-center mt-4"
    >
      Diagnóstico gratis · 3 min
    </a>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
    toggle.querySelector('.material-symbols-outlined')!.textContent = isOpen ? 'menu' : 'close';
  });

  // Cambio de tema. La preferencia se recuerda; si nunca se eligió, manda el
  // sistema operativo (lo resuelve el script inline del <head>).
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    root.classList.toggle('dark', next === 'dark');
    root.style.colorScheme = next;
    try {
      localStorage.setItem('buffo-theme', next);
    } catch (e) {}
  });
</script>
